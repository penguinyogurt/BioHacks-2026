# Copy to agent/.env (gitignored) and fill in.

# Claude: https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
CLAUDE_ORCHESTRATOR_MODEL=claude-opus-5-5
CLAUDE_SUBAGENT_MODEL=claude-sonnet-5-5
# CLAUDE_INGEST_MODEL=claude-opus-5-5     # chart PDF parsing; defaults to the orchestrator model
# AGENT_EFFORT=medium                      # low | medium | high | xhigh | max

# LangSmith tracing: https://smith.langchain.com → Settings → API Keys
# With these set, every LLM call, tool call and sub-agent is traced; no code changes.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=biohacks-als-research
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for an EU-region account
# LANGSMITH_HIDE_INPUTS=true   # hide prompts (incl. the patient record) from traces

# Optional: raises the PubMed rate limit from 3 to 10 req/s
NCBI_API_KEY=

# Budgets (defaults shown)
# AGENT_MAX_SUBAGENTS=8
# AGENT_MAX_CONCURRENCY=8
# AGENT_MAX_TOOL_CALLS=8
# AGENT_SUBAGENT_TIMEOUT_S=240
# AGENT_RUN_TIMEOUT_S=480
# AGENT_LLM_RPM=claude-sonnet-5-5:50   # only if your Anthropic tier hits 429s
# AGENT_PORT=8001
