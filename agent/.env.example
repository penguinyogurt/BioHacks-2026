# Copy to agent/.env (gitignored) and fill in.

# Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Check current ids at https://ai.google.dev/gemini-api/docs/models (preview ids get retired)
GEMINI_ORCHESTRATOR_MODEL=gemini-3.1-pro-preview
GEMINI_SUBAGENT_MODEL=gemini-3-flash-preview

# LangSmith tracing — https://smith.langchain.com → Settings → API Keys
# With these set, every LLM call, tool call and sub-agent is traced; no code changes.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=biohacks-als-research
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for an EU-region account
# LANGSMITH_HIDE_INPUTS=true   # hide prompts (incl. the patient record) from traces

# Optional: raises the PubMed rate limit from 3 to 10 req/s
NCBI_API_KEY=

# Requests/min cap per model, shared across all agents. Free tier is ~5 RPM per
# model; leave unset on a paid tier. Free-tier settings that work:
#   GEMINI_ORCHESTRATOR_MODEL=gemini-3-flash-preview
#   GEMINI_SUBAGENT_MODEL=gemini-3.1-flash-lite
#   AGENT_GEMINI_RPM=gemini-3-flash-preview:5,gemini-3.1-flash-lite:10,*:5
#   AGENT_SUBAGENT_TIMEOUT_S=600  AGENT_RUN_TIMEOUT_S=1200  AGENT_MAX_SUBAGENTS=4
# AGENT_GEMINI_RPM=

# Budgets (defaults shown)
# AGENT_MAX_SUBAGENTS=6
# AGENT_MAX_CONCURRENCY=4
# AGENT_MAX_TOOL_CALLS=8
# AGENT_SUBAGENT_TIMEOUT_S=120
# AGENT_RUN_TIMEOUT_S=300
# AGENT_PORT=8001
