ANTHROPIC_API_KEY=
CLAUDE_ORCHESTRATOR_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium
AGENT_LLM_RPM=
CLAUDE_SUBAGENT_MODEL=claude-haiku-5-5
AGENT_MAX_TOOL_CALLS=8
AGENT_SUBAGENT_TIMEOUT_S=220
# BH_AGENT_ENV_FILE can point to an existing agent/.env on another checkout.
# CLAUDE_API_KEY= works in place of ANTHROPIC_API_KEY.

# Heads-up: AGENT_EFFORT and AGENT_LLM_RPM above, and NCBI_API_KEY below, are
# only read from the shell environment. A value in this file is ignored:
# config.py reads it with dotenv_values, which never sets os.environ, and
# llm.py / mcp_server.py read these three with os.getenv. Export them instead.
# NCBI_API_KEY=                 # optional: PubMed rate limit 3 -> 10 req/s
