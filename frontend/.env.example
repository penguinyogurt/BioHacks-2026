# Copy to .env for local dev. `.env` is gitignored — never commit real keys.
#
# The app runs without any of this: the dashboard renders against sample data
# and shows a "Sample data" badge. These are only needed for Google sign-in.
#
# Supabase setup: enable the Google provider, and add http://localhost:5173
# (plus your prod URL) to Redirect URLs.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# The publishable "anon" key — safe in a browser bundle. NOT the service_role
# key, which must never reach the frontend.
VITE_SUPABASE_ANON_KEY=

# --- Research agent (backend/agent, `python -m agent.api` from backend/) ---
# All optional. If the agent API isn't reachable when you start a run, the
# pipeline falls back to the scripted "Simulated" run, so the app always renders.

# Where the agent API listens. Default: http://127.0.0.1:8001
# In production (Vercel) set this to the backend's HTTPS origin, e.g. https://api.your-domain.com.
# It must be HTTPS (browsers block an https page calling http), and the backend must list this
# site in AGENT_CORS_ORIGINS. It also scores the take-home test's facial and speech tasks.
VITE_AGENT_URL=
# Which record in backend/data/patient/ the agent reads. Default: alex.
# (The case PDF you upload is only parsed in the browser; it isn't sent.)
VITE_AGENT_PATIENT=
# Replay recorded runs (backend/agent/runs/<id>.jsonl) at original speed instead
# of paying for new ones. Use this for rehearsals and the expo. Comma-separated:
#   <research r…>[,<drkg d…>[,<assess a…>]]
# A missing DRKG id is recomputed live (free, ~2 s); a missing assessment id
# stops the replay after stage 3 rather than start a paid run. The backend
# must still be running; replays make no LLM calls.
VITE_AGENT_REPLAY_RUN=

# --- Take-home test (backend/diagnostics/master-app) ---
# Where the take-home test runs. Optional: by default it's this app's own child route,
# /take-home/ (public/take-home/, synced from backend/diagnostics by npm run sync:take-home),
# so it deploys with the frontend. Set http://127.0.0.1:8772/ to use the local launcher instead.
VITE_TAKE_HOME_URL=
