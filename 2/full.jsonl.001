{"type":"api-request","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","id":"c5cc5bed-2b56-440c-a474-cb7c686b107a","timestamp":"2026-11-08T03:26:53.880Z","version":"2.1.319","querySource":"repl_main_thread","shapeHash":"5685418bd6f66308fa90ee5dade4a2397602d74a9bb9e15af07b03e1cb0aac0d","params":{"model":"claude-opus-5-5","betas":["claude-code-20250219","oauth-2025-04-20","interleaved-thinking-2025-05-14","context-management-2025-06-27","prompt-caching-scope-2026-01-05","per-turn-control-2026-07-01","mid-conversation-tool-changes-2026-07-01","inline-tools-2026-09-15","advisor-tool-2026-03-01","thinking-token-count-2026-05-13","advanced-tool-use-2025-11-20","mid-conversation-system-clear-at-2026-08-21","effort-2025-11-24","dangerous-tool-use-2026-09-03","thinking-binding-controls-2026-08-01","thinking-display-updates-2026-08-18","afk-mode-2026-01-31","extended-cache-ttl-2025-04-11","cache-diagnosis-2026-04-07","message-threads-2026-08-12"],"max_tokens":128000,"thinking":{"type":"adaptive","display":"updates"},"context_management":{"edits":[{"type":"clear_thinking_20251015","keep":"all"}]},"output_config":{"effort":"high"}},"base":"037014e2-8082-4d6b-854b-e8b9ba012848","keep":558,"tail":["adaa155b47e25314a4a470062546e71cec085794044040cf7c3b3cdb981e0cb0","23c795db4b8d369edc7898ac33aeeacb24adc65227c3f135f4ea21e699a0b7ee"],"cacheControl":[{"path":["system",1],"value":{"type":"ephemeral","ttl":"1h","scope":"global"}},{"path":["system",2],"value":{"type":"ephemeral","ttl":"1h"}},{"path":["messages",559,"content",1],"value":{"type":"ephemeral","ttl":"1h"}}],"requestDigest":"e317efbaad4f22cada3dddc921b1a4b7494d84cd5a2d59b11dacbd0f0bc4f917"}
