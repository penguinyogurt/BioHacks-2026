{"parentUuid":"94008e69-3bc8-4d41-85ff-f664d36b020e","isSidechain":false,"promptId":"a90a5ff0-ce8d-45a3-aa5c-46728e5306fb","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011R8JFuBcnUDhsroH9FPZHa","type":"tool_result","content":"60\t  }\n61\t}\n62\t\n63\texport const DEFAULT_GOAL = 'Drugs that could slow progression or ease bulbar symptoms, given MRgFUS can open the blood–brain barrier.'\n64\t\n65\ttype Store = {\n66\t  state: RunState\n67\t  caseFile: CaseFile | null\n68\t  setCaseFile: (f: CaseFile | null) => void\n69\t  goal: string\n70\t  setGoal: (g: string) => void\n71\t  weights: Weights\n72\t  setWeights: (w: Weights) => void\n73\t  date: string\n74\t  runs: CompletedRun[]\n75\t  start: () => void\n76\t  skip: () => void\n77\t  reset: () => void\n78\t}\n79\t\n80\tconst Ctx = createContext<Store | null>(null)\n81\t\n82\texport function RunProvider({ children, onStage }: { children: ReactNode; onStage?: (stage: StageId) => void }) {\n83\t  const [state, dispatch] = useReducer(reducer, initial)\n84\t  const [caseFile, setCaseFile] = useState<CaseFile | null>(null)\n85\t  const [goal, setGoal] = useState(DEFAULT_GOAL)\n86\t  const [weights, setWeights] = useState<Weights>({ fit: true, safety: true, cost: true, availability: true, acceptance: true })\n87\t  const [date, setDate] = useState('')\n88\t  const [runs, setRuns] = useState<CompletedRun[]>([])\n89\t  const runner = useRef<{ cancel: () => void; skip: () => void } | null>(null)\n90\t  const onStageRef = useRef(onStage)\n91\t  onStageRef.current = onStage\n92\t\n93\t  useEffect(() => () => runner.current?.cancel(), [])\n94\t\n95\t  const start = useCallback(() => {\n96\t    runner.current?.cancel()\n97\t    dispatch({ type: 'start' })\n98\t    const when = new Intl.DateTimeFormat('en-CA', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date())\n99\t    setDate(when)\n100\t    const caseInput = caseFile\n101\t      ? { name: caseFile.name, pages: caseFile.pages, words: caseFile.words, excerpt: caseFile.text.join(' ').slice(0, 220).trim() }\n102\t      : null\n103\t    runner.current = runDemoPipeline(\n104\t      SAMPLE_PATIENT,\n105\t      caseInput,\n106\t      (e) => {\n107\t        dispatch(e)\n108\t        if (e.type === 'stage' && e.status === 'running') onStageRef.current?.(e.stage)\n109\t      },\n110\t      () => {\n111\t        dispatch({ type: 'finish' })\n112\t        setRuns((r) => [{ id: crypto.randomUUID(), date: when, weights, goal, caseName: caseFile?.name ?? null }, ...r])\n113\t      },\n114\t    )\n115\t  }, [caseFile, goal, weights])\n116\t\n117\t  const skip = useCallback(() => runner.current?.skip(), [])\n118\t  const reset = useCallback(() => {\n119\t    runner.current?.cancel()\n120\t    dispatch({ type: 'reset' })\n121\t  }, [])\n122\t\n123\t  return (\n124\t    <Ctx.Provider value={{ state, caseFile, setCaseFile, goal, setGoal, weights, setWeights, date, runs, start, skip, reset }}>\n125\t      {children}\n126\t    </Ctx.Provider>\n127\t  )\n128\t}\n129\t\n130\texport function useRun() {\n131\t  const ctx = useContext(Ctx)\n132\t  if (!ctx) throw new Error('useRun must be used inside <RunProvider>')\n133\t  return ctx\n134\t}"}]},"uuid":"85f0c5df-d086-4bb1-9501-a7ea0d98e0e5","timestamp":"2026-11-08T04:02:50.056Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\lib\\run-store.tsx","content":"  }\n}\n\nexport const DEFAULT_GOAL = 'Drugs that could slow progression or ease bulbar symptoms, given MRgFUS can open the blood–brain barrier.'\n\ntype Store = {\n  state: RunState\n  caseFile: CaseFile | null\n  setCaseFile: (f: CaseFile | null) => void\n  goal: string\n  setGoal: (g: string) => void\n  weights: Weights\n  setWeights: (w: Weights) => void\n  date: string\n  runs: CompletedRun[]\n  start: () => void\n  skip: () => void\n  reset: () => void\n}\n\nconst Ctx = createContext<Store | null>(null)\n\nexport function RunProvider({ children, onStage }: { children: ReactNode; onStage?: (stage: StageId) => void }) {\n  const [state, dispatch] = useReducer(reducer, initial)\n  const [caseFile, setCaseFile] = useState<CaseFile | null>(null)\n  const [goal, setGoal] = useState(DEFAULT_GOAL)\n  const [weights, setWeights] = useState<Weights>({ fit: true, safety: true, cost: true, availability: true, acceptance: true })\n  const [date, setDate] = useState('')\n  const [runs, setRuns] = useState<CompletedRun[]>([])\n  const runner = useRef<{ cancel: () => void; skip: () => void } | null>(null)\n  const onStageRef = useRef(onStage)\n  onStageRef.current = onStage\n\n  useEffect(() => () => runner.current?.cancel(), [])\n\n  const start = useCallback(() => {\n    runner.current?.cancel()\n    dispatch({ type: 'start' })\n    const when = new Intl.DateTimeFormat('en-CA', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date())\n    setDate(when)\n    const caseInput = caseFile\n      ? { name: caseFile.name, pages: caseFile.pages, words: caseFile.words, excerpt: caseFile.text.join(' ').slice(0, 220).trim() }\n      : null\n    runner.current = runDemoPipeline(\n      SAMPLE_PATIENT,\n      caseInput,\n      (e) => {\n        dispatch(e)\n        if (e.type === 'stage' && e.status === 'running') onStageRef.current?.(e.stage)\n      },\n      () => {\n        dispatch({ type: 'finish' })\n        setRuns((r) => [{ id: crypto.randomUUID(), date: when, weights, goal, caseName: caseFile?.name ?? null }, ...r])\n      },\n    )\n  }, [caseFile, goal, weights])\n\n  const skip = useCallback(() => runner.current?.skip(), [])\n  const reset = useCallback(() => {\n    runner.current?.cancel()\n    dispatch({ type: 'reset' })\n  }, [])\n\n  return (\n    <Ctx.Provider value={{ state, caseFile, setCaseFile, goal, setGoal, weights, setWeights, date, runs, start, skip, reset }}>\n      {children}\n    </Ctx.Provider>\n  )\n}\n\nexport function useRun() {\n  const ctx = useContext(Ctx)\n  if (!ctx) throw new Error('useRun must be used inside <RunProvider>')\n  return ctx\n}","numLines":75,"startLine":60,"totalLines":135}},"sourceToolAssistantUUID":"94008e69-3bc8-4d41-85ff-f664d36b020e","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"28437234-f1be-440d-9452-c51de1bd38ab","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\jerem\\BioHacks-2026\\frontend","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","version":"2.1.319","gitBranch":"frontend/diagnosis"}
