flex flex-wrap items-end justify-between gap-4\">\r","+          <div>\r","+            <p className=\"eyebrow\">Pipeline / {step}</p>\r","+            <h2 className=\"font-brand mt-3 text-[clamp(2rem,3.2vw,3rem)] leading-none\">{title}</h2>\r","+            {description ? <p className=\"mt-3 max-w-2xl text-muted-foreground\">{description}</p> : null}\r","+          </div>\r","+          <div className=\"flex items-center gap-2\">\r","+            <Badge variant=\"outline\" className=\"border-watch/40 bg-watch/10 font-normal text-watch\">Simulated run</Badge>\r","+            {state.phase === 'running' ? (\r","+              <Button size=\"sm\" variant=\"outline\" onClick={skip}>\r","+                <FastForward aria-hidden /> Skip to results\r","+              </Button>\r","+            ) : state.phase === 'done' ? (\r","+              <Button size=\"sm\" variant=\"outline\" onClick={reset}>\r","+                <RotateCcw aria-hidden /> Clear run\r","+              </Button>\r","+            ) : null}\r","+          </div>\r","+        </div>\r","+      </div>\r","+      {rail ? <PipelineRail /> : null}\r","+    </div>\r","+  )\r","+}\r","+\r","+export function PipelineRail() {\r","+  const { state } = useRun()\r","+  return (\r","+    <ol className=\"grid grid-cols-5 gap-2\" aria-label=\"Pipeline progress\">\r","+      {STAGES.map((s, i) => {\r","+        const st = state.stages[s.id]\r","+        return (\r","+          <li\r","+            key={s.id}\r","+            className={cn(\r","+              'rounded-lg border bg-card px-3 py-2 backdrop-blur-md transition-colors',\r","+              st === 'running' && 'border-[#c9732a]/60',\r","+              st === 'done' && 'border-foreground/25',\r","+            )}\r","+          >\r","+            <div className=\"flex items-center gap-2 text-xs text-muted-foreground\">\r","+              <span className=\"tabular-nums\">{String(i + 1).padStart(2, '0')}</span>\r","+              <StatusIcon status={st} />\r","+              <span className=\"truncate text-foreground\">{s.label}</span>\r","+            </div>\r","+            {s.id === 'profiles' ? (\r","+              <div className=\"mt-1.5 flex gap-1\" aria-hidden>\r","+                {LANE_COLORS.map((c, l) => (\r","+                  <span key={c} className=\"h-1 flex-1 rounded-full\" style={{ background: c, opacity: l < state.profiles.length ? 1 : st === 'running' ? 0.35 : 0.2 }} />\r","+                ))}\r","+              </div>\r","+            ) : null}\r","+          </li>\r","+        )\r","+      })}\r","+    </ol>\r","+  )\r","+}\r","+\r","+export function StatusIcon({ status }: { status: 'pending' | 'running' | 'done' }) {\r","+  if (status === 'done') return <Check className=\"size-3.5 shrink-0 text-foreground\" aria-label=\"done\" />\r","+  if (status === 'running') return <Loader2 className=\"size-3.5 shrink-0 animate-spin text-[#c9732a]\" aria-label=\"running\" />\r","+  return <Circle className=\"size-3 shrink-0 opacity-40\" aria-label=\"pending\" />\r","+}\r","+\r","+/** Shown on a stage page before its stage has started. */\r","+export function EmptyStage({ after, onGo }: { after: string; onGo: () => void }) {\r","+  const { state } = useRun()\r","+  return (\r","+    <Card className=\"items-start gap-3 [--card-spacing:--spacing(8)]\">\r","+      <CardContent className=\"space-y-3\">\r","+        <p className=\"eyebrow\">Not started</p>\r","+        <p className=\"max-w-lg text-muted-foreground\">\r","+          {state.phase === 'idle' ? 'Start a run from the patient case. ' : ''}This step runs after {after}.\r","+        </p>\r","+        {state.phase === 'idle' ? <Button onClick={onGo}>Go to patient case</Button> : null}\r","+      </CardContent>\r","+    </Card>\r","+  )\r","+}\r","+\r","+function StepRow({ item }: { item: TraceItem }) {\r","+  const [open, setOpen] = useState(false)\r","+  const Icon = STEP_ICON[item.step.type]\r","+  return (\r","+    <div className=\"border-b border-border/60 last:border-b-0\">\r","+      <button type=\"button\" onClick={() => setOpen((v) => !v)} className=\"flex w-full items-center gap-2 px-3 py-1.5 text-left hover:bg-foreground/[0.03]\">\r","+        <ChevronRight className={cn('size-3 shrink-0 text-muted-foreground transition-transform', open && 'rotate-90')} aria-hidden />\r","+        {item.lane !== undefined ? <span className=\"size-1.5 shrink-0 rounded-full\" style={{ background: LANE_COLORS[item.lane] }} /> : null}\r","+        <Icon className={cn('size-3.5 shrink-0', STEP_TONE[item.step.type])} aria-hidden />\r","+        <span className=\"truncate text-xs\">{item.step.label}</span>\r","+      </button>\r","+      {open ? <pre className=\"px-3 pb-2 pl-9 font-sans text-xs leading-relaxed whitespace-pre-wrap text-muted-foreground\">{item.step.content}</pre> : null}\r","+    </div>\r","+  )\r","+}\r","+\r","+/** Callio-style agent trace, filtered to one stage (and optionally one lane). */\r","+export function Trace({ stage, lane, title = 'Agent trace', className, maxH = 'max-h-[28rem]' }: { stage: StageId; lane?: number; title?: string; className?: string; maxH?: string }) {\r","+  const { state } = useRun()\r","+  const items = state.trace.filter((t) => t.stage === stage && (lane === undefined || t.lane === lane))\r","+  const running = state.stages[stage] === 'running'\r","+  const ref = useRef<HTMLDivElement>(null)\r","+  useEffect(() => {\r","+    ref.current?.scrollTo({ top: ref.current.scrollHeight })\r","+  }, [items.length])\r","+  return (\r","+    <Card className={cn('gap-0 py-0', className)}>\r","+      <div className=\"flex items-center justify-between border-b px-4 py-3\">\r","+        <span className=\"text-sm font-medium\">{title}</span>\r","+        <span className=\"text-xs text-muted-foreground tabular-nums\">{items.length} steps</span>\r","+      </div>\r","+      <div ref={ref} className={cn('overflow-y-auto', maxH)}>\r","+        {items.length ? items.map((it, i) => <StepRow key={i} item={it} />) : <p className=\"px-4 py-3 text-xs text-muted-foreground\">Waiting…</p>}\r","+      </div>\r","+      <div className=\"flex items-center gap-2 border-t px-3 py-2 text-xs text-muted-foreground\">\r","+        {running ? <><Loader2 className=\"size-3 animate-spin text-[#c9732a]\" aria-hidden /> Working…</> : state.stages[stage] === 'done' ? 'Done.' : 'Queued.'}\r","+      </div>\r","+    </Card>\r","+  )\r","+}\r","+\r","+/** Structured patient summary. In a live run the analysis agent fills this from the case PDF. */\r","+export function PatientCard({ compact = false, footer }: { compact?: boolean; footer?: ReactNode }) {\r","+  const p = SAMPLE_PATIENT\r","+  const rows: [string, string][] = [\r","+    ['Presentation', `${p.age}${p.sex} · ${p.onset} · ${p.monthsSinceDx} mo`],\r","+    ['ALSFRS-R', `${p.alsfrs}/48 · ${p.slope} pts/mo`],\r","+    ['FVC', `${p.fvc}% predicted`],\r","+    ['Genetics', p.genetics],\r","+    ['Medication', p.medications.join(', ')],\r","+    ['Conditions', p.comorbidities.join(', ')],\r","+    ['Location', `${p.location} · ${p.coverage}`],\r","+  ]\r","+  return (\r","+    <Card className=\"gap-3 [--card-spacing:--spacing(5)]\">\r","+      <CardHeader>\r","+        <CardTitle className=\"text-lg font-normal\">{p.label}</CardTitle>\r","+        <CardAction>\r","+          {p.fusEligible ? (\r","+            <Badge variant=\"outline\" className=\"gap-1 border-[#c9732a]/40 bg-[#c9732a]/10 font-normal text-[#a35b1d]\">\r","+              <Zap className=\"size-3\" aria-hidden /> MRgFUS eligible\r","+            </Badge>\r","+          ) : null}\r","+        </CardAction>\r","+      </CardHeader>\r","+      <CardContent>\r","+        <dl className={cn('grid grid-cols-[6.5rem_1fr] gap-x-3 gap-y-1.5 text-sm', compact && 'text-xs')}>\r","+          {(compact ? rows.slice(0, 5) : rows).map(([k, v]) => (\r","+            <div key={k} className=\"contents\">\r","+              <dt className=\"text-muted-foreground\">{k}</dt>\r","+              <dd>{v}</dd>\r","+            </div>\r","+          ))}\r","+        </dl>\r","+        {!compact ? (\r","+          <div className=\"mt-4 flex flex-wrap gap-1.5\">\r","+            {p.preferences.map((x) => (\r","+              <Badge key={x} variant=\"outline\" className=\"font-normal\">{x}</Badge>\r","+            ))}\r","+          </div>\r","+        ) : null}\r","+        {footer}\r","+      </CardContent>\r","+    </Card>\r","+  )\r","+}\r"]}]},{"filePath":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\lib\\run-store.tsx","hunks":[{"oldStart":1,"oldLines":135,"newStart":1,"newLines":134,"lines":["-import { createContext, useCallback, useContext, useEffect, useReducer, useRef, useState, type ReactNode } from 'react'","-import type { CaseFile } from './case-pdf'","-import {","-  SAMPLE_PATIENT, runDemoPipeline,","-  type AgentStep, type DrugProfile, type PipelineEvent, type StageId, type Weights,","-} from './pipeline'","-","-/**","- * One discovery run, shared by every pipeline page (case → analysis → profiles →","- * embedding → candidates → report). Lives above the pages so the run keeps going","- * while you move between them.","- */","-","-export type StageStatus = 'pending' | 'running' | 'done'","-export type TraceItem = { stage: StageId; lane?: number; step: AgentStep }","-export type CompletedRun = { id: string; date: string; weights: Weights; goal: string; caseName: string | null }","-","-export type RunState = {","-  phase: 'idle' | 'running' | 'done'","-  stages: Record<StageId, StageStatus>","-  trace: TraceItem[]","-  profiles: DrugProfile[]","-  matches: boolean","-  candidates: boolean","-  report: boolean","-}","-","-const initial: RunState = {","-  phase: 'idle',","-  stages: { analysis: 'pending', profiles: 'pending', embedding: 'pending', research: 'pending', report: 'pending' },","-  trace: [],","-  profiles: [],","-  matches: false,","-  candidates: false,","-  report: false,","-}","-","-type Action = PipelineEvent | { type: 'start' } | { type: 'finish' } | { type: 'reset' }","-","-function reducer(s: RunState, a: Action): RunState {","-  switch (a.type) {","-    case 'reset':","-      return initial","-    case 'start':","-      return { ...initial, phase: 'running' }","-    case 'finish':","-      return { ...s, phase: 'done' }","-    case 'stage':","-      return { ...s, stages: { ...s.stages, [a.stage]: a.status } }","-    case 'step':","-      return { ...s, trace: [...s.trace, { stage: a.stage, lane: a.lane, step: a.step }] }","-    case 'profile':","-      return { ...s, profiles: [...s.profiles, a.profile].sort((x, y) => x.lane - y.lane) }","-    case 'matches':","-      return { ...s, matches: true }","-    case 'candidates':","-      return { ...s, candidates: true }","-    case 'report':","-      return { ...s, report: true }","-  }","-}","-","-export const DEFAULT_GOAL =","-  'Find approved or late-stage drugs that could slow progression or ease bulbar symptoms for this patient, now that MRgFUS can open the blood–brain barrier over motor cortex.'","-","-type Store = {","-  state: RunState","-  caseFile: CaseFile | null","-  setCaseFile: (f: CaseFile | null) => void","-  goal: string","-  setGoal: (g: string) => void","-  weights: Weights","-  setWeights: (w: Weights) => void","-  date: string","-  runs: CompletedRun[]","-  start: () => void","-  skip: () => void","-  reset: () => void","-}","-","-const Ctx = createContext<Store | null>(null)","-","-export function RunProvider({ children, onStage }: { children: ReactNode; onStage?: (stage: StageId) => void }) {","-  const [state, dispatch] = useReducer(reducer, initial)","-  const [caseFile, setCaseFile] = useState<CaseFile | null>(null)","-  const [goal, setGoal] = useState(DEFAULT_GOAL)","-  const [weights, setWeights] = useState<Weights>({ fit: true, safety: true, cost: true, availability: true, acceptance: true })","-  const [date, setDate] = useState('')","-  const [runs, setRuns] = useState<CompletedRun[]>([])","-  const runner = useRef<{ cancel: () => void; skip: () => void } | null>(null)","-  const onStageRef = useRef(onStage)","-  onStageRef.current = onStage","-","-  useEffect(() => () => runner.current?.cancel(), [])","-","-  const start = useCallback(() => {","-    runner.current?.cancel()","-    dispatch({ type: 'start' })","-    const when = new Intl.DateTimeFormat('en-CA', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date())","-    setDate(when)","-    const caseInput = caseFile","-      ? { name: caseFile.name, pages: caseFile.pages, words: caseFile.words, excerpt: caseFile.text.join(' ').slice(0, 220).trim() }","-      : null","-    runner.current = runDemoPipeline(","-      SAMPLE_PATIENT,","-      caseInput,","-      (e) => {","-        dispatch(e)","-        if (e.type === 'stage' && e.status === 'running') onStageRef.current?.(e.stage)","-      },","-      () => {","-        dispatch({ type: 'finish' })","-        setRuns((r) => [{ id: crypto.randomUUID(), date: when, weights, goal, caseName: caseFile?.name ?? null }, ...r])","-      },","-    )","-  }, [caseFile, goal, weights])","-","-  const skip = useCallback(() => runner.current?.skip(), [])","-  const reset = useCallback(() => {","-    runner.current?.cancel()","-    dispatch({ type: 'reset' })","-  }, [])","-","-  return (","-    <Ctx.Provider value={{ state, caseFile, setCaseFile, goal, setGoal, weights, setWeights, date, runs, start, skip, reset }}>","-      {children}","-    </Ctx.Provider>","-  )","-}","-","-export function useRun() {","-  const ctx = useContext(Ctx)","-  if (!ctx) throw new Error('useRun must be used inside <RunProvider>')","-  return ctx","-}","+import { createContext, useCallback, useContext, useEffect, useReducer, useRef, useState, type ReactNode } from 'react'\r","+import type { CaseFile } from './case-pdf'\r","+import {\r","+  SAMPLE_PATIENT, runDemoPipeline,\r","+  type AgentStep, type DrugProfile, type PipelineEvent, type StageId, type Weights,\r","+} from './pipeline'\r","+\r","+/**\r","+ * One discovery run, shared by every pipeline page (case → analysis → profiles →\r","+ * embedding → candidates → report). Lives above the pages so the run keeps going\r","+ * while you move between them.\r","+ */\r","+\r","+export type StageStatus = 'pending' | 'running' | 'done'\r","+export type TraceItem = { stage: StageId; lane?: number; step: AgentStep }\r","+export type CompletedRun = { id: string; date: string; weights: Weights; goal: string; caseName: string | null }\r","+\r","+export type RunState = {\r","+  phase: 'idle' | 'running' | 'done'\r","+  stages: Record<StageId, StageStatus>\r","+  trace: TraceItem[]\r","+  profiles: DrugProfile[]\r","+  matches: boolean\r","+  candidates: boolean\r","+  report: boolean\r","+}\r","+\r","+const initial: RunState = {\r","+  phase: 'idle',\r","+  stages: { analysis: 'pending', profiles: 'pending', embedding: 'pending', research: 'pending', report: 'pending' },\r","+  trace: [],\r","+  profiles: [],\r","+  matches: false,\r","+  candidates: false,\r","+  report: false,\r","+}\r","+\r","+type Action = PipelineEvent | { type: 'start' } | { type: 'finish' } | { type: 'reset' }\r","+\r","+function reducer(s: RunState, a: Action): RunState {\r","+  switch (a.type) {\r","+    case 'reset':\r","+      return initial\r","+    case 'start':\r","+      return { ...initial, phase: 'running' }\r","+    case 'finish':\r","+      return { ...s, phase: 'done' }\r","+    case 'stage':\r","+      return { ...s, stages: { ...s.stages, [a.stage]: a.status } }\r","+    case 'step':\r","+      return { ...s, trace: [...s.trace, { stage: a.stage, lane: a.lane, step: a.step }] }\r","+    case 'profile':\r","+      return { ...s, profiles: [...s.profiles, a.profile].sort((x, y) => x.lane - y.lane) }\r","+    case 'matches':\r","+      return { ...s, matches: true }\r","+    case 'candidates':\r","+      return { ...s, candidates: true }\r","+    case 'report':\r","+      return { ...s, report: true }\r","+  }\r","+}\r","+\r","+export const DEFAULT_GOAL = 'Drugs that could slow progression or ease bulbar symptoms, given MRgFUS can open the blood–brain barrier.'\r","+\r","+type Store = {\r","+  state: RunState\r","+  caseFile: CaseFile | null\r","+  setCaseFile: (f: CaseFile | null) => void\r","+  goal: string\r","+  setGoal: (g: string) => void\r","+  weights: Weights\r","+  setWeights: (w: Weights) => void\r","+  date: string\r","+  runs: CompletedRun[]\r","+  start: () => void\r","+  skip: () => void\r","+  reset: () => void\r","+}\r","+\r","+const Ctx = createContext<Store | null>(null)\r","+\r","+export function RunProvider({ children, onStage }: { children: ReactNode; onStage?: (stage: StageId) => void }) {\r","+  const [state, dispatch] = useReducer(reducer, initial)\r","+  const [caseFile, setCaseFile] = useState<CaseFile | null>(null)\r","+  const [goal, setGoal] = useState(DEFAULT_GOAL)\r","+  const [weights, setWeights] = useState<Weights>({ fit: true, safety: true, cost: true, availability: true, acceptance: true })\r","+  const [date, setDate] = useState('')\r","+  const [runs, setRuns] = useState<CompletedRun[]>([])\r","+  const runner = useRef<{ cancel: () => void; skip: () => void } | null>(null)\r","+  const onStageRef = useRef(onStage)\r","+  onStageRef.current = onStage\r","+\r","+  useEffect(() => () => runner.current?.cancel(), [])\r","+\r","+  const start = useCallback(() => {\r","+    runner.current?.cancel()\r","+    dispatch({ type: 'start' })\r","+    const when = new Intl.DateTimeFormat('en-CA', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date())\r","+    setDate(when)\r","+    const caseInput = caseFile\r","+      ? { name: caseFile.name, pages: caseFile.pages, words: caseFile.words, excerpt: caseFile.text.join(' ').slice(0, 220).trim() }\r","+      : null\r","+    runner.current = runDemoPipeline(\r","+      SAMPLE_PATIENT,\r","+      caseInput,\r","+      (e) => {\r","+        dispatch(e)\r","+        if (e.type === 'stage' && e.status === 'running') onStageRef.current?.(e.stage)\r","+      },\r","+      () => {\r","+        dispatch({ type: 'finish' })\r","+        setRuns((r) => [{ id: crypto.randomUUID(), date: when, weights, goal, caseName: caseFile?.name ?? null }, ...r])\r","+      },\r","+    )\r","+  }, [caseFile, goal, weights])\r","+\r","+  const skip = useCallback(() => runner.current?.skip(), [])\r","+  const reset = useCallback(() => {\r","+    runner.current?.cancel()\r","+    dispatch({ type: 'reset' })\r","+  }, [])\r","+\r","+  return (\r","+    <Ctx.Provider value={{ state, caseFile, setCaseFile, goal, setGoal, weights, setWeights, date, runs, start, skip, reset }}>\r","+      {children}\r","+    </Ctx.Provider>\r","+  )\r","+}\r","+\r","+export function useRun() {\r","+  const ctx = useContext(Ctx)\r","+  if (!ctx) throw new Error('useRun must be used inside <RunProvider>')\r","+  return ctx\r","+}"]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\discovery\\pages.tsx","C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\discovery\\pieces.tsx","C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\lib\\run-store.tsx"]}},"serverClassifierContext":{"request":"2ca91b92-423a-465f-8ca6-655644f9c3aa","context":{"git_state":{"cwd":"/c/Users/jerem/BioHacks-2026/frontend","root":"/c/Users/jerem/BioHacks-2026","branch":"frontend/diagnosis","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":9,"untracked":null,"untracked_normal":4},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"penguinyogurt/BioHacks-2026","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"penguinyogurt/BioHacks-2026","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"penguinyogurt/BioHacks-2026","visibility":"public"}]}},"live_cwd":"/c/Users/jerem/BioHacks-2026/frontend","platform":"windows"}},"sandboxed":false,"sourceToolAssistantUUID":"cc652281-03c