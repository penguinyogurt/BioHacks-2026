 point.age += dt;\n769\t      });\n770\t      while (trail.length && trail[trail.length - 1].age > TRAIL_LIFE) trail.pop();\n771\t      for (let i = 0; i < MAX_TRAIL; i++) {\n772\t        const point = trail[i];\n773\t        if (!point) {\n774\t          trailData[i * 4 + 2] = 0;\n775\t          continue;\n776\t        }\n777\t        const k = 1 - point.age / TRAIL_LIFE;\n778\t        trailData.set([point.x, point.y, k * k, 0], i * 4);\n779\t      }\n780\t      clicks.forEach(click => {\n781\t        click.age += dt;\n782\t      });\n783\t      while (clicks.length && clicks[clicks.length - 1].age > CLICK_LIFE) clicks.pop();\n784\t      for (let i = 0; i < MAX_CLICKS; i++) {\n785\t        const click = clicks[i];\n786\t        if (!click) {\n787\t          clickData[i * 4 + 3] = 0;\n788\t          continue;\n789\t        }\n790\t        const k = click.age / CLICK_LIFE;\n791\t        const envelope = Math.min(1, click.age / 0.08) * (1 - k) * (1 - k);\n792\t        clickData.set([click.x, click.y, click.age, envelope], i * 4);\n793\t      }\n794\t    };\n795\t\n796\t    const frame = (now: number) => {\n797\t      raf = 0;\n798\t      if (disposed || !visible || document.hidden) return;\n799\t      const s = settingsRef.current;\n800\t      const dt = last ? clamp((now - last) / 1000, 0.001, 0.05) : 1 / 60;\n801\t      last = now;\n802\t      if (!reduce) {\n803\t        time += dt * s.speed * 0.5;\n804\t        glyphTime += dt * Math.max(s.speed, 0.15);\n805\t      }\n806\t      if (introClock < 1) introClock = Math.min(1, introClock + dt / INTRO_SECONDS);\n807\t      grainClock += dt;\n808\t      if (!reduce && grainClock > 1 / 24) {\n809\t        grainClock = 0;\n810\t        frameSeed = (frameSeed + 1) % 97;\n811\t      }\n812\t      updateInput(dt);\n813\t      draw();\n814\t      const busy = !reduce || introClock < 1 || clicks.length > 0 || trail.length > 0;\n815\t      if (busy) raf = requestAnimationFrame(frame);\n816\t      else last = 0;\n817\t    };\n818\t\n819\t    function wake() {\n820\t      if (!raf && !disposed && visible && !document.hidden) raf = requestAnimationFrame(frame);\n821\t    }\n822\t\n823\t    const locate = (event: PointerEvent) => {\n824\t      const rect = container.getBoundingClientRect();\n825\t      const x = (event.clientX - rect.left) / Math.max(1, rect.width);\n826\t      const y = 1 - (event.clientY - rect.top) / Math.max(1, rect.height);\n827\t      const aspect = rect.width / Math.max(1, rect.height);\n828\t      pointer.inside = x >= 0 && x <= 1 && y >= 0 && y <= 1;\n829\t      pointer.x = (x - 0.5) * aspect;\n830\t      pointer.y = y - 0.5;\n831\t    };\n832\t\n833\t    const onPointerMove = (event: PointerEvent) => {\n834\t      locate(event);\n835\t      const s = settingsRef.current;\n836\t      if (!pointer.inside || !s.mouseInteraction || reduce) return;\n837\t      const head = trail[0];\n838\t      const gap = head ? Math.hypot(pointer.x - head.x, pointer.y - head.y) : Infinity;\n839\t      if (gap < TRAIL_STEP) return;\n840\t      if (head && head.age < 0.1) {\n841\t        const steps = Math.min(6, Math.floor(gap / (TRAIL_STEP * 2)));\n842\t        for (let i = 1; i <= steps; i++) {\n843\t          const k = i / (steps + 1);\n844\t          trail.unshift({ x: head.x + (pointer.x - head.x) * k, y: head.y + (pointer.y - head.y) * k, age: 0 });\n845\t        }\n846\t      }\n847\t      trail.unshift({ x: pointer.x, y: pointer.y, age: 0 });\n848\t      trail.length = Math.min(trail.length, MAX_TRAIL);\n849\t      wake();\n850\t    };\n851\t\n852\t    const onPointerDown = (event: PointerEvent) => {\n853\t      locate(event);\n854\t      const s = settingsRef.current;\n855\t      if (!pointer.inside || !s.clickEffect || reduce) return;\n856\t      clicks.unshift({ x: pointer.x, y: pointer.y, age: 0 });\n857\t      if (clicks.length > MAX_CLICKS) clicks.pop();\n858\t      wake();\n859\t    };\n860\t\n861\t    const onVisibility = () => {\n862\t      last = 0;\n863\t      wake();\n864\t    };\n865\t\n866\t    const resizeObserver = new ResizeObserver(resize);\n867\t    resizeObserver.observe(container);\n868\t    const intersection = new IntersectionObserver(entries => {\n869\t      visible = entries.some(entry => entry.isIntersecting);\n870\t      if (visible) {\n871\t        last = 0;\n872\t        wake();\n873\t      }\n874\t    });\n875\t    intersection.observe(container);\n876\t    window.addEventListener('pointermove', onPointerMove, { passive: true });\n877\t    window.addEventListener('pointerdown', onPointerDown, { passive: true });\n878\t    document.addEventListener('visibilitychange', onVisibility);\n879\t    resize();\n880\t    wakeRef.current = wake;\n881\t\n882\t    return () => {\n883\t      disposed = true;\n884\t      cancelAnimationFrame(raf);\n885\t      wakeRef.current = null;\n886\t      resizeObserver.disconnect();\n887\t      intersection.disconnect();\n888\t      window.removeEventListener('pointermove', onPointerMove);\n889\t      window.removeEventListener('pointerdown', onPointerDown);\n890\t      document.removeEventListener('visibilitychange', onVisibility);\n891\t      [fieldTarget, haloA, haloB].forEach(target => {\n892\t        target.textures.forEach(texture => gl.deleteTexture(texture));\n893\t        gl.deleteFramebuffer(target.framebuffer);\n894\t      });\n895\t      if (atlas) gl.deleteTexture(atlas.texture);\n896\t      gl.deleteVertexArray(vao);\n897\t      [field, halo, blur, composite].forEach(item => gl.deleteProgram(item.program));\n898\t      gl.getExtension('WEBGL_lose_context')?.loseContext();\n899\t    };\n900\t  }, []);\n901\t\n902\t  useEffect(() => {\n903\t    wakeRef.current?.();\n904\t  });\n905\t\n906\t  return (\n907\t    <div\n908\t      ref={containerRef}\n909\t      className={['relative h-full w-full overflow-hidden', className].filter(Boolean).join(' ')}\n910\t      style={style}\n911\t      {...rest}\n912\t    >\n913\t      <canvas ref={canvasRef} className=\"absolute inset-0 bl