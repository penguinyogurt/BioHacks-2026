lassName=\"absolute right-5 bottom-4 z-10 text-[11px] text-black/45 [&_a]:underline [&_a]:decoration-black/25 [&_a]:underline-offset-2 [&_a:hover]:text-black/80\">","+      <p className=\"absolute right-5 bottom-4 z-10 text-[11px] text-foreground/45 [&_a]:underline [&_a]:decoration-foreground/25 [&_a]:underline-offset-2 [&_a:hover]:text-foreground/80\">","         <a href=\"https://sketchfab.com/3d-models/neuron-cell-low-poly-simple-3a09438daf364c3bbd3cce76f1c7afaa\" target=\"_blank\" rel=\"noreferrer\">Neuron Cell Low-poly Simple</a>","         {' by '}","         <a href=\"https://sketchfab.com/vitalik.kucha\" target=\"_blank\" rel=\"noreferrer\">vitalik.kucha</a>","         {' · '}","         <a href=\"http://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noreferrer\">CC BY 4.0</a>","       </p>","-","-      <Splash ready={modelLoaded} />","     </div>","   )"," }"]}],"originalFile":"import { useState } from 'react'\nimport { Navigate } from 'react-router-dom'\nimport Dither from '@/components/react-bits/Dither'\nimport GlassSurface from '@/components/react-bits/GlassSurface'\nimport NeuronViewer from '@/components/neuron-viewer'\nimport { Splash } from '@/components/splash'\nimport { AFTER_SIGN_IN, useAuth } from '@/lib/auth'\n\nconst reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches\n\nfunction GoogleIcon() {\n  return (\n    <svg className=\"size-4 shrink-0 opacity-90\" viewBox=\"0 0 24 24\" aria-hidden>\n      <path fill=\"currentColor\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" />\n      <path fill=\"currentColor\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" />\n      <path fill=\"currentColor\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\" />\n      <path fill=\"currentColor\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\" />\n    </svg>\n  )\n}\n\n/** Callio Labs' landing: dithered field, one 3D object, wordmark + glass sign-in pill bottom-left. */\nexport default function Landing() {\n  const { user, configured, signInWithGoogle } = useAuth()\n  const [modelLoaded, setModelLoaded] = useState(false)\n  const [busy, setBusy] = useState(false)\n  const [error, setError] = useState('')\n\n  if (user) return <Navigate to={AFTER_SIGN_IN} replace />\n\n  async function onSignIn() {\n    setBusy(true)\n    setError('')\n    const failed = await signInWithGoogle()\n    if (failed) {\n      setError(failed)\n      setBusy(false)\n    }\n  }\n\n  return (\n    <div className=\"relative h-dvh w-screen overflow-hidden bg-white text-black\">\n      <div className=\"absolute inset-0 z-0\">\n        <Dither\n          waveSpeed={0.02}\n          waveFrequency={3}\n          waveAmplitude={0.3}\n          backgroundColor={[1, 1, 1]}\n          waveColor={[0, 0, 0]}\n          colorNum={4}\n          pixelSize={2}\n          disableAnimation={reducedMotion}\n          enableMouseInteraction\n          mouseRadius={1.2}\n        />\n      </div>\n      <div className=\"absolute inset-0 z-0\">\n        <NeuronViewer onLoaded={() => setModelLoaded(true)} reducedMotion={reducedMotion} />\n      </div>\n\n      <main className=\"pointer-events-none absolute bottom-0 left-0 z-10 flex flex-col items-start pb-12 pl-12 md:pb-16 md:pl-16 lg:pb-20 lg:pl-20\">\n        <h1 className=\"font-brand text-6xl leading-none md:text-7xl lg:text-8xl\">motus</h1>\n        <p className=\"font-serif-display -mt-1 text-xl leading-none opacity-70 md:-mt-1.5 md:text-2xl lg:-mt-2 lg:text-3xl\">\n          early ALS detection\n        </p>\n        <GlassSurface\n          width={'fit-content' as unknown as number}\n          height={'fit-content' as unknown as number}\n          borderRadius={20}\n          className=\"pointer-events-auto mt-5 md:mt-6\"\n          contentClassName=\"p-0 !items-center !justify-center\"\n        >\n          <button\n            type=\"button\"\n            onClick={onSignIn}\n            disabled={!configured || busy}\n            aria-busy={busy}\n            className=\"font-serif-display flex cursor-pointer items-center gap-2 border-0 bg-transparent px-3 py-2 text-xs tracking-wide text-black/90 transition-colors hover:text-black disabled:cursor-not-allowed disabled:opacity-60\"\n          >\n            <GoogleIcon />\n            {busy ? 'Connecting…' : 'Sign in with Google'}\n          </button>\n        </GlassSurface>\n        {error ? <p className=\"mt-3 text-xs text-black/70\" role=\"alert\">{error}</p> : null}\n        {!configured ? <p className=\"mt-3 text-xs text-black/60\">Add Supabase keys to .env to enable sign-in.</p> : null}\n      </main>\n\n      {/* CC BY 4.0 attribution for the neuron model (public/models/neuron.LICENSE.txt). */}\n      <p className=\"absolute right-5 bottom-4 z-10 text-[11px] text-black/45 [&_a]:underline [&_a]:decoration-black/25 [&_a]:underline-offset-2 [&_a:hover]:text-black/80\">\n        <a href=\"https://sketchfab.com/3d-models/neuron-cell-low-poly-simple-3a09438daf364c3bbd3cce76f1c7afaa\" target=\"_blank\" rel=\"noreferrer\">Neuron Cell Low-poly Simple</a>\n        {' by '}\n        <a href=\"https://sketchfab.com/vitalik.kucha\" target=\"_blank\" rel=\"noreferrer\">vitalik.kucha</a>\n        {' · '}\n        <a href=\"http://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noreferrer\">CC BY 4.0</a>\n      </p>\n\n      <Splash ready={modelLoaded} />\n    </div>\n  )\n}\n","userModified":false},"sourceToolAssistantUUID":"d1c764aa-b3df-4710-9d1a-276479d5277c","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"28437234-f1be-440d-9452-c51de1bd38ab","userType":"external","entrypoint":"cli","cwd":