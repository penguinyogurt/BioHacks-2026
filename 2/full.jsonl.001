} intensity={3} />","+        <directionalLight position={[-8, 6, 4]} intensity={2} />","+        <directionalLight position={[0, -10, 2]} intensity={1.5} />","+        <pointLight position={[0, 0, 8]} intensity={2} />","+        <Controls autoRotate={!reducedMotion} />","+        <Suspense fallback={null}>","+          <Neuron onLoaded={onLoaded} />","+        </Suspense>","+      </Canvas>","     </div>","   )"," }"]}],"originalFile":"import { Suspense, useEffect, useMemo } from 'react'\nimport { Canvas, useFrame, useLoader, useThree } from '@react-three/fiber'\nimport * as THREE from 'three'\nimport { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js'\nimport { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js'\n\n/**\n * Callio Labs' DNA viewer, holding a neuron instead.\n * Model: \"Neuron Cell Low-poly Simple\" by vitalik.kucha, CC BY 4.0\n * (public/models/neuron.LICENSE.txt).\n */\n\nconst MODEL_URL = '/models/neuron.glb'\nconst MODEL_SIZE = 12 // largest dimension, world units\nconst COLOR = 0x606060\nconst OPACITY = 0.5\nconst VIEW_TILT_DEG = 30\nconst AUTO_ROTATE_SPEED = 3\n\nfunction Neuron({ onLoaded }: { onLoaded?: () => void }) {\n  const gltf = useLoader(GLTFLoader, MODEL_URL)\n\n  const { model, center, scale } = useMemo(() => {\n    const model = gltf.scene.clone(true)\n    model.updateMatrixWorld(true)\n    const box = new THREE.Box3().setFromObject(model)\n    const size = box.getSize(new THREE.Vector3())\n    return { model, center: box.getCenter(new THREE.Vector3()), scale: MODEL_SIZE / (Math.max(size.x, size.y, size.z) || 1) }\n  }, [gltf])\n\n  useEffect(() => {\n    const color = new THREE.Color(COLOR)\n    model.traverse((node) => {\n      const mesh = node as THREE.Mesh\n      if (!mesh.isMesh) return\n      mesh.frustumCulled = false\n      for (const m of Array.isArray(mesh.material) ? mesh.material : [mesh.material]) {\n        if ('color' in m && m.color instanceof THREE.Color) m.color.copy(color)\n        m.transparent = true\n        m.opacity = OPACITY\n        m.depthWrite = false\n      }\n    })\n    onLoaded?.()\n  }, [model, onLoaded])\n\n  return (\n    <group scale={scale}>\n      <group position={[-center.x, -center.y, -center.z]}>\n        <primitive object={model} />\n      </group>\n    </group>\n  )\n}\n\n/** three's OrbitControls, as Callio uses via drei: auto-rotate, drag to spin, no zoom. */\nfunction Controls({ autoRotate }: { autoRotate: boolean }) {\n  const { camera, gl } = useThree()\n  const controls = useMemo(() => new OrbitControls(camera, gl.domElement), [camera, gl])\n  useEffect(() => {\n    controls.autoRotate = autoRotate\n    controls.autoRotateSpeed = AUTO_ROTATE_SPEED\n    controls.enableZoom = false\n    controls.enableDamping = true\n    controls.minPolarAngle = Math.PI * 0.3\n    controls.maxPolarAngle = Math.PI * 0.7\n    return () => controls.dispose()\n  }, [controls, autoRotate])\n  useFrame(() => controls.update())\n  return null\n}\n\nexport default function NeuronViewer({ onLoaded, reducedMotion = false }: { onLoaded?: () => void; reducedMotion?: boolean }) {\n  return (\n    <div className=\"absolute inset-0 overflow-hidden\" style={{ cursor: 'grab' }}>\n      {/* Oversized and tilted like Callio's DNA, so the cell runs corner to corner. */}\n      <div\n        className=\"absolute\"\n        style={{\n          left: '50%',\n          top: '50%',\n          width: '145%',\n          height: '145%',\n          transform: `translate(calc(-50% + 11%), calc(-50% - 4%)) rotate(-${VIEW_TILT_DEG}deg)`,\n        }}\n      >\n        <Canvas\n          camera={{ position: [0, 0, 12], fov: 65 }}\n          // Measure layout size, not the rotated bounding box, so the scene stays centred in the tilted frame.\n          resize={{ offsetSize: true }}\n          dpr={[1, 2]}\n          gl={{ alpha: true, antialias: true, logarithmicDepthBuffer: true }}\n          style={{ width: '100%', height: '100%' }}\n        >\n          <ambientLight intensity={2} />\n          <directionalLight position={[8, 8, 6]} intensity={3} />\n          <directionalLight position={[-8, 6, 4]} intensity={2} />\n          <directionalLight position={[0, -10, 2]} intensity={1.5} />\n          <pointLight position={[0, 0, 8]} intensity={2} />\n          <Controls autoRotate={!reducedMotion} />\n          <Suspense fallback={null}>\n            <Neuron onLoaded={onLoaded} />\n          </Suspense>\n        </Canvas>\n      </div>\n    </div>\n  )\n}\n","userModified":false},"sourceToolAssistantUUID":"360d8521-2964-416e-97fd-ae2011a6566b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"28437234-f1be-440d-9452-c51de1bd38ab","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\jerem\\BioHacks-2026\\frontend","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","version":"2.1.319","gitBranch":"frontend/diagnosis"}
