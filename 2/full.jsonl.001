{"parentUuid":"8d26b6dc-7a61-4ac0-8ea7-d654b95e3ca5","isSidechain":false,"promptId":"23fb2881-f29f-424e-b551-8c71406ef78f","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HmMQ498Dzju1YU6SKFByAC","type":"tool_result","content":"1:import { useState } from 'react'\n2:import { Navigate } from 'react-router-dom'\n3:import Dither from '@/components/react-bits/Dither'\n4:import OverviewDashboard from '@/components/overview-dashboard'\n5:import DiscoveryWorkspace, { type CompletedRun } from '@/components/discovery/workspace'\n6:import Runs from '@/components/discovery/runs'\n7:import { AppSidebar, ALL_NAV, NAV_GROUPS, NAV_SECONDARY, type Profile } from '@/components/app-sidebar'\n8:import { Card } from '@/components/ui/card'\n9:import { Separator } from '@/components/ui/separator'\n10:import { SidebarInset, SidebarProvider, SidebarTrigger } from '@/components/ui/sidebar'\n11:import { TooltipProvider } from '@/components/ui/tooltip'\n12:import { useAuth } from '@/lib/auth'\n13:import { SAMPLE_PATIENT } from '@/lib/pipeline'\n14:import { DITHER_INK, DITHER_PAPER } from '@/lib/theme'\n15:\n16:const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches\n17:\n18:/** Placeholder copy for views that aren't built yet. */\n19:const VIEWS: Record<string, { title: string; description: string; placeholder: string }> = {\n20:  graph: {\n80:  const [runs, setRuns] = useState<CompletedRun[]>([])\n81:  const [runKey, setRunKey] = useState(0)\n82:\n83:  if (configured && loading) return null\n84:  if (configured && !user) return <Navigate to=\"/\" replace />\n85:\n86:  // Without Supabase keys the page still renders, on sample data, so the UI can be worked on.\n87:  const meta = user?.user_metadata ?? {}\n88:  const profile: Profile = user\n89:    ? { name: meta.full_name ?? meta.name ?? user.email ?? 'You', email: user.email ?? '', avatar: meta.avatar_url ?? meta.picture }\n90:    : { name: 'Demo researcher', email: 'Sign-in not configured' }\n91:\n92:  // \"New discovery run\" resets the workspace.\n93:  const select = (v: string) => {\n94:    if (v === 'new-run') {\n95:      setRunKey((k) => k + 1)\n96:      setView('discovery')\n97:    } else setView(v)\n98:  }\n99:  const label = ALL_NAV.find((n) => n.value === view)?.label ?? 'Discovery'\n100:  const section =\n101:    NAV_GROUPS.find((g) => g.items.some((i) => i.value === view))?.label ??\n102:    (NAV_SECONDARY.some((i) => i.value === view) ? 'Account' : 'Discovery')\n103:  const page = VIEWS[view]\n104:\n105:  return (\n106:    <div className=\"relative h-dvh w-full overflow-hidden text-foreground\">\n107:      {/* The landing's dither field runs behind the whole workspace. */}\n108:      <div className=\"fixed inset-0 z-0\" aria-hidden>\n109:        <Dither\n110:          waveSpeed={0.02}\n111:          waveFrequency={3}\n112:          waveAmplitude={0.3}\n113:          backgroundColor={DITHER_PAPER}\n114:          waveColor={DITHER_INK}\n115:          colorNum={4}\n116:          pixelSize={2}\n117:          disableAnimation={reducedMotion}\n118:          enableMouseInteraction\n119:          mouseRadius={1.2}\n120:        />\n121:      </div>\n122:\n123:      <TooltipProvider delayDuration={0}>\n124:        <SidebarProvider\n125:          className=\"relative z-10 h-dvh min-h-0 !bg-transparent\"\n126:          style={{ '--sidebar-width': 'calc(var(--spacing) * 72)', '--header-height': 'calc(var(--spacing) * 12)' } as React.CSSProperties}\n127:        >\n128:          <AppSidebar active={view} onSelect={select} profile={profile} onSignOut={user ? signOut : undefined} />\n129:          <SidebarInset className=\"min-h-0 overflow-y-auto !bg-transparent\">\n130:            <header className=\"sticky top-0 z-10 flex h-(--header-height) shrink-0 items-center gap-2 border-b border-border bg-background/60 backdrop-blur-md\">\n131:              <div className=\"flex w-full items-center gap-1 px-4 lg:gap-2 lg:px-6\">\n132:                <SidebarTrigger className=\"-ml-1\" />\n133:                <Separator orientation=\"vertical\" className=\"mx-2 data-[orientation=vertical]:h-4\" />\n134:                <h1 className=\"text-base font-medium\">{label}</h1>\n135:              </div>\n136:            </header>\n137:            <div className=\"px-4 pt-6 pb-16 lg:px-6\">\n138:              {/* Kept mounted so a running discovery survives navigating away. */}\n139:              <div hidden={view !== 'discovery'}>\n140:                <DiscoveryWorkspace key={runKey} onComplete={(run) => setRuns((r) => [run, ...r])} />\n141:              </div>\n142:              {view === 'discovery' ? null : view === 'runs' ? (\n143:                <Runs runs={runs} onNewRun={() => select('new-run')} />\n144:              ) : view === 'patient' ? (\n145:                <OverviewDashboard title={SAMPLE_PATIENT.label} />\n146:              ) : (\n147:                <div className=\"pt-8 lg:pt-12\">\n148:                  <p className=\"eyebrow mb-8\">{section} / {label}</p>\n149:                  <div aria-live=\"polite\">\n150:                    <h2 className=\"font-brand text-[clamp(2.75rem,7vw,4.5rem)] leading-none\">{page.title}</h2>\n151:                    <p className=\"mt-6 max-w-xl text-lg text-muted-foreground\">{page.description}</p>\n152:                  </div>\n153:                  <Card className=\"mt-12 max-w-2xl gap-4 [--card-spacing:--spacing(8)]\">\n154:                    <div className=\"px-8\">\n155:                      <p className=\"eyebrow\">Coming soon</p>\n156:                      <h3 className=\"mt-4 text-2xl font-medium\">{label}</h3>\n157:                      <p className=\"mt-4 text-muted-foreground\">{page.placeholder}</p>\n158:                    </div>\n159:                  </Card>\n160:                </div>\n161:              )}\n162:            </div>\n163:          </SidebarInset>\n164:        </SidebarProvider>\n165:      </TooltipProvider>\n166:    </div>\n167:  )\n168:}","is_error":fals