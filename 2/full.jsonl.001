   <span>\n                      <span className=\"block text-sm\">{c.label}</span>\n                      <span className=\"block text-xs text-muted-foreground\">{c.hint}</span>\n                    </span>\n                  </label>\n                ))}\n              </div>\n            </div>\n            <div className=\"flex flex-wrap items-center justify-between gap-3 border-t pt-4\">\n              <span className=\"max-w-xs text-xs text-muted-foreground\">Delivery assumption: MR-guided focused ultrasound BBB opening (Sunnybrook)</span>\n              {state.phase === 'running' ? (\"\"\",\n     \"\"\"      <StageHeader step=\"00 · Patient case\" title=\"Start with the patient.\" rail={false} />\n      <div className=\"grid gap-3 lg:grid-cols-12\">\n        <div className=\"space-y-3 lg:col-span-6\">\n          <CaseUpload />\n          <PatientCard\n            compact\n            footer={!caseFile ? <p className=\"mt-3 text-xs text-muted-foreground\">Sample patient — used until you add a case.</p> : null}\n          />\n        </div>\n        <Card className=\"gap-4 self-start [--card-spacing:--spacing(5)] lg:col-span-6\">\n          <CardHeader>\n            <CardTitle className=\"text-lg font-normal\">Goal</CardTitle>\n          </CardHeader>\n          <CardContent className=\"space-y-5\">\n            <Textarea value={goal} onChange={(e) => setGoal(e.target.value)} rows={3} className=\"bg-background/70 text-sm\" aria-label=\"Research goal\" />\n            <div className=\"flex flex-wrap gap-x-4 gap-y-2.5\">\n              {CRITERIA.map((c) => (\n                <label key={c.key} className=\"flex items-center gap-2 text-xs\" title={c.hint}>\n                  <Switch checked={weights[c.key]} onCheckedChange={(v) => setWeights({ ...weights, [c.key]: v })} />\n                  {c.label}\n                </label>\n              ))}\n            </div>\n            <div className=\"flex flex-wrap items-center justify-between gap-3 border-t pt-4\">\n              <span className=\"text-xs text-muted-foreground\">Delivery: MRgFUS</span>\n              {state.phase === 'running' ? (\"\"\"),\n])\n\nedit('src/components/discovery/pieces.tsx', [\n    (\"export function StageHeader({ step, title, description, rail = true }: { step: string; title: string; description: string; rail?: boolean }) {\",\n     \"export function StageHeader({ step, title, description, rail = true }: { step: string; title: string; description?: string; rail?: boolean }) {\"),\n    (\"\"\"            <p className=\"mt-3 max-w-2xl text-muted-foreground\">{description}</p>\"\"\",\n     \"\"\"            {description ? <p className=\"mt-3 max-w-2xl text-muted-foreground\">{description}</p> : null}\"\"\"),\n])\n\nedit('src/lib/run-store.tsx', [\n    (\"\"\"export const DEFAULT_GOAL =\n  'Find approved or late-stage drugs that could slow progression or ease bulbar symptoms for this patient, now that MRgFUS can open the blood–brain barrier over motor cortex.'\"\"\",\n     \"\"\"export const DEFAULT_GOAL = 'Drugs that could slow progression or ease bulbar symptoms, given MRgFUS can open the blood–brain barrier.'\"\"\"),\n])\nprint('ok')\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"9ecb5823-f629-4b38-99d3-9a5f62467fd0","permissionDecision":{"decision":"accept","source":"config","reasonType":"other"},"session_id":"28437234-f1be-440d-9452-c51de1bd38ab","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\jerem\\BioHacks-2026\\frontend","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","version":"2.1.319","gitBranch":"frontend/diagnosis"}
