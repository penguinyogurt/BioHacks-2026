,"+    const g = guide.current\r","+    const c = comet.current\r","+    if (!h || !g || !c) return\r","+    const r = h.getBoundingClientRect()\r","+    const tx = r.right - r.width * 0.16 // lands on the top of the last letters\r","+    const ty = r.top + r.height * 0.12\r","+    const dy = ty - y\r","+    const d = `M ${x} ${y} C ${x} ${y + dy * 0.55}, ${tx} ${ty - dy * 0.45}, ${tx} ${ty}`\r","+    g.setAttribute('d', d)\r","+    c.setAttribute('d', d)\r","+    g.style.opacity = '1'\r","+    const len = c.getTotalLength()\r","+    const seg = Math.min(180, len * 0.4)\r","+    c.style.strokeDasharray = `${seg} ${len + seg}`\r","+    c.animate([{ strokeDashoffset: seg }, { strokeDashoffset: -len }], { duration: 1300, easing: 'cubic-bezier(0.45, 0, 0.25, 1)' }).onfinish = () => {\r","+      h.animate(\r","+        [\r","+          { color: INK, textShadow: `0 0 0 ${AMBER}00` },\r","+          { color: '#b8621f', textShadow: `0 0 22px ${AMBER}99`, offset: 0.18 },\r","+          { color: INK, textShadow: `0 0 0 ${AMBER}00` },\r","+        ],\r","+        { duration: 1800, easing: 'ease-out' },\r","+      )\r","+    }\r","+  }, [])\r","+\r","+  return { name, guide, comet, fire }\r","+}\r","+\r","+export default function Landing() {\r","+  const { user, configured, signInWithGoogle } = useAuth()\r","+  const [busy, setBusy] = useState(false)\r","+  const [error, setError] = useState('')\r","+  const signal = useSignalToName()\r","+\r","+  if (user) return <Navigate to={AFTER_SIGN_IN} replace />\r","+\r","+  async function onSignIn() {\r","+    setBusy(true)\r","+    setError('')\r","+    const failed = await signInWithGoogle()\r","+    if (failed) {\r","+      setError(failed)\r","+      setBusy(false)\r","+    }\r","+  }\r","+\r","+  return (\r","+    <div className=\"relative h-dvh w-screen overflow-hidden bg-background text-foreground\">\r","+      <div className=\"absolute inset-0 z-0\">\r","+        <AsciiBackground />\r","+      </div>\r","+\r","+      {/* The neuron lies across the top of the page: soma left, axon running right to its terminals. */}\r","+      <NeuronViewer\r","+        reducedMotion={reducedMotion}\r","+        onTerminals={signal.fire}\r","+        className=\"absolute inset-0 z-0\"\r","+      />\r","+\r","+      {/* From the terminals, the signal carries on down to the name. */}\r","+      <svg className=\"pointer-events-none absolute inset-0 z-[5] h-full w-full\" aria-hidden>\r","+        <defs>\r","+          <filter id=\"signal-glow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\r","+            <feGaussianBlur stdDeviation=\"4\" result=\"blur\" />\r","+            <feMerge>\r","+              <feMergeNode in=\"blur\" />\r","+              <feMergeNode in=\"SourceGraphic\" />\r","+            </feMerge>\r","+          </filter>\r","+        </defs>\r","+        <path ref={signal.guide} fill=\"none\" stroke=\"currentColor\" strokeOpacity=\"0.14\" strokeWidth=\"1.25\" strokeDasharray=\"2 6\" style={{ opacity: 0, transition: 'opacity 600ms ease-out' }} />\r","+        <path ref={signal.comet} fill=\"none\" stroke={AMBER} strokeWidth=\"4\" strokeLinecap=\"round\" filter=\"url(#signal-glow)\" style={{ strokeDasharray: '0 100000' }} />\r","+      </svg>\r","+\r","+      <main className=\"pointer-events-none absolute right-0 bottom-0 z-10 flex flex-col items-end pr-10 pb-12 text-right md:pr-16 md:pb-16 lg:pr-20 lg:pb-20\">\r","+        <h1 ref={signal.name} className=\"font-brand text-6xl leading-none tracking-tight md:text-7xl lg:text-8xl\">addo labs</h1>\r","+        <p className=\"font-serif-display mt-1 text-2xl leading-tight text-foreground/75 italic md:text-3xl lg:text-[2.1rem]\">\r","+          ALS drug discovery optimization\r","+        </p>\r","+        <button\r","+          type=\"button\"\r","+          onClick={onSignIn}\r","+          disabled={!configured || busy}\r","+          aria-busy={busy}\r","+          className=\"pointer-events-auto mt-6 flex cursor-pointer items-center gap-2.5 rounded-full bg-foreground py-2.5 pr-5 pl-2.5 text-sm text-background shadow-[0_6px_20px_-8px_rgb(19_41_61/0.6)] transition-[transform,background-color] duration-200 ease-out hover:bg-foreground/90 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-60\"\r","+        >\r","+          <span className=\"grid size-7 place-items-center rounded-full bg-background\">\r","+            <GoogleIcon />\r","+          </span>\r","+          {busy ? 'Connecting…' : 'Sign in with Google'}\r","+        </button>\r","+        {error ? <p className=\"mt-3 text-xs text-foreground/70\" role=\"alert\">{error}</p> : null}\r","+        {!configured ? <p className=\"mt-3 text-xs text-foreground/60\">Add Supabase keys to .env to enable sign-in.</p> : null}\r","+      </main>\r","+\r","+      {/* CC BY 4.0 attribution for the neuron model (public/models/neuron.LICENSE.txt). */}\r","+      <p className=\"absolute bottom-4 left-5 z-10 text-[11px] text-foreground/45 [&_a]:underline [&_a]:decoration-foreground/25 [&_a]:underline-offset-2 [&_a:hover]:text-foreground/80\">\r","+        <a href=\"https://sketchfab.com/3d-models/neuron-cell-low-poly-simple-3a09438daf364c3bbd3cce76f1c7afaa\" target=\"_blank\" rel=\"noreferrer\">Neuron Cell Low-poly Simple</a>\r","+        {' by '}\r","+        <a href=\"https://sketchfab.com/vitalik.kucha\" target=\"_blank\" rel=\"noreferrer\">vitalik.kucha</a>\r","+        {' · '}\r","+        <a href=\"http://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noreferrer\">CC BY 4.0</a>\r","+      </p>\r","+    </div>\r","+  )\r","+}"]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\neuron-viewer.tsx","C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\pages\\Landing.tsx"]}},"serverClassifierContext":{"request":"b3267a1d-360f-4d2e-b2ea-1c0c1b189724","context":{"git_state":{"cwd":"/c/Users/jerem/BioHacks-2026/frontend","root":"/c/Users/jerem/BioHacks-2026","branch":"frontend/diagnosis","defau