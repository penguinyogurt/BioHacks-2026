t: 'text-foreground' }","-","-/** Page header shared by every pipeline page: eyebrow, title, run controls, progress rail. */","-export function StageHeader({ step, title, description, rail = true }: { step: string; title: string; description: string; rail?: boolean }) {","-  const { state, skip, reset } = useRun()","-  return (","-    <div className=\"space-y-3\">","-      <div className=\"rounded-xl bg-card px-5 pt-5 pb-4 ring-1 ring-border backdrop-blur-md\">","-        <div className=\"flex flex-wrap items-end justify-between gap-4\">","-          <div>","-            <p className=\"eyebrow\">Pipeline / {step}</p>","-            <h2 className=\"font-brand mt-3 text-[clamp(2rem,3.2vw,3rem)] leading-none\">{title}</h2>","-            <p className=\"mt-3 max-w-2xl text-muted-foreground\">{description}</p>","-          </div>","-          <div className=\"flex items-center gap-2\">","-            <Badge variant=\"outline\" className=\"border-watch/40 bg-watch/10 font-normal text-watch\">Simulated run</Badge>","-            {state.phase === 'running' ? (","-              <Button size=\"sm\" variant=\"outline\" onClick={skip}>","-                <FastForward aria-hidden /> Skip to results","-              </Button>","-            ) : state.phase === 'done' ? (","-              <Button size=\"sm\" variant=\"outline\" onClick={reset}>","-                <RotateCcw aria-hidden /> Clear run","-              </Button>","-            ) : null}","-          </div>","-        </div>","-      </div>","-      {rail ? <PipelineRail /> : null}","-    </div>","-  )","-}","-","-export function PipelineRail() {","-  const { state } = useRun()","-  return (","-    <ol className=\"grid grid-cols-5 gap-2\" aria-label=\"Pipeline progress\">","-      {STAGES.map((s, i) => {","-        const st = state.stages[s.id]","-        return (","-          <li","-            key={s.id}","-            className={cn(","-              'rounded-lg border bg-card px-3 py-2 backdrop-blur-md transition-colors',","-              st === 'running' && 'border-[#c9732a]/60',","-              st === 'done' && 'border-foreground/25',","-            )}","-          >","-            <div className=\"flex items-center gap-2 text-xs text-muted-foreground\">","-              <span className=\"tabular-nums\">{String(i + 1).padStart(2, '0')}</span>","-              <StatusIcon status={st} />","-              <span className=\"truncate text-foreground\">{s.label}</span>","-            </div>","-            {s.id === 'profiles' ? (","-              <div className=\"mt-1.5 flex gap-1\" aria-hidden>","-                {LANE_COLORS.map((c, l) => (","-                  <span key={c} className=\"h-1 flex-1 rounded-full\" style={{ background: c, opacity: l < state.profiles.length ? 1 : st === 'running' ? 0.35 : 0.2 }} />","-                ))}","-              </div>","-            ) : null}","-          </li>","-        )","-      })}","-    </ol>","-  )","-}","-","-export function StatusIcon({ status }: { status: 'pending' | 'running' | 'done' }) {","-  if (status === 'done') return <Check className=\"size-3.5 shrink-0 text-foreground\" aria-label=\"done\" />","-  if (status === 'running') return <Loader2 className=\"size-3.5 shrink-0 animate-spin text-[#c9732a]\" aria-label=\"running\" />","-  return <Circle className=\"size-3 shrink-0 opacity-40\" aria-label=\"pending\" />","-}","-","-/** Shown on a stage page before its stage has started. */","-export function EmptyStage({ after, onGo }: { after: string; onGo: () => void }) {","-  const { state } = useRun()","-  return (","-    <Card className=\"items-start gap-3 [--card-spacing:--spacing(8)]\">","-      <CardContent className=\"space-y-3\">","-        <p className=\"eyebrow\">Not started</p>","-        <p className=\"max-w-lg text-muted-foreground\">","-          {state.phase === 'idle' ? 'Start a run from the patient case. ' : ''}This step runs after {after}.","-        </p>","-        {state.phase === 'idle' ? <Button onClick={on