{"parentUuid":"9cae9c83-1c36-401f-9976-3ab60b1af3ac","isSidechain":false,"promptId":"49e38bf9-70c2-46f3-9a2e-7c8492331aa8","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015iN6eB1EmzqdUQcSDhAyGY","type":"tool_result","content":"1\timport { Suspense, useEffect, useMemo, useRef, useState } from 'react'\n2\timport { Canvas, useFrame, useLoader, useThree } from '@react-three/fiber'\n3\timport * as THREE from 'three'\n4\timport { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js'\n5\timport { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js'\n6\t\n7\t/**\n8\t * The neuron, standing upright, spinning about its long axis and firing every\n9\t * few seconds: inputs converge, the soma sparks, an amber pulse runs down\n10\t * the axon, and the terminals release a puff of transmitter.\n11\t * Model: \"Neuron Cell Low-poly Simple\" by vitalik.kucha, CC BY 4.0\n12\t * (public/models/neuron.LICENSE.txt).\n13\t */\n14\t\n15\tconst MODEL_URL = '/models/neuron.glb'\n16\tconst MODEL_SIZE = 11 // long axis, world units: whole cell in frame\n17\tconst COLOR = '#2f5f6b' // teal ink\n18\tconst PULSE = '#f2852f' // warm amber spark against the teal membrane\n19\tconst OPACITY = 0.55\n20\tconst AUTO_ROTATE_SPEED = 2.2\n21\tconst SLANT_DEG = -10 // adds to the model's own lean: top-left to bottom-right\n22\t\n23\t/*\n24\t * Landmarks in the model's own mesh coordinates (long axis = x), measured from\n25\t * its vertices: soma centre, where the axon leaves it, where the terminals begin.\n26\t */\n27\tconst SOMA = new THREE.Vector3(-1.0, 0.0, 0.2)\n28\tconst HILLOCK_X = -0.3\n29\tconst AXON_END = new THREE.Vector3(1.35, 0.1, 0.1)\n30\tconst TIP_X = 2.45\n31\t\n32\t/* One firing, in seconds from its start. */\n33\tconst INPUT_S = 0.45 // dendritic inputs converge on the soma\n34\tconst AP_SPEED = 2.6 // mesh units / s down the axon\n35\tconst BURST = 10 // particles per terminal\n36\t\n37\tconst pulseVert = /* glsl */ `\n38\tvarying vec3 vPos;`\n39\tconst pulseFrag = /* glsl */ `\n40\tvarying vec3 vPos;\n41\tuniform vec3 uPulse;\n42\tuniform vec3 uSomaC;\n43\tuniform float uFront;\n44\tuniform float uInward;\n45\tuniform float uSoma;`\n46\tconst pulseApply = /* glsl */ `\n47\t  float pulseK;\n48\t  {\n49\t    float axon = step(${HILLOCK_X.toFixed(2)}, vPos.x);\n50\t    // Action potential: a crisp head with a fading tail behind it, so direction reads at a glance.\n51\t    float dA = vPos.x - uFront;\n52\t    float head = exp(-dA * dA * 90.0);\n53\t    float tail = dA < 0.0 ? exp(dA * 5.0) * 0.35 : 0.0;\n54\t    float wave = (head + tail) * axon;\n55\t    // Synaptic input: a soft ring closing in on the soma.\n56\t    float r = length(vPos - uSomaC);\n57\t    float dI = r - uInward;\n58\t    float inward = exp(-dI * dI * 40.0) * (1.0 - axon) * step(0.0, uInward);\n59\t    float soma = uSoma * (1.0 - smoothstep(0.2, 0.55, r));\n60\t    pulseK = clamp(wave + inward * 0.18 + soma * 0.4, 0.0, 1.0);\n61\t    diffuseColor.rgb = mix(diffuseColor.rgb, uPulse, pulseK * 0.55);\n62\t    diffuseColor.a = mix(diffuseColor.a, 1.0, pulseK);\n63\t  }`\n64\t// Added as unlit light so the lighting can't grey the spark out.\n65\tconst pulseEmissive = /* glsl */ `\n66\t  totalEmissiveRadiance += uPulse * pulseK * 0.75;`\n67\t\n68\tconst particleVS = /* glsl */ `\n69\tattribute float aLife;\n70\tuniform float uSize;\n71\tvarying float vLife;\n72\tvoid main() {\n73\t  vLife = aLife;\n74\t  gl_PointSize = uSize * (0.6 + 0.4 * aLife);\n75\t  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n76\t}`\n77\tconst particleFS = /* glsl */ `\n78\tuniform vec3 uColor;\n79\tvarying float vLife;\n80\tvoid main() {\n81\t  float d = length(gl_PointCoord - 0.5);\n82\t  if (d > 0.5) discard;\n83\t  gl_FragColor = vec4(uColor, vLife * 0.9 * (1.0 - smoothstep(0.25, 0.5, d)));\n84\t}`\n85\t\n86\t/** Terminal tips: farthest-point sample of the vertices past the axon. */\n87\tfunction terminalTips(geo: THREE.BufferGeometry, n: number) {\n88\t  const pos = geo.attributes.position as THREE.BufferAttribute\n89\t  const pts: THREE.Vector3[] = []\n90\t  for (let i = 0; i < pos.count; i++) {\n91\t    const v = new THREE.Vector3().fromBufferAttribute(pos, i)\n92\t    if (v.x > 1.75) pts.push(v)\n93\t  }\n94\t  if (!pts.length) return []\n95\t  const picked = [pts.reduce((a, b) => (b.x > a.x ? b : a))]\n96\t  const best = pts.map((p) => p.distanceToSquared(picked[0]))\n97\t  while (picked.length < Math.min(n, pts.length)) {\n98\t    let k = 0\n99\t    for (let i = 1; i < best.length; i++) if (best[i] > best[k]) k = i\n100\t    picked.push(pts[k])\n101\t    for (let i = 0; i < pts.length; i++) best[i] = Math.min(best[i], pts[i].distanceToSquared(pts[k]))\n102\t  }\n103\t  return picked\n104\t}\n105\t\n106\tfunction Neuron({ onLoaded, firing }: { onLoaded: () => void; firing: boolean }) {\n107\t  const gltf = useLoader(GLTFLoader, MODEL_URL)\n108\t  const dpr = useThree((s) => s.viewport.dpr)\n109\t\n110\t  const { model, center, scale } = useMemo(() => {\n111\t    const model = gltf.scene.clone(true)\n112\t    model.updateMatrixWorld(true)\n113\t    const box = new THREE.Box3().setFromObject(model)\n114\t    const size = box.getSize(new THREE.Vector3())\n115\t    return { model, center: box.getCenter(new THREE.Vector3()), scale: MODEL_SIZE / (Math.max(size.x, size.y, size.z) || 1) }\n116\t  }, [gltf])\n117\t\n118\t  /** Shared by every membrane material; driven from useFrame. */\n119\t  const uniforms = useMemo(\n120\t    () => ({\n121\t      uPulse: { value: new THREE.Color(PULSE) },\n122\t      uSomaC: { value: SOMA.clone() },\n123\t      uFront: { value: -10 },\n124\t      uInward: { value: -1 },\n125\t      uSoma: { value: 0 },\n126\t    }),\n127\t    [],\n128\t  )\n129\t\n130\t  const sparks = useMemo(() => {\n131\t    let mesh: THREE.Mesh | undefined\n132\t    model.traverse((n) => {\n133\t      if (!mesh && (n as THREE.Mesh).isMesh) mesh = n as THREE.Mesh\n134\t    })\n135\t    const tips = mesh ? terminalTips(mesh.geometry, 8) : []\n136\t    const count = Math.max(1, tips.length * BURST)\n137\t    const geo = new THREE.BufferGeometry()\n138\t    const pos = new Float32Array(count * 3)\n139\t    const life = new Float32Array(count)\n140\t    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3))\n141\t    geo.setAttribute('aLife', new THREE.BufferAttribute(life, 1))\n142\t    const mat = new THREE.ShaderMaterial({\n143\t      vertexShader: particleVS,\n144\t      fragmentShader: particleFS,\n145\t      uniforms: { uColor: { value: new THREE.Color(PULSE) }, uSize: { value: 5 } },\n146\t      transparent: true,\n147\t      depthWrite: false,\n148\t    })\n149\t    const points = new THREE.Points(geo, mat)\n150\t    points.frustumCulled = false\n151\t    mesh?.add(points) // lives in mesh space, so it turns with the neuron\n152\t    return { tips, points, pos, life, vel: new Float32Array(count * 3) }\n153\t  }, [model])\n154\t\n155\t  useEffect(() => {\n156\t    model.traverse((node) => {\n157\t      const mesh = node as THREE.Mesh\n158\t      if (!mesh.isMesh) return\n159\t      mesh.frustumCulled = false\n160\t      const mats = (Array.isArray(mesh.material) ? mesh.material : [mesh.material]).map((src) => {\n161\t        const m = src.clone() as THREE.MeshStandardMaterial\n162\t        m.color.set(COLOR)\n163\t        m.transparent = true\n164\t        m.opacity = OPACITY\n165\t        m.depthWrite = false\n166\t        m.onBeforeCompile = (shader) => {\n167\t          Object.assign(shader.uniforms, uniforms)\n168\t          shader.vertexShader = shader.vertexShader\n169\t            .replace('#include <common>', `#include <common>${pulseVert}`)\n170\t            .replace('#include <begin_vertex>', '#include <begin_vertex>\\n  vPos = position;')\n171\t          shader.fragmentShader = shader.fragmentShader\n172\t            .replace('#include <common>', `#include <common>${pulseFrag}`)\n173\t            .replace('#include <color_fragment>', `#include <color_fragment>${pulseApply}`)\n174\t            .replace('#include <emissivemap_fragment>', `#include <emissivemap_fragment>${pulseEmissive}`)\n175\t        }\n176\t        m.customProgramCacheKey = () => 'addo-pulse'\n177\t        return m\n178\t      })\n179\t      mesh.material = Array.isArray(mesh.material) ? mats : mats[0]\n180\t    })\n181\t    onLoaded()\n182\t    return () => {\n183\t      sparks.points.geometry.dispose()\n184\t      ;(sparks.points.material as THREE.Material).dispose()\n185\t      sparks.points.removeFromParent()\n186\t    }\n187\t  }, [model, onLoaded, uniforms, sparks])\n188\t\n189\t  // Firing loop: inputs converge → soma darkens → action potential runs to the terminals → release.\n190\t  const clock = useRef({ t: -1.2, next: 2.8, prevFront: -10 })\n191\t  useFrame((_, delta) => {\n192\t    sparks.points.material.uniforms.uSize.value = 5 * dpr\n193\t    const c = clock.current\n194\t    const dt = Math.min(delta, 0.05)\n195\t    if (firing) {\n196\t      c.t += dt\n197\t      if (c.t > c.next) {\n198\t        c.t = 0\n199\t        c.next = 2.6 + Math.random() * 1.2\n200\t      }\n201\t    }\n202\t    const t = c.t\n203\t    uniforms.uInward.value = t >= 0 && t < INPUT_S ? 1.6 - (1.05 * t) / INPUT_S : -1\n204\t    uniforms.uSoma.value = t >= 0 ? Math.exp(-(((t - INPUT_S) / 0.2) ** 2)) : 0\n205\t    const front = t >= INPUT_S ? HILLOCK_X + (t - INPUT_S) * AP_SPEED : -10\n206\t    uniforms.uFront.value = front < TIP_X + 0.3 ? front : -10\n207\t\n208\t    // Release at each terminal as the front reaches it.\n209\t    const { tips, pos, life, vel, points } = sparks\n210\t    tips.forEach((tip, j) => {\n211\t      if (c.prevFront < tip.x && front >= tip.x) {\n212\t        const dir = tip.clone().sub(AXON_END).normalize()\n213\t        for (let k = 0; k < BURST; k++) {\n214\t          const i = j * BURST + k\n215\t          pos[i * 3] = tip.x\n216\t          pos[i * 3 + 1] = tip.y\n217\t          pos[i * 3 + 2] = tip.z\n218\t          const sp = 0.12 + Math.random() * 0.2\n219\t          vel[i * 3] = (dir.x * 0.8 + (Math.random() - 0.5)) * sp\n220\t          vel[i * 3 + 1] = (dir.y * 0.8 + (Math.random() - 0.5)) * sp\n221\t          vel[i * 3 + 2] = (dir.z * 0.8 + (Math.random() - 0.5)) * sp\n222\t          life[i] = 1\n223\t        }\n224\t      }\n225\t    })\n226\t    c.prevFront = front\n227\t    for (let i = 0; i < life.length; i++) {\n228\t      if (life[i] <= 0) continue\n229\t      life[i] = Math.max(0, life[i] - dt / 1.1)\n230\t      pos[i * 3] += vel[i * 3] * dt\n231\t      pos[i * 3 + 1] += vel[i * 3 + 1] * dt\n232\t      pos[i * 3 + 2] += vel[i * 3 + 2] * dt\n233\t    }\n234\t    points.geometry.attributes.position.needsUpdate = true\n235\t    points.geometry.attributes.aLife.needsUpdate = true\n236\t  })\n237\t\n238\t  // The model's long axis is x; turn it 90° so it stands vertically (dendrites up, axon down).\n239\t  return (\n240\t    <group scale={scale} rotation={[0, 0, -Math.PI / 2]}>\n241\t      <group position={[-center.x, -center.y, -center.z]}>\n242\t        <primitive object={model} />\n243\t      </group>\n244\t    </group>\n245\t  )\n246\t}\n247\t\n248\t/** Spin about the vertical axis only: auto-rotate, and drag left/right to turn it. */\n249\tfunction Controls({ autoRotate }: { autoRotate: boolean }) {\n250\t  const { camera, gl } = useThree()\n251\t  const controls = useMemo(() => new OrbitControls(camera, gl.domElement), [camera, gl])\n252\t  useEffect(() => {\n253\t    controls.autoRotate = autoRotate\n254\t    controls.autoRotateSpeed = AUTO_ROTATE_SPEED\n255\t    controls.enableZoom = false\n256\t    controls.enablePan = false\n257\t    controls.enableDamping = true\n258\t    controls.minPolarAngle = Math.PI / 2\n259\t    controls.maxPolarAngle = Math.PI / 2\n260\t    return () => controls.dispose()\n261\t  }, [controls, autoRotate])\n262\t  useFrame(() => controls.update())\n263\t  return null\n264\t}\n265\t\n266\texport default function NeuronViewer({ reducedMotion = false, className = '' }: { reducedMotion?: boolean; className?: string }) {\n267\t  const [loaded, setLoaded] = useState(false)\n268\t  const onLoaded = useMemo(() => () => setLoaded(true), [])\n269\t  return (\n270\t    <div\n271\t      className={`transition-opacity duration-700 ease-out motion-reduce:transition-none ${loaded ? 'opacity-100' : 'opacity-0'} ${className}`}\n272\t      style={{ cursor: 'grab' }}\n273\t    >\n274\t      {/* Slanted frame: the spin axis tilts with it, so the cell still turns about its own length. */}\n275\t      <div className=\"absolute -inset-[12%]\" style={{ transform: `rotate(${SLANT_DEG}deg)` }}>\n276\t      <Canvas\n277\t        camera={{ position: [0, 0, 12], fov: 65 }}\n278\t        dpr={[1, 2]}\n279\t        gl={{ alpha: true, antialias: true }}\n280\t        // Size from layout, not the rotated bounding box, so the scene stays centred.\n281\t        resize={{ offsetSize: true }}\n282\t      >\n283\t        <ambientLight intensity={2} />\n284\t        <directionalLight position={[8, 8, 6]} intensity={3} />\n285\t        <directionalLight position={[-8, 6, 4]} intensity={2} />\n286\t        <directionalLight position={[0, -10, 2]} intensity={1.5} />\n287\t        <pointLight position={[0, 0, 8]} intensity={2} />\n288\t        <Controls autoRotate={!reducedMotion} />\n289\t        <Suspense fallback={null}>\n290\t          <Neuron onLoaded={onLoaded} firing={!reducedMotion} />\n291\t        </Suspense>\n292\t      </Canvas>\n293\t      </div>\n294\t    </div>\n295\t  )\n296\t}\n297\t"}]},"uuid":"edbfdb1a-c458-4944-ab8d-6de11216956e","timestamp":"2026-11-08T04:56:36.495Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\neuron-viewer.tsx","content":"import { Suspense, useEffect, useMemo, useRef, useState } from 'react'\nimport { Canvas, useFrame, useLoader, useThree } from '@react-three/fiber'\nimport * as THREE from 'three'\nimport { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js'\nimport { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js'\n\n/**\n * The neuron, standing upright, spinning about its long axis and firing every\n * few seconds: inputs converge, the soma sparks, an amber pulse runs down\n * the axon, and the terminals release a puff of transmitter.\n * Model: \"Neuron Cell Low-poly Simple\" by vitalik.kucha, CC BY 4.0\n * (public/models/neuron.LICENSE.txt).\n */\n\nconst MODEL_URL = '/models/neuron.glb'\nconst MODEL_SIZE = 11 // long axis, world units: whole cell in frame\nconst COLOR = '#2f5f6b' // teal ink\nconst PULSE = '#f2852f' // warm amber spark against the teal membrane\nconst OPACITY = 0.55\nconst AUTO_ROTATE_SPEED = 2.2\nconst SLANT_DEG = -10 // adds to the model's own lean: top-left to bottom-right\n\n/*\n * Landmarks in the model's own mesh coordinates (long axis = x), measured from\n * its vertices: soma centre, where the axon leaves it, where the terminals begin.\n */\nconst SOMA = new THREE.Vector3(-1.0, 0.0, 0.2)\nconst HILLOCK_X = -0.3\nconst AXON_END = new THREE.Vector3(1.35, 0.1, 0.1)\nconst TIP_X = 2.45\n\n/* One firing, in seconds from its start. */\nconst INPUT_S = 0.45 // dendritic inputs converge on the soma\nconst AP_SPEED = 2.6 // mesh units / s down the axon\nconst BURST = 10 // particles per terminal\n\nconst pulseVert = /* glsl */ `\nvarying vec3 vPos;`\nconst pulseFrag = /* glsl */ `\nvarying vec3 vPos;\nuniform vec3 uPulse;\nuniform vec3 uSomaC;\nuniform float uFront;\nuniform float uInward;\nuniform float uSoma;`\nconst pulseApply = /* glsl */ `\n  float pulseK;\n  {\n    float axon = step(${HILLOCK_X.toFixed(2)}, vPos.x);\n    // Action potential: a crisp head with a fading tail behind it, so direction reads at a glance.\n    float dA = vPos.x - uFront;\n    float head = exp(-dA * dA * 90.0);\n    float tail = dA < 0.0 ? exp(dA * 5.0) * 0.35 : 0.0;\n    float wave = (head + tail) * axon;\n    // Synaptic input: a soft ring closing in on the soma.\n    float r = length(vPos - uSomaC);\n    float dI = r - uInward;\n    float inward = exp(-dI * dI * 40.0) * (1.0 - axon) * step(0.0, uInward);\n    float soma = uSoma * (1.0 - smoothstep(0.2, 0.55, r));\n    pulseK = clamp(wave + inward * 0.18 + soma * 0.4, 0.0, 1.0);\n    diffuseColor.rgb = mix(diffuseColor.rgb, uPulse, pulseK * 0.55);\n    diffuseColor.a = mix(diffuseColor.a, 1.0, pulseK);\n  }`\n// Added as unlit light so the lighting can't grey the spark out.\nconst pulseEmissive = /* glsl */ `\n  totalEmissiveRadiance += uPulse * pulseK * 0.75;`\n\nconst particleVS = /* glsl */ `\nattribute float aLife;\nuniform float uSize;\nvarying float vLife;\nvoid main() {\n  vLife = aLife;\n  gl_PointSize = uSize * (0.6 + 0.4 * aLife);\n  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n}`\nconst particleFS = /* glsl */ `\nuniform vec3 uColor;\nvarying float vLife;\nvoid main() {\n  float d = length(gl_PointCoord - 0.5);\n  if (d > 0.5) discard;\n  gl_FragColor = vec4(uColor, vLife * 0.9 * (1.0 - smoothstep(0.25, 0.5, d)));\n}`\n\n/** Terminal tips: farthest-point sample of the vertices past the axon. */\nfunction terminalTips(geo: THREE.BufferGeometry, n: number) {\n  const pos = geo.attributes.position as THREE.BufferAttribute\n  const pts: THREE.Vector3[] = []\n  for (let i = 0; i < pos.count; i++) {\n    const v = new THREE.Vector3().fromBufferAttribute(pos, i)\n    if (v.x > 1.75) pts.push(v)\n  }\n  if (!pts.length) return []\n  const picked = [pts.reduce((a, b) => (b.x > a.x ? b : a))]\n  const best = pts.map((p) => p.distanceToSquared(picked[0]))\n  while (picked.length < Math.min(n, pts.length)) {\n    let k = 0\n    for (let i = 1; i < best.length; i++) if (best[i] > best[k]) k = i\n    picked.push(pts[k])\n    for (let i = 0; i < pts.length; i++) best[i] = Math.min(best[i], pts[i].distanceToSquared(pts[k]))\n  }\n  return picked\n}\n\nfunction Neuron({ onLoaded, firing }: { onLoaded: () => void; firing: boolean }) {\n  const gltf = useLoader(GLTFLoader, MODEL_URL)\n  const dpr = useThree((s) => s.viewport.dpr)\n\n  const { model, center, scale } = useMemo(() => {\n    const model = gltf.scene.clone(true)\n    model.updateMatrixWorld(true)\n    const box = new THREE.Box3().setFromObject(model)\n    const size = box.getSize(new THREE.Vector3())\n    return { model, center: box.getCenter(new THREE.Vector3()), scale: MODEL_SIZE / (Math.max(size.x, size.y, size.z) || 1) }\n  }, [gltf])\n\n  /** Shared by every membrane material; driven from useFrame. */\n  const uniforms = useMemo(\n    () => ({\n      uPulse: { value: new THREE.Color(PULSE) },\n      uSomaC: { value: SOMA.clone() },\n      uFront: { value: -10 },\n      uInward: { value: -1 },\n      uSoma: { value: 0 },\n    }),\n    [],\n  )\n\n  const sparks = useMemo(() => {\n    let mesh: THREE.Mesh | undefined\n    model.traverse((n) => {\n      if (!mesh && (n as THREE.Mesh).isMesh) mesh = n as THREE.Mesh\n    })\n    const tips = mesh ? terminalTips(mesh.geometry, 8) : []\n    const count = Math.max(1, tips.length * BURST)\n    const geo = new THREE.BufferGeometry()\n    const pos = new Float32Array(count * 3)\n    const life = new Float32Array(count)\n    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3))\n    geo.setAttribute('aLife', new THREE.BufferAttribute(life, 1))\n    const mat = new THREE.ShaderMaterial({\n      vertexShader: particleVS,\n      fragmentShader: particleFS,\n      uniforms: { uColor: { value: new THREE.Color(PULSE) }, uSize: { value: 5 } },\n      transparent: true,\n      depthWrite: false,\n    })\n    const points = new THREE.Points(geo, mat)\n    points.frustumCulled = false\n    mesh?.add(points) // lives in mesh space, so it turns with the neuron\n    return { tips, points, pos, life, vel: new Float32Array(count * 3) }\n  }, [model])\n\n  useEffect(() => {\n    model.traverse((node) => {\n      const mesh = node as THREE.Mesh\n      if (!mesh.isMesh) return\n      mesh.frustumCulled = false\n      const mats = (Array.isArray(mesh.material) ? mesh.material : [mesh.material]).map((src) => {\n        const m = src.clone() as THREE.MeshStandardMaterial\n        m.color.set(COLOR)\n        m.transparent = true\n        m.opacity = OPACITY\n        m.depthWrite = false\n        m.onBeforeCompile = (shader) => {\n          Object.assign(shader.uniforms, uniforms)\n          shader.vertexShader = shader.vertexShader\n            .replace('#include <common>', `#include <common>${pulseVert}`)\n            .replace('#include <begin_vertex>', '#include <begin_vertex>\\n  vPos = position;')\n          shader.fragmentShader = shader.fragmentShader\n            .replace('#include <common>', `#include <common>${pulseFrag}`)\n            .replace('#include <color_fragment>', `#include <color_fragment>${pulseApply}`)\n            .replace('#include <emissivemap_fragment>', `#include <emissivemap_fragment>${pulseEmissive}`)\n        }\n        m.customProgramCacheKey = () => 'addo-pulse'\n        return m\n      })\n      mesh.material = Array.isArray(mesh.material) ? mats : mats[0]\n    })\n    onLoaded()\n    return () => {\n      sparks.points.geometry.dispose()\n      ;(sparks.points.material as THREE.Material).dispose()\n      sparks.points.removeFromParent()\n    }\n  }, [model, onLoaded, uniforms, sparks])\n\n  // Firing loop: inputs converge → soma darkens → action potential runs to the terminals → release.\n  const clock = useRef({ t: -1.2, next: 2.8, prevFront: -10 })\n  useFrame((_, delta) => {\n    sparks.points.material.uniforms.uSize.value = 5 * dpr\n    const c = clock.current\n    const dt = Math.min(delta, 0.05)\n    if (firing) {\n      c.t += dt\n      if (c.t > c.next) {\n        c.t = 0\n        c.next = 2.6 + Math.random() * 1.2\n      }\n    }\n    const t = c.t\n    uniforms.uInward.value = t >= 0 && t < INPUT_S ? 1.6 - (1.05 * t) / INPUT_S : -1\n    uniforms.uSoma.value = t >= 0 ? Math.exp(-(((t - INPUT_S) / 0.2) ** 2)) : 0\n    const front = t >= INPUT_S ? HILLOCK_X + (t - INPUT_S) * AP_SPEED : -10\n    uniforms.uFront.value = front < TIP_X + 0.3 ? front : -10\n\n    // Release at each terminal as the front reaches it.\n    const { tips, pos, life, vel, points } = sparks\n    tips.forEach((tip, j) => {\n      if (c.prevFront < tip.x && front >= tip.x) {\n        const dir = tip.clone().sub(AXON_END).normalize()\n        for (let k = 0; k < BURST; k++) {\n          const i = j * BURST + k\n          pos[i * 3] = tip.x\n          pos[i * 3 + 1] = tip.y\n          pos[i * 3 + 2] = tip.z\n          const sp = 0.12 + Math.random() * 0.2\n          vel[i * 3] = (dir.x * 0.8 + (Math.random() - 0.5)) * sp\n          vel[i * 3 + 1] = (dir.y * 0.8 + (Math.random() - 0.5)) * sp\n          vel[i * 3 + 2] = (dir.z * 0.8 + (Math.random() - 0.5)) * sp\n          life[i] = 1\n        }\n      }\n    })\n    c.prevFront = front\n    for (let i = 0; i < life.length; i++) {\n      if (life[i] <= 0) continue\n      life[i] = Math.max(0, life[i] - dt / 1.1)\n      pos[i * 3] += vel[i * 3] * dt\n      pos[i * 3 + 1] += vel[i * 3 + 1] * dt\n      pos[i * 3 + 2] += vel[i * 3 + 2] * dt\n    }\n    points.geometry.attributes.position.needsUpdate = true\n    points.geometry.attributes.aLife.needsUpdate = true\n  })\n\n  // The model's long axis is x; turn it 90° so it stands vertically (dendrites up, axon down).\n  return (\n    <group scale={scale} rotation={[0, 0, -Math.PI / 2]}>\n      <group position={[-center.x, -center.y, -center.z]}>\n        <primitive object={model} />\n      </group>\n    </group>\n  )\n}\n\n/** Spin about the vertical axis only: auto-rotate, and drag left/right to turn it. */\nfunction Controls({ autoRotate }: { autoRotate: boolean }) {\n  const { camera, gl } = useThree()\n  const controls = useMemo(() => new OrbitControls(camera, gl.domElement), [camera, gl])\n  useEffect(() => {\n    controls.autoRotate = autoRotate\n    controls.autoRotateSpeed = AUTO_ROTATE_SPEED\n    controls.enableZoom = false\n    controls.enablePan = false\n    controls.enableDamping = true\n    controls.minPolarAngle = Math.PI / 2\n    controls.maxPolarAngle = Math.PI / 2\n    return () => controls.dispose()\n  }, [controls, autoRotate])\n  useFrame(() => controls.update())\n  return null\n}\n\nexport default function NeuronViewer({ reducedMotion = false, className = '' }: { reducedMotion?: boolean; className?: string }) {\n  const [loaded, setLoaded] = useState(false)\n  const onLoaded = useMemo(() => () => setLoaded(true), [])\n  return (\n    <div\n      className={`transition-opacity duration-700 ease-out motion-reduce:transition-none ${loaded ? 'opacity-100' : 'opacity-0'} ${className}`}\n      style={{ cursor: 'grab' }}\n    >\n      {/* Slanted frame: the spin axis tilts with it, so the cell still turns about its own length. */}\n      <div className=\"absolute -inset-[12%]\" style={{ transform: `rotate(${SLANT_DEG}deg)` }}>\n      <Canvas\n        camera={{ position: [0, 0, 12], fov: 65 }}\n        dpr={[1, 2]}\n        gl={{ alpha: true, antialias: true }}\n        // Size from layout, not the rotated bounding box, so the scene stays centred.\n        resize={{ offsetSize: true }}\n      >\n        <ambientLight intensity={2} />\n        <directionalLight position={[8, 8, 6]} intensity={3} />\n        <directionalLight position={[-8, 6, 4]} intensity={2} />\n        <directionalLight position={[0, -10, 2]} intensity={1.5} />\n        <pointLight position={[0, 0, 8]} intensity={2} />\n        <Controls autoRotate={!reducedMotion} />\n        <Suspense fallback={null}>\n          <Neuron onLoaded={onLoaded} firing={!reducedMotion} />\n        </Suspense>\n      </Canvas>\n      </div>\n    </div>\n  )\n}\n","numLines":297,"startLine":1,"totalLines":297}},"sourceToolAssistantUUID":"9cae9c83-1c36-401f-9976-3ab60b1af3ac","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"28437234-f1be-440d-9452-c51de1bd38ab","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\jerem\\BioHacks-2026","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","version":"2.1.319","gitBranch":"frontend/diagnosis"}
