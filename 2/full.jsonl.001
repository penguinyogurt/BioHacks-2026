me=\"mt-2 flex flex-col gap-1.5 px-3\">\r","-                    {[90, 70, 82, 55, 75].map((w, i) => (\r","-                      <div key={i} className=\"h-1 rounded-full bg-foreground/[0.07]\" style={{ width: `${w}%` }} />\r","-                    ))}\r","-                  </div>\r","-                </div>\r","-                <div className=\"border-t px-3 py-2.5\">\r","-                  <p className=\"flex items-center gap-1.5 text-sm font-medium\">\r","-                    <FileText className=\"size-3.5 text-muted-foreground\" aria-hidden /> Top: {top.drug}\r","-                  </p>\r","-                  <p className=\"truncate text-xs text-muted-foreground\">{r.caseName ?? 'Sample case'} · {r.date}</p>\r","-                </div>\r","-              </button>\r","-            )\r","-          })}\r","-        </div>\r","-      )}\r","-    </div>\r","-  )\r","-}\r","+import { useState } from 'react'","+import { ArrowLeft, FileText } from 'lucide-react'","+import { Button } from '@/components/ui/button'","+import { SAMPLE_PATIENT, rank, CANDIDATES } from '@/lib/pipeline'","+import { Report } from './report'","+import { useRun, type CompletedRun } from '@/lib/run-store'","+","+/** Saved runs as paper previews (Callio Labs' Projects panel, for reports). */","+export default function Runs({ onNewRun }: { onNewRun: () => void }) {","+  const { runs } = useRun()","+  const [open, setOpen] = useState<CompletedRun | null>(null)","+","+  if (open) {","+    return (","+      <div className=\"mx-auto max-w-4xl\">","+        <Button size=\"sm\" variant=\"ghost\" className=\"mb-3\" onClick={() => setOpen(null)}>","+          <ArrowLeft aria-hidden /> All runs","+        </Button>","+        <div className=\"rounded-xl bg-card p-6 ring-1 ring-border backdrop-blur-md\">","+          <Report patient={SAMPLE_PATIENT} weights={open.weights} date={open.date} caseName={open.caseName} />","+        </div>","+      </div>","+    )","+  }","+","+  return (","+    <div className=\"mx-auto max-w-[1440px]\">","+      <div className=\"mb-4 rounded-xl bg-card px-5 pt-5 pb-4 ring-1 ring-border backdrop-blur-md\">","+        <p className=\"eyebrow\">Library / Runs & reports</p>","+        <h2 className=\"font-brand mt-3 text-[clamp(2.25rem,3.6vw,3.25rem)] leading-none\">Every run, with its evidence.</h2>","+      </div>","+      {runs.length === 0 ? (","+        <div className=\"rounded-xl bg-card p-8 ring-1 ring-border backdrop-blur-md\">","+          <p className=\"text-muted-foreground\">No runs yet in this session.</p>","+          <Button className=\"mt-4\" onClick={onNewRun}>Start a discovery run</Button>","+        </div>","+      ) : (","+        <div className=\"grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5\">","+          {runs.map((r) => {","+            const top = rank(CANDIDATES, r.weights)[0]","+            return (","+              <button","+                key={r.id}","+                type=\"button\"","+                onClick={() => setOpen(r)}","+                className=\"group overflow-hidden rounded-xl bg-card text-left ring-1 ring-border backdrop-blur-md transition-transform duration-200 ease-out hover:-translate-y-0.5 active:scale-[0.98]\"","+              >","+                <div className=\"relative mx-3 mt-3 h-36 overflow-hidden rounded-t-md bg-white shadow-[0_-4px_12px_rgb(0_0_0/0.06)]\">","+                  <div className=\"absolute top-0 right-0 size-5\" style={{ background: 'linear-gradient(225deg, #e7e2d8 50%, #f6f3ed 50%)' }} />","+                  <p className=\"px-3 pt-3 text-[11px] leading-snug font-semibold text-foreground/80\">","+                    Alternative therapeutic candidates for {SAMPLE_PATIENT.label}","+                  </p>","+                  <div className=\"mt-2 flex flex-col gap-1.5 px-3\">","+                    {[90, 70, 82, 55, 75].map((w, i) => (","+                      <div key={i} className=\"h-1 rounded-full bg-foreground/[0.07]\" style={{ width: `${w}%` }} />","+                    ))}","+                  </div>","+                </div>","+                <div className=\"border-t px-3 py-2.5\">","+                  <p className=\"flex items-center gap-1.5 text-sm font-medium\">","+                    <FileText className=\"size-3.5 text-muted-foreground\" aria-hidden /> Top: {top.drug}","+                  </p>","+                  <p className=\"truncate text-xs text-muted-foreground\">{r.caseName ?? 'Sample case'} · {r.date}</p>","+                </div>","+              </button>","+            )","+          })}","+        </div>","+      )}","+    </div>","+  )","+}"]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\discovery\\runs.tsx"]}},"serverClassifierContext":{"request":"2deb58c1-b882-4804-8c35-b567bfce2753","context":{"git_state":{"cwd":"/c/Users/jerem/BioHacks-2026/frontend","root":"/c/Users/jerem/BioHacks-2026","branch":"frontend/diagnosis","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":9,"untracked":null,"untracked_normal":4},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"penguinyogurt/BioHacks-2026","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"penguinyogurt/BioHacks-2026","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"penguinyogurt/BioHacks-2026","visibility":"public"}]}},"live_cwd":"/c/Users/jerem/BioHacks-2026/frontend","platform":"windows"}},"sandboxed":false,"sourceToolAssistantUUID":"203e3113-865c-4a28-af09-501881dbb044","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"28437234-f1be-440d-9452-c51de1bd38ab","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\jerem\\BioHacks-2026\\frontend","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","version":"2.1.319","gitBranch":"frontend/diagnosis"}
