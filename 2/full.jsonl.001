scription=\"Add the patient’s case file. The analysis agent reads it first; every later step — profiles, matching, ranking — is shaped by it.\"\n      />\n      <div className=\"grid gap-3 lg:grid-cols-12\">\n        <div className=\"space-y-3 lg:col-span-6\">\n          <CaseUpload />\n          <PatientCard\n            footer={\n              <p className=\"mt-4 border-t pt-3 text-xs text-muted-foreground\">\n                {caseFile\n                  ? 'Simulated run: this structured profile is the built-in sample. The live analysis agent extracts it from the case PDF.'\n                  : 'No case PDF yet — the run will use this built-in sample patient.'}\n              </p>\n            }\n          />\n        </div>\n        <Card className=\"gap-4 self-start [--card-spacing:--spacing(5)] lg:col-span-6\">\n          <CardHeader>\n            <CardTitle className=\"text-lg font-normal\">Research goal</CardTitle>\n          </CardHeader>\n          <CardContent className=\"space-y-5\">\n            <Textarea value={goal} onChange={(e) => setGoal(e.target.value)} rows={4} className=\"bg-background/70 text-sm\" aria-label=\"Research goal\" />\n            <div>\n              <p className=\"mb-2 text-xs text-muted-foreground\">Weigh candidates by</p>\n              <div className=\"grid gap-2 sm:grid-cols-2\">\n                {CRITERIA.map((c) => (\n                  <label key={c.key} className=\"flex items-start gap-3 rounded-lg border bg-background/50 px-3 py-2.5\">\n                    <Switch className=\"mt-0.5\" checked={weights[c.key]} onCheckedChange={(v) => setWeights({ ...weights, [c.key]: v })} />\n                    <span>\n                      <span className=\"block text-sm\">{c.label}</span>\n                      <span className=\"block text-xs text-muted-foreground\">{c.hint}</span>\n                    </span>\n                  </label>\n                ))}\n              </div>\n            </div>\n            <div className=\"flex flex