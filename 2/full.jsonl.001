                <p className=\"text-xs text-muted-foreground\">{r.date}</p>","-                </div>","-              </button>","-            )","-          })}","-        </div>","-      )}","-    </div>","-  )","-}","+import { useState } from 'react'\r","+import { ArrowLeft, FileText } from 'lucide-react'\r","+import { Button } from '@/components/ui/button'\r","+import { SAMPLE_PATIENT, rank, CANDIDATES } from '@/lib/pipeline'\r","+import { Report } from './report'\r","+import { useRun, type CompletedRun } from '@/lib/run-store'\r","+\r","+/** Saved runs as paper previews (Callio Labs' Projects panel, for reports). */\r","+export default function Runs({ onNewRun }: { onNewRun: () => void }) {\r","+  const { runs } = useRun()\r","+  const [open, setOpen] = useState<CompletedRun | null>(null)\r","+\r","+  if (open) {\r","+    return (\r","+      <div className=\"mx-auto max-w-4xl\">\r","+        <Button size=\"sm\" variant=\"ghost\" className=\"mb-3\" onClick={() => setOpen(null)}>\r","+          <ArrowLeft aria-hidden /> All runs\r","+        </Button>\r","+        <div className=\"rounded-xl bg-card p-6 ring-1 ring-border backdrop-blur-md\">\r","+          <Report patient={SAMPLE_PATIENT} weights={open.weights} date={open.date} caseName={open.caseName} />\r","+        </div>\r","+      </div>\r","+    )\r","+  }\r","+\r","+  return (\r","+    <div className=\"mx-auto max-w-[1440px]\">\r","+      <div className=\"mb-4 rounded-xl bg-card px-5 pt-5 pb-4 ring-1 ring-border backdrop-blur-md\">\r","+        <p className=\"eyebrow\">Discovery / Runs & reports</p>\r","+        <h2 className=\"font-brand mt-3 text-[clamp(2.25rem,3.6vw,3.25rem)] leading-none\">Every run, with its evidence.</h2>\r","+      </div>\r","+      {runs.length === 0 ? (\r","+        <div className=\"rounded-xl bg-card p-8 ring-1 ring-border backdrop-blur-md\">\r","+          <p className=\"text-muted-foreground\">No runs yet in this session.</p>\r","+          <Button className=\"mt-4\" onClick={onNewRun}>Start a discovery run</Button>\r","+        </div>\r","+      ) : (\r","+        <div className=\"grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5\">\r","+          {runs.map((r) => {\r","+            const top = rank(CANDIDATES, r.weights)[0]\r","+            return (\r","+              <button\r","+                key={r.id}\r","+                type=\"button\"\r","+                onClick={() => setOpen(r)}\r","+                className=\"group overflow-hidden rounded-xl bg-card text-left ring-1 ring-border backdrop-blur-md transition-transform duration-200 ease-out hover:-translate-y-0.5 active:scale-[0.98]\"\r","+              >\r","+                <div className=\"relative mx-3 mt-3 h-36 overflow-hidden rounded-t-md bg-white shadow-[0_-4px_12px_rgb(0_0_0/0.06)]\">\r","+                  <div className=\"absolute top-0 right-0 size-5\" style={{ background: 'linear-gradient(225deg, #e7e2d8 50%, #f6f3ed 50%)' }} />\r","+                  <p className=\"px-3 pt-3 text-[11px] leading-snug font-semibold text-foreground/80\">\r","+                    Alternative therapeutic candidates for {SAMPLE_PATIENT.label}\r","+                  </p>\r","+                  <div className=\"mt-2 flex flex-col gap-1.5 px-3\">\r","+                    {[90, 70, 82, 55, 75].map((w, i) => (\r","+                      <div key={i} className=\"h-1 rounded-full bg-foreground/[0.07]\" style={{ width: `${w}%` }} />\r","+                    ))}\r","+                  </div>\r","+                </div>\r","+                <div className=\"border-t px-3 py-2.5\">\r","+                  <p className=\"flex items-center gap-1.5 text-sm font-medium\">\r","+                    <FileText className=\"size-3.5 text-muted-foreground\" aria-hidden /> Top: {top.drug}\r","+                  </p>\r","+                  <p className=\"truncate text-xs text-muted-foreground\">{r.caseName ?? 'Sample case'} · {r.date}</p>\r","+                </div>\r","+              </butto