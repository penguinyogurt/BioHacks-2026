{"parentUuid":"d4430568-b29e-40af-acfc-f5fc60d54d79","isSidechain":false,"promptId":"5584e13f-8f03-4daa-9c78-0f9c386bc9ae","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VjTte2KTVUfcVUAV2MNX8p","type":"tool_result","content":"The file C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\lib\\run-store.tsx has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"235ac48f-49ad-442f-b00f-9c8ac9dc2c5b","timestamp":"2026-11-08T04:16:08.201Z","toolUseResult":{"type":"update","filePath":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\lib\\run-store.tsx","content":"import { createContext, useCallback, useContext, useEffect, useReducer, useRef, useState, type ReactNode } from 'react'\nimport type { CaseFile } from './case-pdf'\nimport {\n  SAMPLE_PATIENT, STAGES, runDemoStage,\n  type AgentStep, type DrugProfile, type PipelineEvent, type StageId, type Weights,\n} from './pipeline'\n\n/**\n * One discovery run, shared by every pipeline page (case → analysis → profiles →\n * embedding → candidates → report). The run advances ONE stage at a time: when a\n * stage finishes it pauses until the user starts the next.\n */\n\nexport type StageStatus = 'pending' | 'running' | 'done'\nexport type TraceItem = { stage: StageId; lane?: number; step: AgentStep }\nexport type CompletedRun = {\n  id: string\n  date: string\n  weights: Weights\n  goal: string\n  caseName: string | null\n  caseFile: CaseFile | null\n  /** Final state of every step, so the whole run can be reopened later. */\n  snapshot: RunState\n}\n\nexport type RunState = {\n  /** idle: not started · running: a stage is working · paused: waiting for the user · done: report written */\n  phase: 'idle' | 'running' | 'paused' | 'done'\n  stages: Record<StageId, StageStatus>\n  trace: TraceItem[]\n  profiles: DrugProfile[]\n  matches: boolean\n  candidates: boolean\n  report: boolean\n}\n\nconst initial: RunState = {\n  phase: 'idle',\n  stages: { analysis: 'pending', profiles: 'pending', embedding: 'pending', research: 'pending', report: 'pending' },\n  trace: [],\n  profiles: [],\n  matches: false,\n  candidates: false,\n  report: false,\n}\n\ntype Action =\n  | PipelineEvent\n  | { type: 'begin' }\n  | { type: 'stage-start' }\n  | { type: 'stage-end'; last: boolean }\n  | { type: 'reset' }\n  | { type: 'load'; state: RunState }\n\nfunction reducer(s: RunState, a: Action): RunState {\n  switch (a.type) {\n    case 'reset':\n      return initial\n    case 'load':\n      return a.state\n    case 'begin':\n      return { ...initial, phase: 'running' }\n    case 'stage-start':\n      return { ...s, phase: 'running' }\n    case 'stage-end':\n      return { ...s, phase: a.last ? 'done' : 'paused' }\n    case 'stage':\n      return { ...s, stages: { ...s.stages, [a.stage]: a.status } }\n    case 'step':\n      return { ...s, trace: [...s.trace, { stage: a.stage, lane: a.lane, step: a.step }] }\n    case 'profile':\n      return { ...s, profiles: [...s.profiles, a.profile].sort((x, y) => x.lane - y.lane) }\n    case 'matches':\n      return { ...s, matches: true }\n    case 'candidates':\n      return { ...s, candidates: true }\n    case 'report':\n      return { ...s, report: true }\n  }\n}\n\n/** The stage the user can start next, if any. */\nexport function nextStage(s: RunState): StageId | null {\n  if (s.phase !== 'paused') return null\n  return STAGES.find((x) => s.stages[x.id] === 'pending')?.id ?? null\n}\n\nexport const DEFAULT_GOAL = 'Drugs that could slow progression or ease bulbar symptoms, given MRgFUS can open the blood–brain barrier.'\n\ntype Store = {\n  state: RunState\n  caseFile: CaseFile | null\n  setCaseFile: (f: CaseFile | null) => void\n  goal: string\n  setGoal: (g: string) => void\n  weights: Weights\n  setWeights: (w: Weights) => void\n  date: string\n  runs: CompletedRun[]\n  /** Start a new run: patient analysis only. */\n  start: () => void\n  /** Run the next stage, after the user asks for it. */\n  advance: () => void\n  /** Finish the stage that's running now. */\n  skip: () => void\n  reset: () => void\n  /** Reopen a finished run on every step page. */\n  open: (run: CompletedRun) => void\n  /** Id of the reopened run, if one is being viewed. */\n  openedId: string | null\n}\n\nconst Ctx = createContext<Store | null>(null)\n\nexport function RunProvider({ children }: { children: ReactNode }) {\n  const [state, dispatch] = useReducer(reducer, initial)\n  const [caseFile, setCaseFile] = useState<CaseFile | null>(null)\n  const [goal, setGoal] = useState(DEFAULT_GOAL)\n  const [weights, setWeights] = useState<Weights>({ fit: true, safety: true, cost: true, availability: true, acceptance: true })\n  const [date, setDate] = useState('')\n  const [runs, setRuns] = useState<CompletedRun[]>([])\n  const [openedId, setOpenedId] = useState<string | null>(null)\n  const runner = useRef<{ cancel: () => void; skip: () => void } | null>(null)\n  // Mirror of the reducer, so a finished run can be saved whole without waiting for a render.\n  const snap = useRef<RunState>(initial)\n  const meta = useRef({ when: '', caseFile: null as CaseFile | null, goal: '', weights })\n\n  useEffect(() => () => runner.current?.cancel(), [])\n\n  const apply = useCallback((a: Action) => {\n    snap.current = reducer(snap.current, a)\n    dispatch(a)\n  }, [])\n\n  const runStage = useCallback(\n    (stage: StageId) => {\n      const m = meta.current\n      const caseInput = m.caseFile\n        ? { name: m.caseFile.name, pages: m.caseFile.pages, words: m.caseFile.words, excerpt: m.caseFile.text.join(' ').slice(0, 220).trim() }\n        : null\n      apply({ type: 'stage-start' })\n      runner.current = runDemoStage(SAMPLE_PATIENT, caseInput, stage, apply, () => {\n        runner.current = null\n        const last = stage === STAGES[STAGES.length - 1].id\n        apply({ type: 'stage-end', last })\n        if (last) {\n          const run: CompletedRun = {\n            id: crypto.randomUUID(),\n            date: m.when,\n            weights: m.weights,\n            goal: m.goal,\n            caseName: m.caseFile?.name ?? null,\n            caseFile: m.caseFile,\n            snapshot: snap.current,\n          }\n          setRuns((r) => [run, ...r])\n          setOpenedId(run.id)\n        }\n      })\n    },\n    [apply],\n  )\n\n  const start = useCallback(() => {\n    runner.current?.cancel()\n    const when = new Intl.DateTimeFormat('en-CA', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date())\n    meta.current = { when, caseFile, goal, weights }\n    setDate(when)\n    setOpenedId(null)\n    snap.current = initial\n    apply({ type: 'begin' })\n    runStage('analysis')\n  }, [apply, runStage, caseFile, goal, weights])\n\n  const advance = useCallback(() => {\n    const next = nextStage(snap.current)\n    if (next) runStage(next)\n  }, [runStage])\n\n  const skip = useCallback(() => runner.current?.skip(), [])\n\n  const reset = useCallback(() => {\n    runner.current?.cancel()\n    runner.current = null\n    snap.current = initial\n    dispatch({ type: 'reset' })\n    setOpenedId(null)\n  }, [])\n\n  const open = useCallback((run: CompletedRun) => {\n    runner.current?.cancel()\n    runner.current = null\n    snap.current = run.snapshot\n    dispatch({ type: 'load', state: run.snapshot })\n    setCaseFile(run.caseFile)\n    setGoal(run.goal)\n    setWeights(run.weights)\n    setDate(run.date)\n    setOpenedId(run.id)\n  }, [])\n\n  return (\n    <Ctx.Provider\n      value={{ state, caseFile, setCaseFile, goal, setGoal, weights, setWeights, date, runs, start, advance, skip, reset, open, openedId }}\n    >\n      {children}\n    </Ctx.Provider>\n  )\n}\n\nexport function useRun() {\n  const ctx = useContext(Ctx)\n  if (!ctx) throw new Error('useRun must be used inside <RunProvider>')\n  return ctx\n}\n","structuredPatch":[{"oldStart":1,"oldLines":14,"newStart":1,"newLines":14,"lines":[" import { createContext, useCallback, useContext, useEffect, useReducer, useRef, useState, type ReactNode } from 'react'"," import type { CaseFile } from './case-pdf'"," import {","-  SAMPLE_PATIENT, runDemoPipeline,","+  SAMPLE_PATIENT, STAGES, runDemoStage,","   type AgentStep, type DrugProfile, type PipelineEvent, type StageId, type Weights,"," } from './pipeline'"," "," /**","  * One discovery run, shared by every pipeline page (case → analysis → profiles →","- * embedding → candidates → report). Lives above the pages so the run keeps going","- * while you move between them.","+ * embedding → candidates → report). The run advances ONE stage at a time: when a","+ * stage finishes it pauses until the user starts the next.","  */"," "," export type StageStatus = 'pending' | 'running' | 'done'"]},{"oldStart":25,"oldLines":7,"newStart":25,"newLines":8,"lines":[" }"," "," export type RunState = {","-  phase: 'idle' | 'running' | 'done'","+  /** idle: not started · running: a stage is working · paused: waiting for the user · done: report written */","+  phase: 'idle' | 'running' | 'paused' | 'done'","   stages: Record<StageId, StageStatus>","   trace: TraceItem[]","   profiles: DrugProfile[]"]},{"oldStart":44,"oldLines":7,"newStart":45,"newLines":13,"lines":["   report: false,"," }"," ","-type Action = PipelineEvent | { type: 'start' } | { type: 'finish' } | { type: 'reset' } | { type: 'load'; state: RunState }","+type Action =","+  | PipelineEvent","+  | { type: 'begin' }","+  | { type: 'stage-start' }","+  | { type: 'stage-end'; last: boolean }","+  | { type: 'reset' }","+  | { type: 'load'; state: RunState }"," "," function reducer(s: RunState, a: Action): RunState {","   switch (a.type) {"]},{"oldStart":52,"oldLines":10,"newStart":59,"newLines":12,"lines":["       return initial","     case 'load':","       return a.state","-    case 'start':","+    case 'begin':","       return { ...initial, phase: 'running' }","-    case 'finish':","-      return { ...s, phase: 'done' }","+    case 'stage-start':","+      return { ...s, phase: 'running' }","+    case 'stage-end':","+      return { ...s, phase: a.last ? 'done' : 'paused' }","     case 'stage':","       return { ...s, stages: { ...s.stages, [a.stage]: a.status } }","     case 'step':"]},{"oldStart":71,"oldLines":6,"newStart":80,"newLines":12,"lines":["   }"," }"," ","+/** The stage the user can start next, if any. */","+export function nextStage(s: RunState): StageId | null {","+  if (s.phase !== 'paused') return null","+  return STAGES.find((x) => s.stages[x.id] === 'pending')?.id ?? null","+}","+"," export const DEFAULT_GOAL = 'Drugs that could slow progression or ease bulbar symptoms, given MRgFUS can open the blood–brain barrier.'"," "," type Store = {"]},{"oldStart":83,"oldLines":7,"newStart":98,"newLines":11,"lines":["   setWeights: (w: Weights) => void","   date: string","   runs: CompletedRun[]","+  /** Start a new run: patient analysis only. */","   start: () => void","+  /** Run the next stage, after the user asks for it. */","+  advance: () => void","+  /** Finish the stage that's running now. */","   skip: () => void","   reset: () => void","   /** Reopen a finished run on every step page. */"]},{"oldStart":94,"oldLines":7,"newStart":113,"newLines":7,"lines":[" "," const Ctx = createContext<Store | null>(null)"," ","-export function RunProvider({ children, onStage }: { children: ReactNode; onStage?: (stage: StageId) => void }) {","+export function RunProvider({ children }: { children: ReactNode }) {","   const [state, dispatch] = useReducer(reducer, initial)","   const [caseFile, setCaseFile] = useState<CaseFile | null>(null)","   const [goal, setGoal] = useState(DEFAULT_GOAL)"]},{"oldStart":103,"oldLines":49,"newStart":122,"newLines":76,"lines":["   const [runs, setRuns] = useState<CompletedRun[]>([])","   const [openedId, setOpenedId] = useState<string | null>(null)","   const runner = useRef<{ cancel: () => void; skip: () => void } | null>(null)","-  const onStageRef = useRef(onStage)","-  onStageRef.current = onStage","+  // Mirror of the reducer, so a finished run can be saved whole without waiting for a render.","+  const snap = useRef<RunState>(initial)","+  const meta = useRef({ when: '', caseFile: null as CaseFile | null, goal: '', weights })"," ","   useEffect(() => () => runner.current?.cancel(), [])"," ","+  const apply = useCallback((a: Action) => {","+    snap.current = reducer(snap.current, a)","+    dispatch(a)","+  }, [])","+","+  const runStage = useCallback(","+    (stage: StageId) => {","+      const m = meta.current","+      const caseInput = m.caseFile","+        ? { name: m.caseFile.name, pages: m.caseFile.pages, words: m.caseFile.words, excerpt: m.caseFile.text.join(' ').slice(0, 220).trim() }","+        : null","+      apply({ type: 'stage-start' })","+      runner.current = runDemoStage(SAMPLE_PATIENT, caseInput, stage, apply, () => {","+        runner.current = null","+        const last = stage === STAGES[STAGES.length - 1].id","+        apply({ type: 'stage-end', last })","+        if (last) {","+          const run: CompletedRun = {","+            id: crypto.randomUUID(),","+            date: m.when,","+            weights: m.weights,","+            goal: m.goal,","+            caseName: m.caseFile?.name ?? null,","+            caseFile: m.caseFile,","+            snapshot: snap.current,","+          }","+          setRuns((r) => [run, ...r])","+          setOpenedId(run.id)","+        }","+      })","+    },","+    [apply],","+  )","+","   const start = useCallback(() => {","     runner.current?.cancel()","-    dispatch({ type: 'start' })","-    setOpenedId(null)","-    // Mirror the reducer locally so the finished run can be saved whole.","-    let snap = reducer(initial, { type: 'start' })","     const when = new Intl.DateTimeFormat('en-CA', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date())","+    meta.current = { when, caseFile, goal, weights }","     setDate(when)","-    const caseInput = caseFile","-      ? { name: caseFile.name, pages: caseFile.pages, words: caseFile.words, excerpt: caseFile.text.join(' ').slice(0, 220).trim() }","-      : null","-    runner.current = runDemoPipeline(","-      SAMPLE_PATIENT,","-      caseInput,","-      (e) => {","-        snap = reducer(snap, e)","-        dispatch(e)","-        if (e.type === 'stage' && e.status === 'running') onStageRef.current?.(e.stage)","-      },","-      () => {","-        dispatch({ type: 'finish' })","-        snap = reducer(snap, { type: 'finish' })","-        const run: CompletedRun = { id: crypto.randomUUID(), date: when, weights, goal, caseName: caseFile?.name ?? null, caseFile, snapshot: snap }","-        setRuns((r) => [run, ...r])","-        setOpenedId(run.id)","-      },","-    )","-  }, [caseFile, goal, weights])","+    setOpenedId(null)","+    snap.current = initial","+    apply({ type: 'begin' })","+    runStage('analysis')","+  }, [apply, runStage, caseFile, goal, weights])"," ","+  const advance = useCallback(() => {","+    const next = nextStage(snap.current)","+    if (next) runStage(next)","+  }, [runStage])","+","   const skip = useCallback(() => runner.current?.skip(), [])","+","   const reset = useCallback(() => {","     runner.current?.cancel()","+    runner.current = null","+    snap.current = initial","     dispatch({ type: 'reset' })","     setOpenedId(null)","   }, [])"," ","   const open = useCallback((run: CompletedRun) => {","     runner.current?.cancel()","+    runner.current = null","+    snap.current = run.snapshot","     dispatch({ type: 'load', state: run.snapshot })","     setCaseFile(run.caseFile)","     setGoal(run.goal)"]},{"oldStart":155,"oldLines":7,"newStart":201,"newLines":9,"lines":["   }, [])"," ","   return (","-    <Ctx.Provider value={{ state, caseFile, setCaseFile, goal, setGoal, weights, setWeights, date, runs, start, skip, reset, open, openedId }}>","+    <Ctx.Provider","+      value={{ state, caseFile, setCaseFile, goal, setGoal, weights, setWeights, date, runs, start, advance, skip, reset, open, openedId }}","+    >","       {children}","     </Ctx.Provider>","   )"]}],"originalFile":"import { createContext, useCallback, useContext, useEffect, useReducer, useRef, useState, type ReactNode } from 'react'\nimport type { CaseFile } from './case-pdf'\nimport {\n  SAMPLE_PATIENT, runDemoPipeline,\n  type AgentStep, type DrugProfile, type PipelineEvent, type StageId, type Weights,\n} from './pipeline'\n\n/**\n * One discovery run, shared by every pipeline page (case → analysis → profiles →\n * embedding → candidates → report). Lives above the pages so the run keeps going\n * while you move between them.\n */\n\nexport type StageStatus = 'pending' | 'running' | 'done'\nexport type TraceItem = { stage: StageId; lane?: number; step: AgentStep }\nexport type CompletedRun = {\n  id: string\n  date: string\n  weights: Weights\n  goal: string\n  caseName: string | null\n  caseFile: CaseFile | null\n  /** Final state of every step, so the whole run can be reopened later. */\n  snapshot: RunState\n}\n\nexport type RunState = {\n  phase: 'idle' | 'running' | 'done'\n  stages: Record<StageId, StageStatus>\n  trace: TraceItem[]\n  profiles: DrugProfile[]\n  matches: boolean\n  candidates: boolean\n  report: boolean\n}\n\nconst initial: RunState = {\n  phase: 'idle',\n  stages: { analysis: 'pending', profiles: 'pending', embedding: 'pending', research: 'pending', report: 'pending' },\n  trace: [],\n  profiles: [],\n  matches: false,\n  candidates: false,\n  report: false,\n}\n\ntype Action = PipelineEvent | { type: 'start' } | { type: 'finish' } | { type: 'reset' } | { type: 'load'; state: RunState }\n\nfunction reducer(s: RunState, a: Action): RunState {\n  switch (a.type) {\n    case 'reset':\n      return initial\n    case 'load':\n      return a.state\n    case 'start':\n      return { ...initial, phase: 'running' }\n    case 'finish':\n      return { ...s, phase: 'done' }\n    case 'stage':\n      return { ...s, stages: { ...s.stages, [a.stage]: a.status } }\n    case 'step':\n      return { ...s, trace: [...s.trace, { stage: a.stage, lane: a.lane, step: a.step }] }\n    case 'profile':\n      return { ...s, profiles: [...s.profiles, a.profile].sort((x, y) => x.lane - y.lane) }\n    case 'matches':\n      return { ...s, matches: true }\n    case 'candidates':\n      return { ...s, candidates: true }\n    case 'report':\n      return { ...s, report: true }\n  }\n}\n\nexport const DEFAULT_GOAL = 'Drugs that could slow progression or ease bulbar symptoms, given MRgFUS can open the blood–brain barrier.'\n\ntype Store = {\n  state: RunState\n  caseFile: CaseFile | null\n  setCaseFile: (f: CaseFile | null) => void\n  goal: string\n  setGoal: (g: string) => void\n  weights: Weights\n  setWeights: (w: Weights) => void\n  date: string\n  runs: CompletedRun[]\n  start: () => void\n  skip: () => void\n  reset: () => void\n  /** Reopen a finished run on every step page. */\n  open: (run: CompletedRun) => void\n  /** Id of the reopened run, if one is being viewed. */\n  openedId: string | null\n}\n\nconst Ctx = createContext<Store | null>(null)\n\nexport function RunProvider({ children, onStage }: { children: ReactNode; onStage?: (stage: StageId) => void }) {\n  const [state, dispatch] = useReducer(reducer, initial)\n  const [caseFile, setCaseFile] = useState<CaseFile | null>(null)\n  const [goal, setGoal] = useState(DEFAULT_GOAL)\n  const [weights, setWeights] = useState<Weights>({ fit: true, safety: true, cost: true, availability: true, acceptance: true })\n  const [date, setDate] = useState('')\n  const [runs, setRuns] = useState<CompletedRun[]>([])\n  const [openedId, setOpenedId] = useState<string | null>(null)\n  const runner = useRef<{ cancel: () => void; skip: () => void } | null>(null)\n  const onStageRef = useRef(onStage)\n  onStageRef.current = onStage\n\n  useEffect(() => () => runner.current?.cancel(), [])\n\n  const start = useCallback(() => {\n    runner.current?.cancel()\n    dispatch({ type: 'start' })\n    setOpenedId(null)\n    // Mirror the reducer locally so the finished run can be saved whole.\n    let snap = reducer(initial, { type: 'start' })\n    const when = new Intl.DateTimeFormat('en-CA', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date())\n    setDate(when)\n    const caseInput = caseFile\n      ? { name: caseFile.name, pages: caseFile.pages, words: caseFile.words, excerpt: caseFile.text.join(' ').slice(0, 220).trim() }\n      : null\n    runner.current = runDemoPipeline(\n      SAMPLE_PATIENT,\n      caseInput,\n      (e) => {\n        snap = reducer(snap, e)\n        dispatch(e)\n        if (e.type === 'stage' && e.status === 'running') onStageRef.current?.(e.stage)\n      },\n      () => {\n        dispatch({ type: 'finish' })\n        snap = reducer(snap, { type: 'finish' })\n        const run: CompletedRun = { id: crypto.randomUUID(), date: when, weights, goal, caseName: caseFile?.name ?? null, caseFile, snapshot: snap }\n        setRuns((r) => [run, ...r])\n        setOpenedId(run.id)\n      },\n    )\n  }, [caseFile, goal, weights])\n\n  const skip = useCallback(() => runner.current?.skip(), [])\n  const reset = useCallback(() => {\n    runner.current?.cancel()\n    dispatch({ type: 'reset' })\n    setOpenedId(null)\n  }, [])\n\n  const open = useCallback((run: CompletedRun) => {\n    runner.current?.cancel()\n    dispatch({ type: 'load', state: run.snapshot })\n    setCaseFile(run.caseFile)\n    setGoal(run.goal)\n    setWeights(run.weights)\n    setDate(run.date)\n    setOpenedId(run.id)\n  }, [])\n\n  return (\n    <Ctx.Provider value={{ state, caseFile, setCaseFile, goal, setGoal, weights, setWeights, date, runs, start, skip, reset, open, openedId }}>\n      {children}\n    </Ctx.Provider>\n  )\n}\n\nexport function useRun() {\n  const ctx = useContext(Ctx)\n  if (!ctx) throw new Error('useRun must be used inside <RunProvider>')\n  return ctx\n}\n","userModified":false},"sourceToolAssistantUUID":"d4430568-b29e-40af-acfc-f5fc60d54d79","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"28437234-f1be-440d-9452-c51de1bd38ab","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\jerem\\BioHacks-2026\\frontend","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","version":"2.1.319","gitBranch":"frontend/diagnosis"}
