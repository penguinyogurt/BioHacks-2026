'","+import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar'","+import {","+  DropdownMenu, DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator,","+  DropdownMenuTrigger,","+} from '@/components/ui/dropdown-menu'","+import {","+  Sidebar, SidebarContent, SidebarFooter, SidebarGroup, SidebarGroupContent, SidebarGroupLabel, SidebarHeader,","+  SidebarMenu, SidebarMenuButton, SidebarMenuItem, useSidebar,","+} from '@/components/ui/sidebar'","+","+type NavItem = { value: string; label: string; icon: LucideIcon }","+","+/** Callio Labs' sidebar shape: primary action, main nav, labelled groups, secondary links pinned low. */","+export const NAV_MAIN: NavItem[] = [","+  { value: 'discovery', label: 'Discovery', icon: FlaskConical },","+  { value: 'runs', label: 'Runs & reports', icon: FileText },","+  { value: 'patient', label: 'Patient overview', icon: Activity },","+  { value: 'graph', label: 'Knowledge graph', icon: Network },","+]","+","+export const NAV_GROUPS: { label: string; items: NavItem[] }[] = [","+  {","+    label: 'Patient data',","+    items: [","+      { value: 'genetics', label: 'Genetics', icon: Dna },","+      { value: 'medications', label: 'Medications', icon: Pill },","+      { value: 'visits', label: 'Clinic visits', icon: CalendarDays },","+      { value: 'diary', label: 'Symptom diary', icon: NotebookPen },","+    ],","+  },","+  {","+    label: 'Delivery & access',","+    items: [","+      { value: 'fus', label: 'Focused ultrasound', icon: Waves },","+      { value: 'trials', label: 'Clinical trials', icon: FlaskConical },","+      { value: 'care-team', label: 'Care team', icon: Users },","+    ],","+  },","+]","+","+export const NAV_SECONDARY: NavItem[] = [","+  { value: 'sources', label: 'Data sources', icon: Database },","+  { value: 'privacy', label: 'Data & privacy', icon: Shield },","+  { value: 'settings', label: 'Settings', icon: Settings },","+]","+","+export const ALL_NAV: NavItem[] = [...NAV_MAIN, ...NAV_GROUPS.flatMap((g) => g.items), ...NAV_SECONDARY]","+","+export type Profile = { name: string; email: string; avatar?: string }","+","+const initials = (name: string) =>","+  name.trim().split(/\\s+/).map((p) => p[0]).slice(0, 2).join('').toUpperCase() || '?'","+","+function NavList({ items, active, select }: { items: NavItem[]; active: string; select: (v: string) => void }) {","+  return (","+    <SidebarMenu>","+      {items.map((item) => (","+        <SidebarMenuItem key={item.value}>","+          <SidebarMenuButton tooltip={item.label} isActive={active === item.value} onClick={() => select(item.value)}>","+            <item.icon />","+            <span>{item.label}</span>","+          </SidebarMenuButton>","+        </SidebarMenuItem>","+      ))}","+    </SidebarMenu>","+  )","+}","+","+export function AppSidebar({","+  active,","+  onSelect,","+  profile,","+  onSignOut,","+}: {","+  active: string","+  onSelect: (view: string) => void","+  profile: Profile","+  onSignOut?: () => void","+}) {","+  const { isMobile, setOpenMobile } = useSidebar()","+  const select = (value: string) => {","+    onSelect(value)","+    if (isMobile) setOpenMobile(false)","+  }","+","+  return (","+    <Sidebar variant=\"inset\" collapsible=\"offcanvas\">","+      <SidebarHeader className=\"pt-4\">","+        <SidebarMenu>","+          <SidebarMenuItem>","+            <SidebarMenuButton className=\"h-auto !p-2 !pt-3 hover:bg-transparent active:bg-transparent\" onClick={() => select('discovery')}>","+              <span className=\"font-brand text-3xl leading-none\">addo labs</span>","+            </SidebarMenuButton>","+          </SidebarMenuItem>","+        </SidebarMenu>","+      </SidebarHeader>","+","+      <SidebarContent>","+        <SidebarGroup>","+          <SidebarGroupContent className=\"flex flex-col gap-2\">","+            <SidebarMenu>","+              <SidebarMenuItem>","+                <SidebarMenuButton","+                  tool