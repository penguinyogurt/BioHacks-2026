{"parentUuid":"66e7d2f8-51b6-4a59-9fa2-7f85f79e4169","isSidechain":false,"promptId":"c3780c27-9de0-48b8-b623-c4cb605155a0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K8AbJ5UFS95oSDExxzsVH5","type":"tool_result","content":"The file C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\neuron-viewer.tsx has been updated successfully."}]},"uuid":"24707a26-254c-40c3-b158-61907fa99ea0","timestamp":"2026-11-07T23:15:54.741Z","toolUseResult":{"filePath":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\neuron-viewer.tsx","oldString":"const MODEL_URL = '/models/neuron.glb'\nconst MODEL_SIZE = 13 // long axis, world units\nconst COLOR = '#2f5f6b' // teal ink\nconst OPACITY = 0.55\nconst AUTO_ROTATE_SPEED = 2.2\n\nfunction Neuron({ onLoaded }: { onLoaded: () => void }) {\n  const gltf = useLoader(GLTFLoader, MODEL_URL)\n\n  const { model, center, scale } = useMemo(() => {\n    const model = gltf.scene.clone(true)\n    model.updateMatrixWorld(true)\n    const box = new THREE.Box3().setFromObject(model)\n    const size = box.getSize(new THREE.Vector3())\n    return { model, center: box.getCenter(new THREE.Vector3()), scale: MODEL_SIZE / (Math.max(size.x, size.y, size.z) || 1) }\n  }, [gltf])\n\n  useEffect(() => {\n    model.traverse((node) => {\n      const mesh = node as THREE.Mesh\n      if (!mesh.isMesh) return\n      mesh.frustumCulled = false\n      for (const m of Array.isArray(mesh.material) ? mesh.material : [mesh.material]) {\n        if ('color' in m && m.color instanceof THREE.Color) m.color.set(COLOR)\n        m.transparent = true\n        m.opacity = OPACITY\n        m.depthWrite = false\n      }\n    })\n    onLoaded()\n  }, [model, onLoaded])","newString":"const MODEL_URL = '/models/neuron.glb'\nconst MODEL_SIZE = 13 // long axis, world units\nconst COLOR = '#2f5f6b' // teal ink\nconst PULSE = '#0b7f8f' // saturated teal: signals darken and saturate the membrane, never glow\nconst OPACITY = 0.55\nconst AUTO_ROTATE_SPEED = 2.2\n\n/*\n * Landmarks in the model's own mesh coordinates (long axis = x), measured from\n * its vertices: soma centre, where the axon leaves it, where the terminals begin.\n */\nconst SOMA = new THREE.Vector3(-1.0, 0.0, 0.2)\nconst HILLOCK_X = -0.3\nconst AXON_END = new THREE.Vector3(1.35, 0.1, 0.1)\nconst TIP_X = 2.45\n\n/* One firing, in seconds from its start. */\nconst INPUT_S = 0.45 // dendritic inputs converge on the soma\nconst AP_SPEED = 2.6 // mesh units / s down the axon\nconst BURST = 10 // particles per terminal\n\nconst pulseVert = /* glsl */ `\nvarying vec3 vPos;`\nconst pulseFrag = /* glsl */ `\nvarying vec3 vPos;\nuniform vec3 uPulse;\nuniform vec3 uSomaC;\nuniform float uFront;\nuniform float uInward;\nuniform float uSoma;`\nconst pulseApply = /* glsl */ `\n  {\n    float axon = step(${HILLOCK_X.toFixed(2)}, vPos.x);\n    float dA = vPos.x - uFront;\n    float wave = exp(-dA * dA * 30.0) * axon;\n    float r = length(vPos - uSomaC);\n    float dI = r - uInward;\n    float inward = exp(-dI * dI * 30.0) * (1.0 - axon) * step(0.0, uInward);\n    float soma = uSoma * (1.0 - smoothstep(0.35, 0.8, r));\n    float k = clamp(wave + inward * 0.7 + soma * 0.6, 0.0, 1.0);\n    diffuseColor.rgb = mix(diffuseColor.rgb, uPulse, k);\n    diffuseColor.a = mix(diffuseColor.a, 0.95, k);\n  }`\n\nconst particleVS = /* glsl */ `\nattribute float aLife;\nuniform float uSize;\nvarying float vLife;\nvoid main() {\n  vLife = aLife;\n  gl_PointSize = uSize * (0.6 + 0.4 * aLife);\n  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n}`\nconst particleFS = /* glsl */ `\nuniform vec3 uColor;\nvarying float vLife;\nvoid main() {\n  float d = length(gl_PointCoord - 0.5);\n  if (d > 0.5) discard;\n  gl_FragColor = vec4(uColor, vLife * 0.75 * (1.0 - smoothstep(0.3, 0.5, d)));\n}`\n\n/** Terminal tips: farthest-point sample of the vertices past the axon. */\nfunction terminalTips(geo: THREE.BufferGeometry, n: number) {\n  const pos = geo.attributes.position as THREE.BufferAttribute\n  const pts: THREE.Vector3[] = []\n  for (let i = 0; i < pos.count; i++) {\n    const v = new THREE.Vector3().fromBufferAttribute(pos, i)\n    if (v.x > 1.75) pts.push(v)\n  }\n  if (!pts.length) return []\n  const picked = [pts.reduce((a, b) => (b.x > a.x ? b : a))]\n  const best = pts.map((p) => p.distanceToSquared(picked[0]))\n  while (picked.length < Math.min(n, pts.length)) {\n    let k = 0\n    for (let i = 1; i < best.length; i++) if (best[i] > best[k]) k = i\n    picked.push(pts[k])\n    for (let i = 0; i < pts.length; i++) best[i] = Math.min(best[i], pts[i].distanceToSquared(pts[k]))\n  }\n  return picked\n}\n\nfunction Neuron({ onLoaded, firing }: { onLoaded: () => void; firing: boolean }) {\n  const gltf = useLoader(GLTFLoader, MODEL_URL)\n  const dpr = useThree((s) => s.viewport.dpr)\n\n  const { model, center, scale } = useMemo(() => {\n    const model = gltf.scene.clone(true)\n    model.updateMatrixWorld(true)\n    const box = new THREE.Box3().setFromObject(model)\n    const size = box.getSize(new THREE.Vector3())\n    return { model, center: box.getCenter(new THREE.Vector3()), scale: MODEL_SIZE / (Math.max(size.x, size.y, size.z) || 1) }\n  }, [gltf])\n\n  /** Shared by every membrane material; driven from useFrame. */\n  const uniforms = useMemo(\n    () => ({\n      uPulse: { value: new THREE.Color(PULSE) },\n      uSomaC: { value: SOMA.clone() },\n      uFront: { value: -10 },\n      uInward: { value: -1 },\n      uSoma: { value: 0 },\n    }),\n    [],\n  )\n\n  const sparks = useMemo(() => {\n    let mesh: THREE.Mesh | undefined\n    model.traverse((n) => {\n      if (!mesh && (n as THREE.Mesh).isMesh) mesh = n as THREE.Mesh\n    })\n    const tips = mesh ? terminalTips(mesh.geometry, 8) : []\n    const count = Math.max(1, tips.length * BURST)\n    const geo = new THREE.BufferGeometry()\n    const pos = new Float32Array(count * 3)\n    const life = new Float32Array(count)\n    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3))\n    geo.setAttribute('aLife', new THREE.BufferAttribute(life, 1))\n    const mat = new THREE.ShaderMaterial({\n      vertexShader: particleVS,\n      fragmentShader: particleFS,\n      uniforms: { uColor: { value: new THREE.Color(PULSE) }, uSize: { value: 4 } },\n      transparent: true,\n      depthWrite: false,\n    })\n    const points = new THREE.Points(geo, mat)\n    points.frustumCulled = false\n    mesh?.add(points) // lives in mesh space, so it turns with the neuron\n    return { tips, points, pos, life, vel: new Float32Array(count * 3) }\n  }, [model])\n\n  useEffect(() => {\n    model.traverse((node) => {\n      const mesh = node as THREE.Mesh\n      if (!mesh.isMesh) return\n      mesh.frustumCulled = false\n      const mats = (Array.isArray(mesh.material) ? mesh.material : [mesh.material]).map((src) => {\n        const m = src.clone() as THREE.MeshStandardMaterial\n        m.color.set(COLOR)\n        m.transparent = true\n        m.opacity = OPACITY\n        m.depthWrite = false\n        m.onBeforeCompile = (shader) => {\n          Object.assign(shader.uniforms, uniforms)\n          shader.vertexShader = shader.vertexShader\n            .replace('#include <common>', `#include <common>${pulseVert}`)\n            .replace('#include <begin_vertex>', '#include <begin_vertex>\\n  vPos = position;')\n          shader.fragmentShader = shader.fragmentShader\n            .replace('#include <common>', `#include <common>${pulseFrag}`)\n            .replace('#include <color_fragment>', `#include <color_fragment>${pulseApply}`)\n        }\n        m.customProgramCacheKey = () => 'motus-pulse'\n        return m\n      })\n      mesh.material = Array.isArray(mesh.material) ? mats : mats[0]\n    })\n    onLoaded()\n    return () => {\n      sparks.points.geometry.dispose()\n      ;(sparks.points.material as THREE.Material).dispose()\n      sparks.points.removeFromParent()\n    }\n  }, [model, onLoaded, uniforms, sparks])\n\n  // Firing loop: inputs converge → soma darkens → action potential runs to the terminals → release.\n  const clock = useRef({ t: -1.2, next: 2.8, prevFront: -10 })\n  useFrame((_, delta) => {\n    sparks.points.material.uniforms.uSize.value = 4 * dpr\n    const c = clock.current\n    const dt = Math.min(delta, 0.05)\n    if (firing) {\n      c.t += dt\n      if (c.t > c.next) {\n        c.t = 0\n        c.next = 2.6 + Math.random() * 1.2\n      }\n    }\n    const t = c.t\n    uniforms.uInward.value = t >= 0 && t < INPUT_S ? 1.6 - (1.05 * t) / INPUT_S : -1\n    uniforms.uSoma.value = t >= 0 ? Math.exp(-(((t - INPUT_S) / 0.2) ** 2)) : 0\n    const front = t >= INPUT_S ? HILLOCK_X + (t - INPUT_S) * AP_SPEED : -10\n    uniforms.uFront.value = front < TIP_X + 0.3 ? front : -10\n\n    // Release at each terminal as the front reaches it.\n    const { tips, pos, life, vel, points } = sparks\n    tips.forEach((tip, j) => {\n      if (c.prevFront < tip.x && front >= tip.x) {\n        const dir = tip.clone().sub(AXON_END).normalize()\n        for (let k = 0; k < BURST; k++) {\n          const i = j * BURST + k\n          pos[i * 3] = tip.x\n          pos[i * 3 + 1] = tip.y\n          pos[i * 3 + 2] = tip.z\n          const sp = 0.12 + Math.random() * 0.2\n          vel[i * 3] = (dir.x * 0.8 + (Math.random() - 0.5)) * sp\n          vel[i * 3 + 1] = (dir.y * 0.8 + (Math.random() - 0.5)) * sp\n          vel[i * 3 + 2] = (dir.z * 0.8 + (Math.random() - 0.5)) * sp\n          life[i] = 1\n        }\n      }\n    })\n    c.prevFront = front\n    for (let i = 0; i < life.length; i++) {\n      if (life[i] <= 0) continue\n      life[i] = Math.max(0, life[i] - dt / 1.1)\n      pos[i * 3] += vel[i * 3] * dt\n      pos[i * 3 + 1] += vel[i * 3 + 1] * dt\n      pos[i * 3 + 2] += vel[i * 3 + 2] * dt\n    }\n    points.geometry.attributes.position.needsUpdate = true\n    points.geometry.attributes.aLife.needsUpdate = true\n  })","originalFile":"import { Suspense, useEffect, useMemo, useState } from 'react'\nimport { Canvas, useFrame, useLoader, useThree } from '@react-three/fiber'\nimport * as THREE from 'three'\nimport { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js'\nimport { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js'\n\n/**\n * The neuron, standing upright and spinning about its long axis.\n * Model: \"Neuron Cell Low-poly Simple\" by vitalik.kucha, CC BY 4.0\n * (public/models/neuron.LICENSE.txt).\n */\n\nconst MODEL_URL = '/models/neuron.glb'\nconst MODEL_SIZE = 13 // long axis, world units\nconst COLOR = '#2f5f6b' // teal ink\nconst OPACITY = 0.55\nconst AUTO_ROTATE_SPEED = 2.2\n\nfunction Neuron({ onLoaded }: { onLoaded: () => void }) {\n  const gltf = useLoader(GLTFLoader, MODEL_URL)\n\n  const { model, center, scale } = useMemo(() => {\n    const model = gltf.scene.clone(true)\n    model.updateMatrixWorld(true)\n    const box = new THREE.Box3().setFromObject(model)\n    const size = box.getSize(new THREE.Vector3())\n    return { model, center: box.getCenter(new THREE.Vector3()), scale: MODEL_SIZE / (Math.max(size.x, size.y, size.z) || 1) }\n  }, [gltf])\n\n  useEffect(() => {\n    model.traverse((node) => {\n      const mesh = node as THREE.Mesh\n      if (!mesh.isMesh) return\n      mesh.frustumCulled = false\n      for (const m of Array.isArray(mesh.material) ? mesh.material : [mesh.material]) {\n        if ('color' in m && m.color instanceof THREE.Color) m.color.set(COLOR)\n        m.transparent = true\n        m.opacity = OPACITY\n        m.depthWrite = false\n      }\n    })\n    onLoaded()\n  }, [model, onLoaded])\n\n  // The model's long axis is x; turn it 90° so it stands vertically (dendrites up, axon down).\n  return (\n    <group scale={scale} rotation={[0, 0, -Math.PI / 2]}>\n      <group position={[-center.x, -center.y, -center.z]}>\n        <primitive object={model} />\n      </group>\n    </group>\n  )\n}\n\n/** Spin about the vertical axis only: auto-rotate, and drag left/right to turn it. */\nfunction Controls({ autoRotate }: { autoRotate: boolean }) {\n  const { camera, gl } = useThree()\n  const controls = useMemo(() => new OrbitControls(camera, gl.domElement), [camera, gl])\n  useEffect(() => {\n    controls.autoRotate = autoRotate\n    controls.autoRotateSpeed = AUTO_ROTATE_SPEED\n    controls.enableZoom = false\n    controls.enablePan = false\n    controls.enableDamping = true\n    controls.minPolarAngle = Math.PI / 2\n    controls.maxPolarAngle = Math.PI / 2\n    return () => controls.dispose()\n  }, [controls, autoRotate])\n  useFrame(() => controls.update())\n  return null\n}\n\nexport default function NeuronViewer({ reducedMotion = false, className = '' }: { reducedMotion?: boolean; className?: string }) {\n  const [loaded, setLoaded] = useState(false)\n  const onLoaded = useMemo(() => () => setLoaded(true), [])\n  return (\n    <div\n      className={`transition-opacity duration-700 ease-out motion-reduce:transition-none ${loaded ? 'opacity-100' : 'opacity-0'} ${className}`}\n      style={{ cursor: 'grab' }}\n    >\n      <Canvas camera={{ position: [0, 0, 12], fov: 65 }} dpr={[1, 2]} gl={{ alpha: true, antialias: true }}>\n        <ambientLight intensity={2} />\n        <directionalLight position={[8, 8, 6]} intensity={3} />\n        <directionalLight position={[-8, 6, 4]} intensity={2} />\n        <directionalLight position={[0, -10, 2]} intensity={1.5} />\n        <pointLight position={[0, 0, 8]} intensity={2} />\n        <Controls autoRotate={!reducedMotion} />\n        <Suspense fallback={null}>\n          <Neuron onLoaded={onLoaded} />\n        </Suspense>\n      </Canvas>\n    </div>\n  )\n}\n","structuredPatch":[{"oldStart":13,"oldLines":11,"newStart":13,"newLines":88,"lines":[" const MODEL_URL = '/models/neuron.glb'"," const MODEL_SIZE = 13 // long axis, world units"," const COLOR = '#2f5f6b' // teal ink","+const PULSE = '#0b7f8f' // saturated teal: signals darken and saturate the membrane, never glow"," const OPACITY = 0.55"," const AUTO_ROTATE_SPEED = 2.2"," ","-function Neuron({ onLoaded }: { onLoaded: () => void }) {","+/*","+ * Landmarks in the model's own mesh coordinates (long axis = x), measured from","+ * its vertices: soma centre, where the axon leaves it, where the terminals begin.","+ */","+const SOMA = new THREE.Vector3(-1.0, 0.0, 0.2)","+const HILLOCK_X = -0.3","+const AXON_END = new THREE.Vector3(1.35, 0.1, 0.1)","+const TIP_X = 2.45","+","+/* One firing, in seconds from its start. */","+const INPUT_S = 0.45 // dendritic inputs converge on the soma","+const AP_SPEED = 2.6 // mesh units / s down the axon","+const BURST = 10 // particles per terminal","+","+const pulseVert = /* glsl */ `","+varying vec3 vPos;`","+const pulseFrag = /* glsl */ `","+varying vec3 vPos;","+uniform vec3 uPulse;","+uniform vec3 uSomaC;","+uniform float uFront;","+uniform float uInward;","+uniform float uSoma;`","+const pulseApply = /* glsl */ `","+  {","+    float axon = step(${HILLOCK_X.toFixed(2)}, vPos.x);","+    float dA = vPos.x - uFront;","+    float wave = exp(-dA * dA * 30.0) * axon;","+    float r = length(vPos - uSomaC);","+    float dI = r - uInward;","+    float inward = exp(-dI * dI * 30.0) * (1.0 - axon) * step(0.0, uInward);","+    float soma = uSoma * (1.0 - smoothstep(0.35, 0.8, r));","+    float k = clamp(wave + inward * 0.7 + soma * 0.6, 0.0, 1.0);","+    diffuseColor.rgb = mix(diffuseColor.rgb, uPulse, k);","+    diffuseColor.a = mix(diffuseColor.a, 0.95, k);","+  }`","+","+const particleVS = /* glsl */ `","+attribute float aLife;","+uniform float uSize;","+varying float vLife;","+void main() {","+  vLife = aLife;","+  gl_PointSize = uSize * (0.6 + 0.4 * aLife);","+  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);","+}`","+const particleFS = /* glsl */ `","+uniform vec3 uColor;","+varying float vLife;","+void main() {","+  float d = length(gl_PointCoord - 0.5);","+  if (d > 0.5) discard;","+  gl_FragColor = vec4(uColor, vLife * 0.75 * (1.0 - smoothstep(0.3, 0.5, d)));","+}`","+","+/** Terminal tips: farthest-point sample of the vertices past the axon. */","+function terminalTips(geo: THREE.BufferGeometry, n: number) {","+  const pos = geo.attributes.position as THREE.BufferAttribute","+  const pts: THREE.Vector3[] = []","+  for (let i = 0; i < pos.count; i++) {","+    const v = new THREE.Vector3().fromBufferAttribute(pos, i)","+    if (v.x > 1.75) pts.push(v)","+  }","+  if (!pts.length) return []","+  const picked = [pts.reduce((a, b) => (b.x > a.x ? b : a))]","+  const best = pts.map((p) => p.distanceToSquared(picked[0]))","+  while (picked.length < Math.min(n, pts.length)) {","+    let k = 0","+    for (let i = 1; i < best.length; i++) if (best[i] > best[k]) k = i","+    picked.push(pts[k])","+    for (let i = 0; i < pts.length; i++) best[i] = Math.min(best[i], pts[i].distanceToSquared(pts[k]))","+  }","+  return picked","+}","+","+function Neuron({ onLoaded, firing }: { onLoaded: () => void; firing: boolean }) {","   const gltf = useLoader(GLTFLoader, MODEL_URL)","+  const dpr = useThree((s) => s.viewport.dpr)"," ","   const { model, center, scale } = useMemo(() => {","     const model = gltf.scene.clone(true)"]},{"oldStart":27,"oldLines":21,"newStart":104,"newLines":125,"lines":["     return { model, center: box.getCenter(new THREE.Vector3()), scale: MODEL_SIZE / (Math.max(size.x, size.y, size.z) || 1) }","   }, [gltf])"," ","+  /** Shared by every membrane material; driven from useFrame. */","+  const uniforms = useMemo(","+    () => ({","+      uPulse: { value: new THREE.Color(PULSE) },","+      uSomaC: { value: SOMA.clone() },","+      uFront: { value: -10 },","+      uInward: { value: -1 },","+      uSoma: { value: 0 },","+    }),","+    [],","+  )","+","+  const sparks = useMemo(() => {","+    let mesh: THREE.Mesh | undefined","+    model.traverse((n) => {","+      if (!mesh && (n as THREE.Mesh).isMesh) mesh = n as THREE.Mesh","+    })","+    const tips = mesh ? terminalTips(mesh.geometry, 8) : []","+    const count = Math.max(1, tips.length * BURST)","+    const geo = new THREE.BufferGeometry()","+    const pos = new Float32Array(count * 3)","+    const life = new Float32Array(count)","+    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3))","+    geo.setAttribute('aLife', new THREE.BufferAttribute(life, 1))","+    const mat = new THREE.ShaderMaterial({","+      vertexShader: particleVS,","+      fragmentShader: particleFS,","+      uniforms: { uColor: { value: new THREE.Color(PULSE) }, uSize: { value: 4 } },","+      transparent: true,","+      depthWrite: false,","+    })","+    const points = new THREE.Points(geo, mat)","+    points.frustumCulled = false","+    mesh?.add(points) // lives in mesh space, so it turns with the neuron","+    return { tips, points, pos, life, vel: new Float32Array(count * 3) }","+  }, [model])","+","   useEffect(() => {","     model.traverse((node) => {","       const mesh = node as THREE.Mesh","       if (!mesh.isMesh) return","       mesh.frustumCulled = false","-      for (const m of Array.isArray(mesh.material) ? mesh.material : [mesh.material]) {","-        if ('color' in m && m.color instanceof THREE.Color) m.color.set(COLOR)","+      const mats = (Array.isArray(mesh.material) ? mesh.material : [mesh.material]).map((src) => {","+        const m = src.clone() as THREE.MeshStandardMaterial","+        m.color.set(COLOR)","         m.transparent = true","         m.opacity = OPACITY","         m.depthWrite = false","-      }","+        m.onBeforeCompile = (shader) => {","+          Object.assign(shader.uniforms, uniforms)","+          shader.vertexShader = shader.vertexShader","+            .replace('#include <common>', `#include <common>${pulseVert}`)","+            .replace('#include <begin_vertex>', '#include <begin_vertex>\\n  vPos = position;')","+          shader.fragmentShader = shader.fragmentShader","+            .replace('#include <common>', `#include <common>${pulseFrag}`)","+            .replace('#include <color_fragment>', `#include <color_fragment>${pulseApply}`)","+        }","+        m.customProgramCacheKey = () => 'motus-pulse'","+        return m","+      })","+      mesh.material = Array.isArray(mesh.material) ? mats : mats[0]","     })","     onLoaded()","-  }, [model, onLoaded])","+    return () => {","+      sparks.points.geometry.dispose()","+      ;(sparks.points.material as THREE.Material).dispose()","+      sparks.points.removeFromParent()","+    }","+  }, [model, onLoaded, uniforms, sparks])"," ","+  // Firing loop: inputs converge → soma darkens → action potential runs to the terminals → release.","+  const clock = useRef({ t: -1.2, next: 2.8, prevFront: -10 })","+  useFrame((_, delta) => {","+    sparks.points.material.uniforms.uSize.value = 4 * dpr","+    const c = clock.current","+    const dt = Math.min(delta, 0.05)","+    if (firing) {","+      c.t += dt","+      if (c.t > c.next) {","+        c.t = 0","+        c.next = 2.6 + Math.random() * 1.2","+      }","+    }","+    const t = c.t","+    uniforms.uInward.value = t >= 0 && t < INPUT_S ? 1.6 - (1.05 * t) / INPUT_S : -1","+    uniforms.uSoma.value = t >= 0 ? Math.exp(-(((t - INPUT_S) / 0.2) ** 2)) : 0","+    const front = t >= INPUT_S ? HILLOCK_X + (t - INPUT_S) * AP_SPEED : -10","+    uniforms.uFront.value = front < TIP_X + 0.3 ? front : -10","+","+    // Release at each terminal as the front reaches it.","+    const { tips, pos, life, vel, points } = sparks","+    tips.forEach((tip, j) => {","+      if (c.prevFront < tip.x && front >= tip.x) {","+        const dir = tip.clone().sub(AXON_END).normalize()","+        for (let k = 0; k < BURST; k++) {","+          const i = j * BURST + k","+          pos[i * 3] = tip.x","+          pos[i * 3 + 1] = tip.y","+          pos[i * 3 + 2] = tip.z","+          const sp = 0.12 + Math.random() * 0.2","+          vel[i * 3] = (dir.x * 0.8 + (Math.random() - 0.5)) * sp","+          vel[i * 3 + 1] = (dir.y * 0.8 + (Math.random() - 0.5)) * sp","+          vel[i * 3 + 2] = (dir.z * 0.8 + (Math.random() - 0.5)) * sp","+          life[i] = 1","+        }","+      }","+    })","+    c.prevFront = front","+    for (let i = 0; i < life.length; i++) {","+      if (life[i] <= 0) continue","+      life[i] = Math.max(0, life[i] - dt / 1.1)","+      pos[i * 3] += vel[i * 3] * dt","+      pos[i * 3 + 1] += vel[i * 3 + 1] * dt","+      pos[i * 3 + 2] += vel[i * 3 + 2] * dt","+    }","+    points.geometry.attributes.position.needsUpdate = true","+    points.geometry.attributes.aLife.needsUpdate = true","+  })","+","   // The model's long axis is x; turn it 90° so it stands vertically (dendrites up, axon down).","   return (","     <group scale={scale} rotation={[0, 0, -Math.PI / 2]}>"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"66e7d2f8-51b6-4a59-9fa2-7f85f79e4169","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"28437234-f1be-440d-9452-c51de1bd38ab","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\jerem\\BioHacks-2026\\frontend","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","version":"2.1.319","gitBranch":"frontend/diagnosis"}
