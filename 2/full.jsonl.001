an className=\"text-xs text-muted-foreground tabular-nums\">{items.length} steps</span>","-      </div>","-      <div ref={ref} className={cn('overflow-y-auto', maxH)}>","-        {items.length ? items.map((it, i) => <StepRow key={i} item={it} />) : <p className=\"px-4 py-3 text-xs text-muted-foreground\">Waiting…</p>}","-      </div>","-      <div className=\"flex items-center gap-2 border-t px-3 py-2 text-xs text-muted-foreground\">","-        {running ? <><Loader2 className=\"size-3 animate-spin text-[#c9732a]\" aria-hidden /> Working…</> : state.stages[stage] === 'done' ? 'Done.' : 'Queued.'}","-      </div>","-    </Card>","-  )","-}","-","-/** Structured patient summary. In a live run the analysis agent fills this from the case PDF. */","-export function PatientCard({ compact = false, footer }: { compact?: boolean; footer?: ReactNode }) {","-  const p = SAMPLE_PATIENT","-  const rows: [string, string][] = [","-    ['Presentation', `${p.age}${p.sex} · ${p.onset} · ${p.monthsSinceDx} mo`],","-    ['ALSFRS-R', `${p.alsfrs}/48 · ${p.slope} pts/mo`],","-    ['FVC', `${p.fvc}% predicted`],","-    ['Genetics', p.genetics],","-    ['Medication', p.medications.join(', ')],","-    ['Conditions', p.comorbidities.join(', ')],","-    ['Location', `${p.location} · ${p.coverage}`],","-  ]","-  return (","-    <Card className=\"gap-3 [--card-spacing:--spacing(5)]\">","-      <CardHeader>","-        <CardTitle className=\"text-lg font-normal\">{p.label}</CardTitle>","-        <CardAction>","-          {p.fusEligible ? (","-            <Badge variant=\"outline\" className=\"gap-1 border-[#c9732a]/40 bg-[#c9732a]/10 font-normal text-[#a35b1d]\">","-              <Zap className=\"size-3\" aria-hidden /> MRgFUS eligible","-            </Badge>","-          ) : null}","-        </CardAction>","-      </CardHeader>","-      <CardContent>","-        <dl className={cn('grid grid-cols-[6.5rem_1fr] gap-x-3 gap-y-1.5 text-sm', compact && 'text-xs')}>","-          {(compact ? rows.slice(0