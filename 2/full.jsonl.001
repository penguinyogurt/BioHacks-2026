} from '@/components/ui/sidebar'\r","+\r","+type NavItem = { value: string; label: string; icon: LucideIcon }\r","+\r","+/** Callio Labs' sidebar shape: primary action, main nav, labelled groups, secondary links pinned low. */\r","+export const NAV_MAIN: NavItem[] = [\r","+  { value: 'discovery', label: 'Discovery', icon: FlaskConical },\r","+  { value: 'runs', label: 'Runs & reports', icon: FileText },\r","+  { value: 'patient', label: 'Patient overview', icon: Activity },\r","+  { value: 'graph', label: 'Knowledge graph', icon: Network },\r","+]\r","+\r","+export const NAV_GROUPS: { label: string; items: NavItem[] }[] = [\r","+  {\r","+    label: 'Patient data',\r","+    items: [\r","+      { value: 'genetics', label: 'Genetics', icon: Dna },\r","+      { value: 'medications', label: 'Medications', icon: Pill },\r","+      { value: 'visits', label: 'Clinic visits', icon: CalendarDays },\r","+      { value: 'diary', label: 'Symptom diary', icon: NotebookPen },\r","+    ],\r","+  },\r","+  {\r","+    label: 'Delivery & access',\r","+    items: [\r","+      { value: 'fus', label: 'Focused ultrasound', icon: Waves },\r","+      { value: 'trials', label: 'Clinical trials', icon: FlaskConical },\r","+      { value: 'care-team', label: 'Care team', icon: Users },\r","+    ],\r","+  },\r","+]\r","+\r","+export const NAV_SECONDARY: NavItem[] = [\r","+  { value: 'sources', label: 'Data sources', icon: Database },\r","+  { value: 'privacy', label: 'Data & privacy', icon: Shield },\r","+  { value: 'settings', label: 'Settings', icon: Settings },\r","+]\r","+\r","+export const ALL_NAV: NavItem[] = [...NAV_MAIN, ...NAV_GROUPS.flatMap((g) => g.items), ...NAV_SECONDARY]\r","+\r","+export type Profile = { name: string; email: string; avatar?: string }\r","+\r","+const initials = (name: string) =>\r","+  name.trim().split(/\\s+/).map((p) => p[0]).slice(0, 2).join('').toUpperCase() || '?'\r","+\r","+function NavList({ items, active, select }: { items: NavItem[]; active: string; select: (v: string) => void }) {\r","+  return (\r","+    <SidebarMenu>\r","+      {items.map((item) => (\r","+        <SidebarMenuItem key={item.value}>\r","+          <SidebarMenuButton tooltip={item.label} isActive={active === item.value} onClick={() => select(item.value)}>\r","+            <item.icon />\r","+            <span>{item.label}</span>\r","+          </SidebarMenuButton>\r","+        </SidebarMenuItem>\r","+      ))}\r","+    </SidebarMenu>\r","+  )\r","+}\r","+\r","+export function AppSidebar({\r","+  active,\r","+  onSelect,\r","+  profile,\r","+  onSignOut,\r","+}: {\r","+  active: string\r","+  onSelect: (view: string) => void\r","+  profile: Profile\r","+  onSignOut?: () => void\r","+}) {\r","+  const { isMobile, setOpenMobile } = useSidebar()\r","+  const select = (value: string) => {\r","+    onSelect(value)\r","+    if (isMobile) setOpenMobile(false)\r","+  }\r","+\r","+  return (\r","+    <Sidebar variant=\"inset\" collapsible=\"offcanvas\">\r","+      <SidebarHeader className=\"pt-4\">\r","+        <SidebarMenu>\r","+          <SidebarMenuItem>\r","+            <SidebarMenuButton className=\"h-auto !p-2 !pt-3 hover:bg-transparent active:bg-transparent\" onClick={() => select('overview')}>\r","+              <span className=\"font-brand text-3xl leading-none\">addo labs</span>\r","+            </SidebarMenuButton>\r","+          </SidebarMenuItem>\r","+        </SidebarMenu>\r","+      </SidebarHeader>\r","+\r","+      <SidebarContent>\r","+        <SidebarGroup>\r","+          <SidebarGroupContent className=\"flex flex-col gap-2\">\r","+            <SidebarMenu>\r","+              <SidebarMenuItem>\r","+                <SidebarMenuButton\r","+                  tooltip=\"New discovery run\"\r","+                  onClick={() => select('new-run')}\r","+                  className=\"min-w-8 bg-primary/80 text-primary-foreground duration-200 ease-linear hover:bg-primary hover:text-primary-foreground active:bg-primary active:text-primary-foreground\"\r","+                >\r","+                  <CirclePlus />\r","+                  <span>New discovery run</span>\r","+                </SidebarMenuButton>\r","+              </SidebarMenuItem>\r","+            </SidebarMenu>\r","+            <NavList items={NAV_MAIN} active={active} select={select} />\r","+          </SidebarGroupContent>\r","+        </SidebarGroup>\r","+\r","+        {NAV_GROUPS.map((group) => (\r","+          <SidebarGroup key={group.label} className=\"group-data-[collapsible=icon]:hidden\">\r","+            <SidebarGroupLabel>{group.label}</SidebarGroupLabel>\r","+            <NavList items={group.items} active={active} select={select} />\r","+          </SidebarGroup>\r","+        ))}\r","+\r","+        <SidebarGroup className=\"mt-auto\">\r","+          <SidebarGroupContent>\r","+            <NavList items={NAV_SECONDARY} active={active} select={select} />\r","+          </SidebarGroupContent>\r","+        </SidebarGroup>\r","+      </SidebarContent>\r","+\r","+      <SidebarFooter>\r","+        <SidebarMenu>\r","+          <SidebarMenuItem>\r","+            <DropdownMenu>\r","+              <DropdownMenuTrigger asChild>\r","+                <SidebarMenuButton size=\"lg\" className=\"data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground\">\r","+                  <Avatar className=\"size-8 rounded-lg grayscale\">\r","+                    {profile.avatar ? <AvatarImage src={profile.avatar} alt=\"\" referrerPolicy=\"no-referrer\" /> : null}\r","+                    <AvatarFallback className=\"rounded-lg\">{initials(profile.name)}</AvatarFallback>\r","+                  </Avatar>\r","+                  <span className=\"grid flex-1 text-left text-sm leading-tight\">\r","+                    <span className=\"truncate font-medium\">{profile.name}</span>\r","+                    <span className=\"truncate text-xs text-muted-foreground\">{profile.email}</span>\r","+                  </span>\r","+                  <MoreVertical className=\"ml-auto size-4\" />\r","+                </SidebarMenuButton>\r","+              </DropdownMenuTrigger>\r","+              <DropdownMenuContent\r","+                className=\"w-(--radix-dropdown-menu-trigger-width) min-w-56 rounded-lg\"\r","+                side={isMobile ? 'bottom' : 'right'}\r","+                align=\"end\"\r","+                sideOffset={4}\r","+              >\r","+                <DropdownMenuLabel className=\"p-0 font-normal\">\r","+                  <div className=\"flex items-center gap-2 px-1 py-1.5 text-left text-sm\">\r","+                    <Avatar className=\"size-8 rounded-lg\">\r","+                      {profile.avatar ? <AvatarImage src={profile.avatar} alt=\"\" referrerPolicy=\"no-referrer\" /> : null}\r","+                      <AvatarFallback className=\"rounded-lg\">{initials(profile.name)}</AvatarFallback>\r","+                    </Avatar>\r","+                    <div className=\"grid flex-1 text-left text-sm leading-tight\">\r","+                      <span className=\"truncate font-medium\">{profile.name}</span>\r","+                      <span className=\"truncate text-xs text-muted-foreground\">{profile.email}</span>\r","+                    </div>\r","+                  </div>\r","+                </DropdownMenuLabel>\r","+                <DropdownMenuSeparator />\r","+                <DropdownMenuGroup>\r","+                  <DropdownMenuItem onSelect={() => select('settings')}>\r","+                    <UserCircle /> Account\r","+                  </DropdownMenuItem>\r","+                  <DropdownMenuItem onSelect={() => select('settings')}>\r","+                    <AlarmClock /> Notifications\r","+                  </DropdownMenuItem>\r","+                  <DropdownMenuItem onSelect={() => select('privacy')}>\r","+                    <BookOpen /> Data & privacy\r","+                  </DropdownMenuItem>\r","+                </DropdownMenuGroup>\r","+                <DropdownMenuSeparat