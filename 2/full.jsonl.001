22\tuniform vec4 uTrail[24];\n123\tuniform float uRadius;\n124\tuniform vec4 uClicks[4];\n125\tuniform int uClickEffect;\n126\tuniform float uIntro;\n127\tuniform float uFrame;\n128\tin vec2 vUv;\n129\tlayout(location = 0) out vec4 outColor;\n130\tlayout(location = 1) out vec4 outAux;\n131\t${COMMON}\n132\tvec2 hash22(vec2 p) {\n133\t  vec3 q = fract(vec3(p.xyx) * vec3(0.1031, 0.103, 0.0973));\n134\t  q += dot(q, q.yzx + 33.33);\n135\t  return fract((q.xx + q.yz) * q.zy) * 2.0 - 1.0;\n136\t}\n137\t\n138\tfloat noise(vec2 p) {\n139\t  vec2 i = floor(p);\n140\t  vec2 f = fract(p);\n141\t  vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);\n142\t  float a = dot(hash22(i), f);\n143\t  float b = dot(hash22(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0));\n144\t  float c = dot(hash22(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0));\n145\t  float d = dot(hash22(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0));\n146\t  return 0.5 + 0.5 * mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n147\t}\n148\t\n149\tvec3 labToRgb(vec3 lab) {\n150\t  float l = lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z;\n151\t  float m = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z;\n152\t  float s = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z;\n153\t  l = l * l * l;\n154\t  m = m * m * m;\n155\t  s = s * s * s;\n156\t  return vec3(\n157\t    4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,\n158\t    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,\n159\t    -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s\n160\t  );\n161\t}\n162\t\n163\tvec3 encode(vec3 c) {\n164\t  c = clamp(c, 0.0, 1.0);\n165\t  return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));\n166\t}\n167\t\n168\tvec3 horizon(vec2 p, float time, out float order) {\n169\t  float span = 0.5 * max(uAspect, 1.0);\n170\t  float x = p.x / span;\n171\t  float arch = -0.17 - 0.2 * x * x + 0.02 * sin(time * 0.6);\n172\t  float soft = mix(0.05, 0.22, uSoftness);\n173\t  float edge = p.y - arch;\n174\t  float rim = 0.38 * smoothstep(-soft, 0.42, edge);\n175\t  vec2 sun = vec2(0.08 * sin(time * 0.31) * span, 0.58);\n176\t  float spread = length((p - sun) / vec2(0.95 * span, 0.75));\n177\t  float sky = mix(0.55, 1.0, smoothstep(0.2, 0.95, spread));\n178\t  order = clamp(edge * 1.3, 0.0, 1.0);\n179\t  return vec3(rim, sky, smoothstep(0.18, 0.62, edge));\n180\t}\n181\t\n182\tvec3 pinch(vec2 p, float time, out float order) {\n183\t  float span = 0.5 * max(uAspect, 0.75);\n184\t  float x = p.x / span;\n185\t  float sway = 0.02 * sin(x * 1.7 + time * 0.55);\n186\t  float breathe = 1.0 + 0.06 * sin(time * 0.8);\n187\t  float width = (0.13 + 0.22 * x * x) * breathe * mix(0.85, 1.2, uSoftness);\n188\t  float y = abs(p.y - sway) / width;\n189\t  float t = exp(-pow(y, 2.2)) * (0.42 + 0.58 * exp(-x * x * 1.8));\n190\t  order = clamp(abs(p.y - sway) * 2.4 + abs(x) * 0.3, 0.0, 1.0);\n191\t  return vec3(t, t, 0.0);\n192\t}\n193\t\n194\tvec3 rise(vec2 p, float time, out float order) {\n195\t  float wide = max(uAspect, 0.9);\n196\t  vec2 center = vec2(0.05 * sin(time * 0.45) * wide, -0.7);\n197\t  vec2 radius = vec2(0.82 * wide, 0.64 * (1.0 + 0.04 * sin(time * 0.8)));\n198\t  float d = length((p - center) / radius);\n199\t  float soft = mix(0.6, 1.15, uSoftness);\n200\t  float t = clamp(pow(clamp(1.0 - d, 0.0, 1.0), soft) * 1.35, 0.0, 1.0);\n201\t  order = clamp((d - 0.2) * 1.3, 0.0, 1.0);\n202\t  return vec3(t, t, 0.0);\n203\t}\n204\t\n205\tvec3 eclipse(vec2 p, float time, out float order) {\n206\t  float fit = min(1.0, uAspect * 1.25);\n207\t  float r = 0.23 * fit * (1.0 + 0.015 * sin(time * 0.9));\n208\t  float angle = atan(p.y, p.x);\n209\t  float rays = noise(vec2(cos(angle), sin(angle)) * 2.2 + time * 0.08) * 0.8 + 0.6;\n210\t  float d = length(p) - r;\n211\t  float reach = mix(0.07, 0.15, uSoftness) * rays * fit;\n212\t  float t = smoothstep(-0.006, 0.006 + 0.02 * uSoftness, d) * exp(-max(d, 0.0) / reach);\n213\t  order = clamp(d * 2.0, 0.0, 1.0);\n214\t  return vec3(t, t, 0.0);\n215\t}\n216\t\n217\tvec4 tone(float t) {\n218\t  float x = smoothstep(0.3, 1.0, t) * float(uCount - 1);\n219\t  int index = int(floor(x));\n220\t  return vec4(mix(uRamp[index], uRamp[min(index + 1, uCount - 1)], fract(x)), smoothstep(0.0, 0.38, t));\n221\t}\n222\t\n223\tvoid main() {\n224\t  vec2 p = (vUv - 0.5) * vec2(uAspect, 1.0);\n225\t  float time = uTime;\n226\t  vec2 q = p / uScale;\n227\t  vec2 warp = vec2(\n228\t    noise(q * 1.6 + uSeed + vec2(0.0, time * 0.3)),\n229\t    noise(q * 1.6 + uSeed.yx + vec2(4.3, -time * 0.24))\n230\t  ) - 0.5;\n231\t  q += warp * uFlow * (uShape == 3 ? 0.04 : 0.18);\n232\t  float order = 0.0;\n233\t  vec3 shape;\n234\t  if (uShape == 0) shape = horizon(q, time, order);\n235\t  else if (uShape == 1) shape = pinch(q, time, order);\n236\t  else if (uShape == 2) shape = rise(q, time, order);\n237\t  else shape = eclipse(q, time, order);\n238\t\n239\t  float reveal = clamp((uIntro * 1.45 - order) / 0.45, 0.0, 1.0);\n240\t  reveal = reveal * reveal * (3.0 - 2.0 * reveal);\n241\t\n242\t  float scramble = 0.0;\n243\t  for (int i = 0; i < 24; i++) {\n244\t    vec4 point = uTrail[i];\n245\t    if (point.z <= 0.0) continue;\n246\t    vec2 d = p - point.xy;\n247\t    scramble = max(scramble, point.z * exp(-dot(d, d) / (uRadius * uRadius)));\n248\t  }\n249\t  for (int i = 0; i < 4; i++) {\n250\t    vec4 c = uClicks[i];\n251\t    if (c.w <= 0.0) continue;\n252\t    float d = length(p - c.xy);\n253\t    if (uClickEffect == 1) {\n254\t      scramble = max(scramble, exp(-pow((d - c.z * 0.75) / 0.06, 2.0)) * c.w);\n255\t    } else if (uClickEffect == 2) {\n256\t      float size = 0.08 + 0.22 * (1.0 - exp(-c.z * 5.0));\n257\t      scramble = max(scramble, (1.0 - smoothstep(size * 0.6, size, d)) * c.w);\n258\t    }\n259\t  }\n260\t  vec2 t = clamp(shape.xy * mix(0.7, 1.0, reveal), 0.0, 1.0);\n261\t  vec4 mixed = mix(tone(t.x), tone(t.y), shape.z);\n262\t  vec3 color = encode(labToRgb(mixed.rgb));\n263\t  float alpha = mixed.a * reveal;\n264\t  float dither = (hash12(gl_FragCoord.xy + uFrame * 13.7) - 0.5) / 255.0;\n265\t  outColor = clamp(vec4(color * alpha + dither, alpha + dither), 0.0, 1.0);\n266\t  outAux = vec4(reveal, scramble, 0.0, 1.0);\n267\t}`;\n268\t\n269\tconst GLYPHS = `\n270\tuniform sampler2D uField;\n271\tuniform sampler2D uAux;\n272\tuniform sampler2D uAtlas;\n273\tuniform vec2 uResolution;\n274\tuniform vec2 uCell;\n275\tuniform vec2 uOffset;\n276\tuniform vec2 uAtlasGrid;\n277\tuniform float uCount;\n278\tuniform float uDensity;\n279\tuniform float uOpacity;\n280\tuniform float uFlicker;\n281\tuniform float uDepth;\n282\tuniform float uGlyphTime;\n283\tuniform float uSeedValue;\n284\tuniform float uLight;\n285\t${COMMON}\n286\tfloat sampleGlyph(float index, vec2 local, vec2 coord, float soft) {\n287\t  float column = mod(index, uAtlasGrid.x);\n288\t  float row = floor(index / uAtlasGrid.x);\n289\t  vec2 atlasUv = vec2((column + local.x) / uAtlasGrid.x, (row + 1.0 - local.y) / uAtlasGrid.y);\n290\t  vec2 continuous = coord / uAtlasGrid;\n291\t  float scale = exp2(soft);\n292\t  return textureGrad(uAtlas, atlasUv, dFdx(continuous) * scale, dFdy(continuous) * scale).a;\n293\t}\n294\t\n295\tvec4 glyphAt(vec2 px) {\n296\t  vec2 coord = (px - uOffset) / uCell;\n297\t  vec2 cell = floor(coord);\n298\t  vec2 local = coord - cell;\n299\t  vec2 uv = clamp(((cell + 0.5) * uCell + uOffset) / uResolution, vec2(0.0), vec2(1.0));\n300\t  vec4 field = texture(uField, uv);\n301\t  vec4 aux = texture(uAux, uv);\n302\t  vec3 visible = uLight > 0.5 ? field.rgb + (1.0 - field.a) : field.rgb;\n303\t  float luma = dot(visible, vec3(0.2126, 0.7152, 0.0722));\n304\t  float value = uLight > 0.5 ? clamp((1.0 - luma) * 1.5, 0.0, 1.0) : luma;\n305\t  float pick = hash12(cell + uSeedValue * 7.31);\n306\t  float level = hash12(cell * 1.73 + 4.1 + uSeedValue);\n307\t  float tick = floor(uGlyphTime * 9.0 + level * 9.0);\n308\t  float wobble = (hash12(cell * 2.31 + tick * 17.7) - 0.5) * uFlicker * 0.4 + (level - 0.5) * 0.1;\n309\t  float tone = clamp(pow(value, 0.75) + wobble, 0.0, 1.0);\n310\t  float index = floor(tone * (uCount - 1.0) + 0.5);\n311\t  float decode = max(aux.g, 1.0 - aux.r);\n312\t  if (decode > 0.02) {\n313\t    float frame = floor(uGlyphTime * 20.0);\n314\t    if (hash12(cell * 3.7 + frame * 5.3) < decode * 1.25) index = 1.0 + floor(hash12(cell + frame * 1.37) * (uCount - 1.0));\n315\t  }\n316\t  float present = step(pick, uDensity * mix(1.0, 0.3 + tone * 1.1, 0.55));\n317\t  float cutoff = smoothstep(0.03, 0.1, value);\n318\t  float focus = step(hash12(cell * 0.71 + 9.2 + uSeedValue), uDepth);\n319\t  float coverage = sampleGlyph(index, local, coord, focus * 1.2);\n320\t  float alpha = uOpacity * present * cutoff * coverage * mix(1.0, 0.35 + 0.65 * level, 0.55) * (1.0 - focus * 0.5);\n321\t  if (uLight < 0.5) {\n322\t    vec3 light = field.rgb * 0.55 + vec3(0.03) * field.a;\n323\t    return vec4(light * alpha, 0.6 * field.a * alpha);\n324\t  }\n325\t  vec3 ink = visible * 0.8;\n326\t  return vec4(ink * alpha, alpha);\n327\t}\n328\t`;\n329\t\n330\tconst HALO = `#version 300 es\n331\tprecision highp float;\n332\tuniform float uDownscale;\n333\tin vec2 vUv;\n334\tout vec4 outColor;\n335\t${GLYPHS}\n336\tvoid main() {\n337\t  outColor = glyphAt(gl_FragCoord.xy * uDownscale);\n338\t}`;\n339\t\n340\tconst BLUR = `#version 300 es\n341\tprecision highp float;\n342\tuniform sampler2D uSource;\n343\tuniform vec2 uStep;\n344\tin vec2 vUv;\n345\tout vec4 outColor;\n346\tvoid main() {\n347\t  vec4 sum = texture(uSource, vUv) * 0.2270270270;\n348\t  sum += texture(uSource, vUv + uStep * 1.3846153846) * 0.3162162162;\n349\t  sum += texture(uSource, vUv - uStep * 1.3846153846) * 0.3162162162;\n350\t  sum += texture(uSource, vUv + uStep * 3.2307692308) * 0.0702702703;\n351\t  sum += texture(uSource, vUv - uStep * 3.2307692308) * 0.0702702703;\n352\t  outColor = sum;\n353\t}`;\n354\t\n355\tconst COMPOSITE = `#version 300 es\n356\tprecision highp float;\n357\tuniform sampler2D uHalo;\n358\tuniform float uGlow;\n359\tuniform float uGradient;\n360\tuniform float uGrain;\n361\tuniform float uFrame;\n362\tin vec2 vUv;\n363\tout vec4 outColor;\n364\t${GLYPHS}\n365\tvoid main() {\n366\t  vec4 base = texture(uField, vUv) * uGradient;\n367\t  vec4 glyph = glyphAt(gl_FragCoord.xy);\n368\t  vec4 halo = texture(uHalo, vUv) * uGlow;\n369\t  vec4 color;\n370\t  if (uLight < 0.5) {\n371\t    color = base + glyph + halo;\n372\t  } else {\n373\t    color = glyph + base * (1.0 - glyph.a);\n374\t    color += halo * 0.6 * (1.0 - color.a);\n375\t  }\n376\t  float grain = (hash12(gl_FragCoord.xy + uFrame * vec2(17.0, 59.0)) + hash12(gl_FragCoord.xy * 1.31 + uFrame * 7.0) - 1.0) * uGrain;\n377\t  float body = clamp(color.a, 0.0, 1.0);\n378\t  color.rgb += grain * (0.25 + body) * 0.5;\n379\t  color.a = clamp(color.a, 0.0, 1.0);\n380\t  color.rgb = clamp(color.rgb, 0.0, color.a);\n381\t  outColor = color;\n382\t}`;\n383\t\n384\tconst clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));\n385\t\n386\tconst toLinear = (value: number) => (value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4);\n387\t\n388\tconst toLab = ([r, g, b]: number[]): number[] => {\n389\t  const lr = toLinear(r);\n390\t  const lg = toLinear(g);\n391\t  const lb = toLinear(b);\n392\t  const l = Math.cbrt(0.4122214708 * lr + 0.5363325363 * lg + 0.0514459929 * lb);\n393\t  const m = Math.cbrt(0.2119034982 * lr + 0.6806995451 * lg + 0.1073969566 * lb);\n394\t  const s = Math.cbrt(0.0883024619 * lr + 0.2817188376 * lg + 0.6299787005 * lb);\n395\t  return [\n396\t    0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,\n397\t    1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,\n398\t    0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s\n399\t  ];\n400\t};\n401\t\n402\tconst compile = (gl: WebGL2RenderingContext, type: number, source: string) => {\n403\t  const shader = gl.createShader(type);\n404\t  if (!shader) return null;\n405\t  gl.shaderSource(shader, source);\n406\t  gl.compileShader(shader);\n407\t  if (gl.getShaderParameter(shader, gl.COMPILE_STATUS)) return shader;\n408\t  gl.deleteShader(shader);\n409\t  return null;\n410\t};\n411\t\n412\tconst link = (gl: WebGL2RenderingContext, fragmentSource: string): Program | null => {\n413\t  const vertex = compile(gl, gl.VERTEX_SHADER, VERTEX);\n414\t  const fragment = compile(gl, gl.FRAGMENT_SHADER, fragmentSource);\n415\t  const program = gl.createProgram();\n416\t  if (!vertex || !fragment || !program) return null;\n417\t  gl.attachShader(program, vertex);\n418\t  gl.attachShader(program, fragment);\n419\t  gl.linkProgram(program);\n420\t  gl.deleteShader(vertex);\n421\t  gl.deleteShader(fragment);\n422\t  if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {\n423\t    gl.deleteProgram(program);\n424\t    return null;\n425\t  }\n426\t  const uniforms: Record<string, WebGLUniformLocation | null> = {};\n427\t  const count = gl.getProgramParameter(program, gl.ACTIVE_UNIFORMS);\n428\t  for (let i = 0; i < count; i++) {\n429\t    const info = gl.getActiveUniform(program, i);\n430\t    if (!info) continue;\n431\t    const name = info.name.replace(/\\[0\\]$/, '');\n432\t    uniforms[name] = gl.getUniformLocation(program, name);\n433\t  }\n434\t  return { program, uniforms };\n435\t};\n436\t\n437\tconst createTarget = (gl: WebGL2RenderingContext, count: number): Target => {\n438\t  const textures = Array.from({ length: count }, () => {\n439\t    const texture = gl.createTexture();\n440\t    gl.bindTexture(gl.TEXTURE_2D, texture);\n441\t    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\n442\t    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);\n443\t    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\n444\t    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\n445\t    return texture;\n446\t  });\n447\t  return { textures, framebuffer: gl.createFramebuffer(), width: 0, height: 0 };\n448\t};\n449\t\n450\tconst sizeTarget = (gl: WebGL2RenderingContext, target: Target, width: number, height: number) => {\n451\t  if (target.width === width && target.height === height) return;\n452\t  target.width = width;\n453\t  target.height = height;\n454\t  gl.bindFramebuffer(gl.FRAMEBUFFER, target.framebuffer);\n455\t  target.textures.forEach((texture, i) => {\n456\t    gl.bindTexture(gl.TEXTURE_2D, texture);\n457\t    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, width, height, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);\n458\t    gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0 + i, gl.TEXTURE_2D, texture, 0);\n459\t  });\n460\t  gl.bindFramebuffer(gl.FRAMEBUFFER, null);\n461\t};\n462\t\n463\tconst buildAtlas = (gl: WebGL2RenderingContext, characters: string, fontFamily: string): Atlas => {\n464\t  const list = [...new Set([...characters].filter(char => char !== '\\n' && char !== '\\r'))];\n465\t  if (!list.length) list.push(' ');\n466\t  const font = `300 ${Math.round(ATLAS_CELL_H * FONT_SCALE)}px ${fontFamily}`;\n467\t  const columns = Math.min(ATLAS_COLUMNS, list.length);\n468\t  const rows = Math.ceil(list.length / columns);\n469\t  const canvas = document.createElement('canvas');\n470\t  canvas.width = ATLAS_CELL_W * columns;\n471\t  canvas.height = ATLAS_CELL_H * rows;\n472\t  const context = canvas.getContext('2d');\n473\t  if (context) {\n474\t    context.font = font;\n475\t    context.textAlign = 'center';\n476\t    context.textBaseline = 'middle';\n477\t    context.fillStyle = '#fff';\n478\t    list.forEach((char, index) => {\n479\t      const column = index % columns;\n480\t      const row = Math.floor(index / columns);\n481\t      context.fillText(char, column * ATLAS_CELL_W + ATLAS_CELL_W / 2, row * ATLAS_CELL_H + ATLAS_CELL_H / 2 + 3);\n482\t    });\n483\t  }\n484\t  const texture = gl.createTexture();\n485\t  gl.bindTexture(gl.TEXTURE_2D, texture);\n486\t  gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, false);\n487\t  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, gl.RGBA, gl.UNSIGNED_BYTE, canvas);\n488\t  gl.generateMipmap(gl.TEXTURE_2D);\n489\t  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);\n490\t  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);\n491\t  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\n492\t  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\n493\t  return { texture, count: list.length, grid: [columns, rows] };\n494\t};\n495\t\n496\tconst GradientASCII = ({\n497\t  colors = DEFAULT_COLORS,\n498\t  shape = 'horizon',\n499\t  characters = DEFAULT_CHARACTERS,\n500\t  cellSize = 18,\n501\t  density = 0.8,\n502\t  glyphOpacity = 0.85,\n503\t  glow = 0.2,\n504\t  depthOfField = 0,\n505\t  flicker = 0.2,\n506\t  softness = 0.5,\n507\t  scale = 1,\n508\t  flow = 0.5,\n509\t  speed = 1,\n510\t  gradientOpacity = 0.9,\n511\t  grain = 0.08,\n512\t  variation = 0,\n513\t  mouseInteraction = true,\n514\t  scrambleRadius = 0.1,\n515\t  clickEffect = 'wave',\n516\t  intro = true,\n517\t  lightMode = false,\n518\t  fontFamily = DEFAULT_FONT,\n519\t  dpr,\n520\t  className = '',\n521\t  style,\n522\t  ...rest\n523\t}: GradientASCIIProps) => {\n524\t  const containerRef = useRef<HTMLDivElement>(null);\n525\t  const canvasRef = useRef<HTMLCanvasElement>(null);\n526\t  const wakeRef = useRef<(() => void) | null>(null);\n527\t  const palette = (Array.isArray(colors) && colors.length ? colors : DEFAULT_COLORS).slice(0, MAX_COLORS);\n528\t  const settings: Settings = {\n529\t    colors: palette.length > 1 ? palette : [palette[0], palette[0]],\n530\t    shape: SHAPES[shape] ?? 0,\n531\t    characters: characters || DEFAULT_CHARACTERS,\n532\t    cellSize: clamp(cellSize, 6, 64),\n533\t    density: clamp(density, 0, 1),\n534\t    glyphOpacity: clamp(glyphOpacity, 0, 1),\n535\t    glow: clamp(glow, 0, 2),\n536\t    depthOfField: clamp(depthOfField, 0, 1),\n537\t    flicker: clamp(flicker, 0, 1),\n538\t    s