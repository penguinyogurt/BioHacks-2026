 (key === paletteKey) return;\n640\t      paletteKey = key;\n641\t      s.colors.forEach((color, i) => ramp.set(toLab(parse(color)), i * 3));\n642\t    };\n643\t\n644\t    const bindGlyphs = (program: Program, width: number, height: number) => {\n645\t      if (!atlas) return;\n646\t      const s = settingsRef.current;\n647\t      const u = program.uniforms;\n648\t      const cellH = s.cellSize * view.ratio;\n649\t      const cellW = cellH * (ATLAS_CELL_W / ATLAS_CELL_H);\n650\t      gl.activeTexture(gl.TEXTURE0);\n651\t      gl.bindTexture(gl.TEXTURE_2D, fieldTarget.textures[0]);\n652\t      gl.uniform1i(u.uField, 0);\n653\t      gl.activeTexture(gl.TEXTURE1);\n654\t      gl.bindTexture(gl.TEXTURE_2D, fieldTarget.textures[1]);\n655\t      gl.uniform1i(u.uAux, 1);\n656\t      gl.activeTexture(gl.TEXTURE2);\n657\t      gl.bindTexture(gl.TEXTURE_2D, atlas.texture);\n658\t      gl.uniform1i(u.uAtlas, 2);\n659\t      gl.uniform2f(u.uResolution, width, height);\n660\t      gl.uniform2f(u.uCell, cellW, cellH);\n661\t      gl.uniform2f(\n662\t        u.uOffset,\n663\t        (width - Math.ceil(width / cellW) * cellW) / 2,\n664\t        (height - Math.ceil(height / cellH) * cellH) / 2\n665\t      );\n666\t      gl.uniform2f(u.uAtlasGrid, atlas.grid[0], atlas.grid[1]);\n667\t      gl.uniform1f(u.uCount, atlas.count);\n668\t      gl.uniform1f(u.uDensity, s.density);\n669\t      gl.uniform1f(u.uOpacity, s.glyphOpacity);\n670\t      gl.uniform1f(u.uFlicker, reduce ? 0 : s.flicker);\n671\t      gl.uniform1f(u.uDepth, s.depthOfField);\n672\t      gl.uniform1f(u.uGlyphTime, glyphTime);\n673\t      gl.uniform1f(u.uSeedValue, s.variation);\n674\t      gl.uniform1f(u.uLight, s.lightMode ? 1 : 0);\n675\t    };\n676\t\n677\t    const draw = () => {\n678\t      const s = settingsRef.current;\n679\t      const aspect = view.width / view.height;\n680\t      syncAtlas();\n681\t      syncPalette();\n682\t      gl.bindVertexArray(vao);\n683\t      gl.disable(gl.BLEND);\n684\t\n685\t      gl.