/ Where the signal leaves the cell: centre of the terminal tips, and the far end of the neuron.\n    const tipCenter = tips.reduce((a, t) => a.add(t), new THREE.Vector3()).divideScalar(Math.max(1, tips.length))\n    const endX = tips.reduce((m, t) => Math.max(m, t.x), -Infinity)\n    return { mesh, tips, tipCenter, endX, points, pos, life, vel: new Float32Array(count * 3) }\"\"\")\nr2(\"\"\"    // The pulse has crossed the terminals: hand its screen position to the page.\n    const tc = sparks.tipCenter\n    if (onTerminals && sparks.mesh && c.prevFront < tc.x && front >= tc.x) {\"\"\",\"\"\"    // The pulse has reached the very end of the neuron: hand the terminals' screen position to the page.\n    const tc = sparks.tipCenter\n    if (onTerminals && sparks.mesh && c.prevFront < sparks.endX && front >= sparks.endX) {\"\"\")\nopen(p,'w',encoding='utf8').write(s)\nPYEOF\ngrep -n \"uFront.value = front < TIP_X\" src/components/neuron-viewer.tsx; npx tsc -b 2>&1 | head","description":"Hide comet outside travel; trigger at far end","timeout":120000},"caller":{"type":"direct"}}]}}
