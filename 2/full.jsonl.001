{"parentUuid":"3ed89860-c74e-4079-87a8-14d8db98be3d","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\neuron-viewer.tsx","snippet":"","rereadEntry":{"timestamp":1794093355676,"contentHash":"1tqzimwb17tsf","contentLength":10648}},"type":"attachment","uuid":"a69e5197-3ec7-4a9b-80b0-0b30bd2d5e6b","timestamp":"2026-11-07T23:16:06.462Z","rendered":[{"content":"<system-reminder>\nNote: C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\neuron-viewer.tsx changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. The changes are not shown here; use Read if you need the current content.\n</system-reminder>"}],"renderedRole":"system","session_id":"28437234-f1be-440d-9452-c51de1bd38ab","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\jerem\\BioHacks-2026\\frontend","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","version":"2.1.319","gitBranch":"frontend/diagnosis"}
{"type":"api-request-blob","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","hash":"762c3c35bbeb9f8c90bc7df892b6e66f40780e19aa57573c73cca0293310f57c","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_01K8AbJ5UFS95oSDExxzsVH5","name":"Edit","input":{"file_path":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\neuron-viewer.tsx","old_string":"const MODEL_URL = '/models/neuron.glb'\nconst MODEL_SIZE = 13 // long axis, world units\nconst COLOR = '#2f5f6b' // teal ink\nconst OPACITY = 0.55\nconst AUTO_ROTATE_SPEED = 2.2\n\nfunction Neuron({ onLoaded }: { onLoaded: () => void }) {\n  const gltf = useLoader(GLTFLoader, MODEL_URL)\n\n  const { model, center, scale } = useMemo(() => {\n    const model = gltf.scene.clone(true)\n    model.updateMatrixWorld(true)\n    const box = new THREE.Box3().setFromObject(model)\n    const size = box.getSize(new THREE.Vector3())\n    return { model, center: box.getCenter(new THREE.Vector3()), scale: MODEL_SIZE / (Math.max(size.x, size.y, size.z) || 1) }\n  }, [gltf])\n\n  useEffect(() => {\n    model.traverse((node) => {\n      const mesh = node as THREE.Mesh\n      if (!mesh.isMesh) return\n      mesh.frustumCulled = false\n      for (const m of Array.isArray(mesh.material) ? mesh.material : [mesh.material]) {\n        if ('color' in m && m.color instanceof THREE.Color) m.color.set(COLOR)\n        m.transparent = true\n        m.opacity = OPACITY\n        m.depthWrite = false\n      }\n    })\n    onLoaded()\n  }, [model, onLoaded])","new_string":"const MODEL_URL = '/models/neuron.glb'\nconst MODEL_SIZE = 13 // long axis, world units\nconst COLOR = '#2f5f6b' // teal ink\nconst PULSE = '#0b7f8f' // saturated teal: signals darken and saturate the membrane, never glow\nconst OPACITY = 0.55\nconst AUTO_ROTATE_SPEED = 2.2\n\n/*\n * Landmarks in the model's own mesh coordinates (long axis = x), measured from\n * its vertices: soma centre, where the axon leaves it, where the terminals begin.\n */\nconst SOMA = new THREE.Vector3(-1.0, 0.0, 0.2)\nconst HILLOCK_X = -0.3\nconst AXON_END = new THREE.Vector3(1.35, 0.1, 0.1)\nconst TIP_X = 2.45\n\n/* One firing, in seconds from its start. */\nconst INPUT_S = 0.45 // dendritic inputs converge on the soma\nconst AP_SPEED = 2.6 // mesh units / s down the axon\nconst BURST = 10 // particles per terminal\n\nconst pulseVert = /* glsl */ `\nvarying vec3 vPos;`\nconst pulseFrag = /* glsl */ `\nvarying vec3 vPos;\nuniform vec3 uPulse;\nuniform vec3 uSomaC;\nuniform float uFront;\nuniform float uInward;\nuniform float uSoma;`\nconst pulseApply = /* glsl */ `\n  {\n    float axon = step(${HILLOCK_X.toFixed(2)}, vPos.x);\n    float dA = vPos.x - uFront;\n    float wave = exp(-dA * dA * 30.0) * axon;\n    float r = length(vPos - uSomaC);\n    float dI = r - uInward;\n    float inward = exp(-dI * dI * 30.0) * (1.0 - axon) * step(0.0, uInward);\n    float soma = uSoma * (1.0 - smoothstep(0.35, 0.8, r));\n    float k = clamp(wave + inward * 0.7 + soma * 0.6, 0.0, 1.0);\n    diffuseColor.rgb = mix(diffuseColor.rgb, uPulse, k);\n    diffuseColor.a = mix(diffuseColor.a, 0.95, k);\n  }`\n\nconst particleVS = /* glsl */ `\nattribute float aLife;\nuniform float uSize;\nvarying float vLife;\nvoid main() {\n  vLife = aLife;\n  gl_PointSize = uSize * (0.6 + 0.4 * aLife);\n  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n}`\nconst particleFS = /* glsl */ `\nuniform vec3 uColor;\nvarying float vLife;\nvoid main() {\n  float d = length(gl_PointCoord - 0.5);\n  if (d > 0.5) discard;\n  gl_FragColor = vec4(uColor, vLife * 0.75 * (1.0 - smoothstep(0.3, 0.5, d)));\n}`\n\n/** Terminal tips: farthest-point sample of the vertices past the axon. */\nfunction terminalTips(geo: THREE.BufferGeometry, n: number) {\n  const pos = geo.attributes.position as THREE.BufferAttribute\n  const pts: THREE.Vector3[] = []\n  for (let i = 0; i < pos.count; i++) {\n    const v = new THREE.Vector3().fromBufferAttribute(pos, i)\n    if (v.x > 1.75) pts.push(v)\n  }\n  if (!pts.length) return []\n  const picked = [pts.reduce((a, b) => (b.x > a.x ? b : a))]\n  const best = pts.map((p) => p.distanceToSquared(picked[0]))\n  while (picked.length < Math.min(n, pts.length)) {\n    let k = 0\n    for (let i = 1; i < best.length; i++) if (best[i] > best[k]) k = i\n    picked.push(pts[k])\n    for (let i = 0; i < pts.length; i++) best[i] = Math.min(best[i], pts[i].distanceToSquared(pts[k]))\n  }\n  return picked\n}\n\nfunction Neuron({ onLoaded, firing }: { onLoaded: () => void; firing: boolean }) {\n  const gltf = useLoader(GLTFLoader, MODEL_URL)\n  const dpr = useThree((s) => s.viewport.dpr)\n\n  const { model, center, scale } = useMemo(() => {\n    const model = gltf.scene.clone(true)\n    model.updateMatrixWorld(true)\n    const box = new THREE.Box3().setFromObject(model)\n    const size = box.getSize(new THREE.Vector3())\n    return { model, center: box.getCenter(new THREE.Vector3()), scale: MODEL_SIZE / (Math.max(size.x, size.y, size.z) || 1) }\n  }, [gltf])\n\n  /** Shared by every membrane material; driven from useFrame. */\n  const uniforms = useMemo(\n    () => ({\n      uPulse: { value: new THREE.Color(PULSE) },\n      uSomaC: { value: SOMA.clone() },\n      uFront: { value: -10 },\n      uInward: { value: -1 },\n      uSoma: { value: 0 },\n    }),\n    [],\n  )\n\n  const sparks = useMemo(() => {\n    let mesh: THREE.Mesh | undefined\n    model.traverse((n) => {\n      if (!mesh && (n as THREE.Mesh).isMesh) mesh = n as THREE.Mesh\n    })\n    const tips = mesh ? terminalTips(mesh.geometry, 8) : []\n    const count = Math.max(1, tips.length * BURST)\n    const geo = new THREE.BufferGeometry()\n    const pos = new Float32Array(count * 3)\n    const life = new Float32Array(count)\n    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3))\n    geo.setAttribute('aLife', new THREE.BufferAttribute(life, 1))\n    const mat = new THREE.ShaderMaterial({\n      vertexShader: particleVS,\n      fragmentShader: particleFS,\n      uniforms: { uColor: { value: new THREE.Color(PULSE) }, uSize: { value: 4 } },\n      transparent: true,\n      depthWrite: false,\n    })\n    const points = new THREE.Points(geo, mat)\n    points.frustumCulled = false\n    mesh?.add(points) // lives in mesh space, so it turns with the neuron\n    return { tips, points, pos, life, vel: new Float32Array(count * 3) }\n  }, [model])\n\n  useEffect(() => {\n    model.traverse((node) => {\n      const mesh = node as THREE.Mesh\n      if (!mesh.isMesh) return\n      mesh.frustumCulled = false\n      const mats = (Array.isArray(mesh.material) ? mesh.material : [mesh.material]).map((src) => {\n        const m = src.clone() as THREE.MeshStandardMaterial\n        m.color.set(COLOR)\n        m.transparent = true\n        m.opacity = OPACITY\n        m.depthWrite = false\n        m.onBeforeCompile = (shader) => {\n          Object.assign(shader.uniforms, uniforms)\n          shader.vertexShader = shader.vertexShader\n            .replace('#include <common>', `#include <common>${pulseVert}`)\n            .replace('#include <begin_vertex>', '#include <begin_vertex>\\n  vPos = position;')\n          shader.fragmentShader = shader.fragmentShader\n            .replace('#include <common>', `#include <common>${pulseFrag}`)\n            .replace('#include <color_fragment>', `#include <color_fragment>${pulseApply}`)\n        }\n        m.customProgramCacheKey = () => 'motus-pulse'\n        return m\n      })\n      mesh.material = Array.isArray(mesh.material) ? mats : mats[0]\n    })\n    onLoaded()\n    return () => {\n      sparks.points.geometry.dispose()\n      ;(sparks.points.material as THREE.Material).dispose()\n      sparks.points.removeFromParent()\n    }\n  }, [model, onLoaded, uniforms, sparks])\n\n  // Firing loop: inputs converge → soma darkens → action potential runs to the terminals → release.\n  const clock = useRef({ t: -1.2, next: 2.8, prevFront: -10 })\n  useFrame((_, delta) => {\n    sparks.points.material.uniforms.uSize.value = 4 * dpr\n    const c = clock.current\n    const dt = Math.min(delta, 0.05)\n    if (firing) {\n      c.t += dt\n      if (c.t > c.next) {\n        c.t = 0\n        c.next = 2.6 + Math.random() * 1.2\n      }\n    }\n    const t = c.t\n    uniforms.uInward.value = t >= 0 && t < INPUT_S ? 1.6 - (1.05 * t) / INPUT_S : -1\n    uniforms.uSoma.value = t >= 0 ? Math.exp(-(((t - INPUT_S) / 0.2) ** 2)) : 0\n    const front = t >= INPUT_S ? HILLOCK_X + (t - INPUT_S) * AP_SPEED : -10\n    uniforms.uFront.value = front < TIP_X + 0.3 ? front : -10\n\n    // Release at each terminal as the front reaches it.\n    const { tips, pos, life, vel, points } = sparks\n    tips.forEach((tip, j) => {\n      if (c.prevFront < tip.x && front >= tip.x) {\n        const dir = tip.clone().sub(AXON_END).normalize()\n        for (let k = 0; k < BURST; k++) {\n          const i = j * BURST + k\n          pos[i * 3] = tip.x\n          pos[i * 3 + 1] = tip.y\n          pos[i * 3 + 2] = tip.z\n          const sp = 0.12 + Math.random() * 0.2\n          vel[i * 3] = (dir.x * 0.8 + (Math.random() - 0.5)) * sp\n          vel[i * 3 + 1] = (dir.y * 0.8 + (Math.random() - 0.5)) * sp\n          vel[i * 3 + 2] = (dir.z * 0.8 + (Math.random() - 0.5)) * sp\n          life[i] = 1\n        }\n      }\n    })\n    c.prevFront = front\n    for (let i = 0; i < life.length; i++) {\n      if (life[i] <= 0) continue\n      life[i] = Math.max(0, life[i] - dt / 1.1)\n      pos[i * 3] += vel[i * 3] * dt\n      pos[i * 3 + 1] += vel[i * 3 + 1] * dt\n      pos[i * 3 + 2] += vel[i * 3 + 2] * dt\n    }\n    points.geometry.attributes.position.needsUpdate = true\n    points.geometry.attributes.aLife.needsUpdate = true\n  })"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01Xt1SFszFsDPsoUUJVSb4Jw","name":"Bash","input":{"command":"cd /c/Users/jerem/BioHacks-2026/frontend && python - <<'EOF'\np='src/components/neuron-viewer.tsx'\ns=open(p,encoding='utf8').read()\ndef r(a,b):\n    global s\n    assert a in s, a[:60]; s=s.replace(a,b)\nr(\"import { Suspense, useEffect, useMemo, useState } from 'react'\",\"import { Suspense, useEffect, useMemo, useRef, useState } from 'react'\")\nr(\"\"\"/**\n * The neuron, standing upright and spinning about its long axis.\"\"\",\"\"\"/**\n * The neuron, standing upright, spinning about its long axis and firing every\n * few seconds: inputs converge, the soma deepens, a band of colour runs down\n * the axon, and the terminals release a puff of transmitter.\"\"\")\nr(\"          <Neuron onLoaded={onLoaded} />\",\"          <Neuron onLoaded={onLoaded} firing={!reducedMotion} />\")\nopen(p,'w',encoding='utf8').write(s)\nEOF\nnpx tsc -b 2>&1 | head","description":"Wire firing into viewer and typecheck","timeout":120000},"caller":{"type":"direct"}}]}}
