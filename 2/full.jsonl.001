{"type":"session-owner","accountUuid":"1084d356-36b6-41ff-8323-ec7e95607830","organizationUuid":"1883b197-822a-4d41-8a18-67d9677f55f6","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab"}
