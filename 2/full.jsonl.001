 </div>","-      <ReportBody patient={patient} weights={weights} date={date} />","-      {/* Print-only copy outside #root, so the PDF is just the report. */}","-      {createPortal(","-        <div className=\"print-only\">","-          <ReportBody patient={patient} weights={weights} date={date} />","-        </div>,","-        document.body,","-      )}","-    </div>","-  )","-}","+import { createPortal } from 'react-dom'\r","+import { Download } from 'lucide-react'\r","+import { Badge } from '@/components/ui/badge'\r","+import { Button } from '@/components/ui/button'\r","+import { CRITERIA, EXCLUDED, PROFILES, REFERENCES, rank, CANDIDATES, type Patient, type Weights } from '@/lib/pipeline'\r","+import { LANE_COLORS } from './lanes'\r","+\r","+function Cite({ ns }: { ns: number[] }) {\r","+  if (!ns.length) return null\r","+  return <sup className=\"ml-0.5 text-[0.7em] text-muted-foreground\">[{ns.join(', ')}]</sup>\r","+}\r","+\r","+function ReportBody({ patient, weights, date, caseName }: { patient: Patient; weights: Weights; date: string; caseName?: string | null }) {\r","+  const ranked = rank(CANDIDATES, weights)\r","+  const enabled = CRITERIA.filter((c) => weights[c.key])\r","+  return (\r","+    <article className=\"report text-sm leading-relaxed\">\r","+      <header className=\"border-b pb-4\">\r","+        <p className=\"eyebrow\">Addo Labs · discovery report</p>\r","+        <h1 className=\"font-brand mt-2 text-3xl leading-tight\">Alternative therapeutic candidates for {patient.label}</h1>\r","+        <p className=\"mt-2 text-muted-foreground\">\r","+          {date} · {patient.onset}, ALSFRS-R {patient.alsfrs}/48 · Delivery assumption: MRgFUS blood–brain barrier opening\r","+        </p>\r","+        <p className=\"mt-1 text-xs text-muted-foreground\">Case source: {caseName ?? 'built-in sample patient'}</p>\r","+      </header>\r","+\r","+      <section className=\"mt-5\">\r","+        <h2 className=\"text-base font-semibold\">Summary</h2>\r","+        <p className=\"mt-2\">\r","+          Most drugs that could act on ALS pathology never reach the motor cortex: the blood–brain barrier excludes nearly all\r","+          large molecules and most small ones.<Cite ns={[7]} /> MR-guided focused ultrasound has opened the barrier safely over\r","+          motor cortex in people with ALS,<Cite ns={[1]} /> which makes approved biologics a new search space. Five profile agents\r","+          proposed ideal-drug profiles for this patient; each was matched against compounds in the DRKG knowledge graph\r","+          <Cite ns={[2]} /> and the strongest matches were ranked for this patient. The top candidate is{' '}\r","+          <strong>{ranked[0].drug}</strong> ({ranked[0].overall}/100).\r","+        </p>\r","+      </section>\r","+\r","+      <section className=\"mt-5\">\r","+        <h2 className=\"text-base font-semibold\">Patient context</h2>\r","+        <ul className=\"mt-2 list-disc space-y-0.5 pl-5\">\r","+          <li>{patient.age}{patient.sex}, {patient.onset.toLowerCase()}, {patient.monthsSinceDx} months since diagnosis; slope {patient.slope} pts/month; FVC {patient.fvc}%.</li>\r","+          <li>Genetics: {patient.genetics}.</li>\r","+          <li>Current medication: {patient.medications.join(', ')}. Conditions: {patient.comorbidities.join(', ')}.</li>\r","+          <li>{patient.location} · {patient.coverage}. Preferences: {patient.preferences.join('; ')}.</li>\r","+        </ul>\r","+      </section>\r","+\r","+      <section className=\"mt-5\">\r","+        <h2 className=\"text-base font-semibold\">Method</h2>\r","+        <p className=\"mt-2\">\r","+          Profiles: {PROFILES.map((p) => p.name).join(' · ')}. Ranking criteria: {enabled.map((c) => c.label).join(', ')}\r","+          {weights.fit ? ' (mechanistic fit weighted ×2)' : ''}.\r","+        </p>\r","+      </section>\r","+\r","+      <section className=\"mt-5\">\r","+        <h2 className=\"text-base font-semibold\">Ranked candidates</h2>\r","+        <ol className=\"mt-3 space-y-4\">\r","+          {ranked.map((c, i) => (\r","+            <li key={c.drug} className=\"break-inside-avoid rounded-lg border p-4\">\r","+              <div className=\"flex flex-wrap items-baseline justify-between gap-2\">\r","+                <h3 className=\"text-base font-semibold\">\r","+                  {i + 1}. {c.drug} <span className=\"font-normal text-muted-foreground\">— {c.cls}</span>\r","+                </h3>\r","+                <span className=\"tabular-nums\">{c.overall}/100</span>\r","+              </div>\r","+              <p className=\"mt-1 text-xs text-muted-foreground\">\r","+                <span className=\"mr-1 inline-block size-2 rounded-full align-middle\" style={{ background: LANE_COLORS[c.lane] }} />\r","+                {PROFILES[c.lane].name} profile · {c.sizeKDa} kDa · BBB alone: {c.bbbAlone} · With MRgFUS: {c.withFus}\r","+              </p>\r","+              <p className=\"mt-2\">{c.rationale}<Cite ns={c.cites} /></p>\r","+              <dl className=\"mt-2 grid gap-x-4 gap-y-1 sm:grid-cols-[9rem_1fr]\">\r","+                <dt className=\"text-muted-foreground\">Evidence</dt><dd>{c.evidence}</dd>\r","+                <dt className=\"text-muted-foreground\">Safety</dt><dd>{c.safety}</dd>\r","+                <dt className=\"text-muted-foreground\">Cost</dt><dd>{c.cost}</dd>\r","+                <dt className=\"text-muted-foreground\">Availability</dt><dd>{c.availability}</dd>\r","+                <dt className=\"text-muted-foreground\">Acceptance</dt><dd>{c.acceptance}</dd>\r","+              </dl>\r","+            </li>\r","+          ))}\r","+        </ol>\r","+      </section>\r","+\r","+      <section className=\"mt-5\">\r","+        <h2 className=\"text-base font-semibold\">Excluded for this patient</h2>\r","+        <ul className=\"mt-2 list-disc space-y-0.5 pl-5\">\r","+          {EXCLUDED.map((e) => (\r","+            <li key={e.drug}><strong>{e.drug}</strong> — {e.reason}<Cite ns={e.cites} /></li>\r","+          ))}\r","+        </ul>\r","+      </section>\r","+\r","+      <section className=\"mt-5\">\r","+        <h2 className=\"text-base font-semibold\">Limitations</h2>\r","+        <p className=\"mt-2\">\r","+          Hypothesis-generating output for discussion with the care team, not a treatment recommendation. Embedding similarity\r","+          reflects knowledge-graph structure, not demonstrated efficacy. CNS exposure after focused-ultrasound opening has not been\r","+          measured for these drugs, and any use would need a trial or physician-led protocol.\r","+        </p>\r","+      </section>\r","+\r","+      <section className=\"mt-5\">\r","+        <h2 className=\"text-base font-semibold\">References</h2>\r","+        <ol className=\"mt-2 space-y-1\">\r","+          {REFERENCES.map((r) => (\r","+            <li key={r.n} className=\"flex gap-2\">\r","+              <span className=\"w-6 shrink-0 text-muted-foreground tabular-nums\">[{r.n}]</span>\r","+              <a href={r.url} target=\"_blank\" rel=\"noreferrer\" className=\"underline decoration-foreground/25 underline-offset-2 hover:decoration-foreground\">\r","+                {r.text}\r","+              </a>\r","+            </li>\r","+          ))}\r","+        </ol>\r","+      </section>\r","+    </article>\r","+  )\r","+}\r","+\r","+export function Report({ patient, weights, date, caseName }: { patient: Patient; weights: Weights; date: string; caseName?: string | null }) {\r","+  return (\r","+    <div>\r","+      <div className=\"mb-4 flex flex-wrap items-center justify-between gap-3\">\r","+        <Badge variant=\"outline\" className=\"border-watch/40 bg-watch/10 font-normal text-watch\">Simulated run · illustrative outputs</Badge>\r","+        <Button size=\"sm\" variant=\"outline\" onClick={() => window.print()}>\r","+          <Download aria-hidden /> Save as PDF\r","+        </Button>\r","+      </div>\r","+      <ReportBody patient={patient} weights={weights} date={date} caseName={caseName} />\r","+      {/* Print-only copy outside #root, so the PDF is just the report. */}\r","+      {createPortal(\r","+        <div className=\"print-only\">\r","+          <ReportBody patient={patient} weights={weights} date={date} caseName={caseName} />\r","+        </div>,\r","+        document.body,\r","+      )}\r","+    </div>\r","+  )\r","+}\r"]}]},{"filePath":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\discovery\\runs.tsx","hunks":[{"oldStart":1,"oldLines":71,"newStart":1,"newLines":72,"lines":["-import { useState } from 'react'","-import { ArrowLeft, FileText } from 'lucide-react'","-import { Button } from '@/components/ui/button'","-import { SAMPLE_PATIENT, rank, CANDIDATES } from '@/lib/pipeline'","-import { Report } from './report'","-import type { CompletedRun } from './workspace'","-","-/** Saved runs as paper previews (Callio Labs' Projects panel, for reports). */","-export default function Runs({ runs, onNewRun }: { runs: CompletedRun[]; onNewRun: () => void }) {","-  const [open, setOpen] = useState<CompletedRun | null>(null)","-","-  if (open) {","-    return (","-      <div className=\"mx-auto max-w-4xl\">","-        <Button size=\"sm\" variant=\"ghost\" className=\"mb-3\" onClick={() => setOpen(null)}>","-          <ArrowLeft aria-hidden /> All runs","-        </Button>","-        <div className=\"rounded-xl bg-card p-6 ring-1 ring-border backdrop-blur-md\">","-          <Report patient={SAMPLE_PATIENT} weights={open.weights} date={open.date} />","-        </div>","-      </div>","-    )","-  }","-","-  return (","-    <div className=\"mx-auto max-w-[1440px]\">","-      <div className=\"mb-4 rounded-xl bg-card px-5 pt-5 pb-4 ring-1 ring-border backdrop-blur-md\">","-        <p className=\"eyebrow\">Discovery / Runs & reports</p>","-        <h2 className=\"font-brand mt-3 text-[clamp(2.25rem,3.6vw,3.25rem)] leading-none\">Every run, with its evidence.</h2>","-      </div>","-      {runs.length === 0 ?