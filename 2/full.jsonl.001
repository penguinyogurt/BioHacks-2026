ctive: string","   onSelect: (view: string) => void","   profile: Profile","   onSignOut?: () => void","+  /** Status per pipeline view id. */","+  steps: Record<string, StepStatus>"," }) {","   const { isMobile, setOpenMobile } = useSidebar()","   const select = (value: string) => {"]},{"oldStart":93,"oldLines":7,"newStart":108,"newLines":7,"lines":["       <SidebarHeader className=\"pt-4\">","         <SidebarMenu>","           <SidebarMenuItem>","-            <SidebarMenuButton className=\"h-auto !p-2 !pt-3 hover:bg-transparent active:bg-transparent\" onClick={() => select('discovery')}>","+            <SidebarMenuButton className=\"h-auto !p-2 !pt-3 hover:bg-transparent active:bg-transparent\" onClick={() => select('case')}>","               <span className=\"font-brand text-3xl leading-none\">addo labs</span>","             </SidebarMenuButton>","           </SidebarMenuItem>"]},{"oldStart":115,"oldLines":10,"newStart":130,"newLines":24,"lines":["                 </SidebarMenuButton>","               </SidebarMenuItem>","             </SidebarMenu>","-            <NavList items={NAV_MAIN} active={active} select={select} />","           </SidebarGroupContent>","         </SidebarGroup>"," ","+        <SidebarGroup>","+          <SidebarGroupLabel>Pipeline</SidebarGroupLabel>","+          <SidebarMenu>","+            {NAV_PIPELINE.map((item) => (","+              <SidebarMenuItem key={item.value}>","+                <SidebarMenuButton tooltip={item.label} isActive={active === item.value} onClick={() => select(item.value)}>","+                  <span className=\"w-4 shrink-0 text-[0.6875rem] text-muted-foreground tabular-nums\">{item.n}</span>","+                  <span>{item.label}</span>","+                  <StepIcon status={steps[item.value]} />","+                </SidebarMenuButton>","+              </SidebarMenuItem>","+            ))}","+          </SidebarMenu>","+        </SidebarGroup>","+","         {NAV_GROUPS.map((group) => (","           <SidebarGroup key={group.label} className=\"group-data-[collapsible=icon]:hidden\">","             <SidebarGroupLabel>{group.label}</SidebarGroupLabel>"]},{"oldStart":173,"oldLines":12,"newStart":202,"newLines":15,"lines":["                   <DropdownMenuItem onSelect={() => select('settings')}>","                     <UserCircle /> Account","                   </DropdownMenuItem>","-                  <DropdownMenuItem onSelect={() => select('settings')}>","-                    <AlarmClock /> Notifications","+                  <DropdownMenuItem onSelect={() => select('runs')}>","+                    <Library /> Runs & reports","                   </DropdownMenuItem>","                   <DropdownMenuItem onSelect={() => select('privacy')}>","                     <BookOpen /> Data & privacy","                   </DropdownMenuItem>","+                  <DropdownMenuItem onSelect={() => select('settings')}>","+                    <AlarmClock /> Notifications","+                  </DropdownMenuItem>","                 </DropdownMenuGroup>","                 <DropdownMenuSeparator />","                 <DropdownMenuItem disabled={!onSignOut} onSelect={() => onSignOut?.()}>"]}],"originalFile":"import {\n  Activity, AlarmClock, BookOpen, CalendarDays, CirclePlus, Database, Dna, FileText, FlaskConical, LogOut, MoreVertical,\n  Network, NotebookPen, Pill, Settings, Shield, UserCircle, Users, Waves,\n} from 'lucide-react'\nimport type { LucideIcon } from 'lucide-react'\nimport { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar'\nimport {\n  DropdownMenu, DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu'\nimport {\n  Sidebar, SidebarContent, SidebarFooter, SidebarGroup, SidebarGroupContent, SidebarGroupLabel, SidebarHeader,\n  SidebarMenu, SidebarMenuButton, SidebarMenuItem, useSidebar,\n} from '@/components/ui/sidebar'\n\ntype NavItem = { value: string; label: string; icon: LucideIcon }\n\n/** Callio Labs' sidebar shape: primary action, main nav, labelled groups, secondary links pinned low. */\nexport const NAV_MAIN: NavItem[] = [\n  { value: 'discovery', label: 'Discovery', icon: FlaskConical },\n  { value: 'runs', label: 'Runs & reports', icon: FileText },\n  { value: 'patient', label: 'Patient overview', icon: Activity },\n  { value: 'graph', label: 'Knowledge graph', icon: Network },\n]\n\nexport const NAV_GROUPS: { label: string; items: NavItem[] }[] = [\n  {\n    label: 'Patient data',\n    items: [\n      { value: 'genetics', label: 'Genetics', icon: Dna },\n      { value: 'medications', label: 'Medications', icon: Pill },\n      { value: 'visits', label: 'Clinic visits', icon: CalendarDays },\n      { value: 'diary', label: 'Symptom diary', icon: NotebookPen },\n    ],\n  },\n  {\n    label: 'Delivery & access',\n    items: [\n      { value: 'fus', label: 'Focused ultrasound', icon: Waves },\n      { value: 'trials', label: 'Clinical trials', icon: FlaskConical },\n      { value: 'care-team', label: 'Care team', icon: Users },\n    ],\n  },\n]\n\nexport const NAV_SECONDARY: NavItem[] = [\n  { value: 'sources', label: 'Data sources', icon: Database },\n  { value: 'privacy', label: 'Data & privacy', icon: Shield },\n  { value: 'settings', label: 'Settings', icon: Settings },\n]\n\nexport const ALL_NAV: NavItem[] = [...NAV_MAIN, ...NAV_GROUPS.flatMap((g) => g.items), ...NAV_SECONDARY]\n\nexport type Profile = { name: string; email: string; avatar?: string }\n\nconst initials = (name: string) =>\n  name.trim().split(/\\s+/).map((p) => p[0]).slice(0, 2).join('').toUpperCase() || '?'\n\nfunction NavList({ items, active, select }: { items: NavItem[]; active: string; select: (v: string) => void }) {\n  return (\n    <SidebarMenu>\n      {items.map((item) => (\n        <SidebarMenuItem key={item.value}>\n          <SidebarMenuButton tooltip={item.label} isActive={active === item.value} onClick={() => select(item.value)}>\n            <item.icon />\n            <span>{item.label}</span>\n          </SidebarMenuButton>\n        </SidebarMenuItem>\n      ))}\n    </SidebarMenu>\n  )\n}\n\nexport function AppSidebar({\n  active,\n  onSelect,\n  profile,\n  onSignOut,\n}: {\n  active: string\n  onSelect: (view: string) => void\n  profile: Profile\n  onSignOut?: () => void\n}) {\n  const { isMobile, setOpenMobile } = useSidebar()\n  const select = (value: string) => {\n    onSelect(value)\n    if (isMobile) setOpenMobile(false)\n  }\n\n  return (\n    <Sidebar variant=\"inset\" collapsible=\"offcanvas\">\n      <SidebarHeader className=\"pt-4\">\n        <SidebarMenu>\n          <SidebarMenuItem>\n            <SidebarMenuButton className=\"h-auto !p-2 !pt-3 hover:bg-transparent active:bg-transparent\" onClick={() => select('discovery')}>\n              <span className=\"font-brand text-3xl leading-none\">addo labs</span>\n            </SidebarMenuButton>\n          </SidebarMenuItem>\n        </SidebarMenu>\n      </SidebarHeader>\n\n      <SidebarContent>\n        <SidebarGroup>\n          <SidebarGroupContent className=\"flex flex-col gap-2\">\n            <SidebarMenu>\n              <SidebarMenuItem>\n                <SidebarMenuButton\n                  tooltip=\"New discovery run\"\n                  onClick={() => select('new-run')}\n                  className=\"min-w-8 bg-primary/80 text-primary-foreground duration-200 ease-linear hover:bg-primary hover:text-primary-foreground active:bg-primary active:text-primary-foreground\"\n                >\n                  <CirclePlus />\n                  <span>New discovery run</span>\n                </SidebarMenuButton>\n              </SidebarMenuItem>\n            </SidebarMenu>\n            <NavList items={NAV_MAIN} active={active} select={select} />\n          </SidebarGroupContent>\n        </SidebarGroup>\n\n        {NAV_GROUPS.map((group) => (\n          <SidebarGroup key={group.label} className=\"group-data-[collapsible=icon]:hidden\">\n            <SidebarGroupLabel>{group.label}</SidebarGroupLabel>\n            <NavList items={group.items} active={active} select={select} />\n          </SidebarGroup>\n        ))}\n\n        <SidebarGroup className=\"mt-auto\">\n          <SidebarGroupContent>\n            <NavList items={NAV_SECONDARY} active={active} select={select} />\n          </SidebarGroupContent>\n        </SidebarGroup>\n      </SidebarContent>\n\n      <SidebarFooter>\n        <SidebarMenu>\n          <SidebarMenuItem>\n            <DropdownMenu>\n              <DropdownMenuTrigger asChild>\n                <SidebarMenuButton size=\"lg\" className=\"data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground\">\n                  <Avatar className=\"size-8 rounded-lg grayscale\">\n                    {profile.avatar ? <AvatarImage src={profile.avatar} alt=\"\" referrerPolicy=\"no-referrer\" /> : null}\n                    <AvatarFallback className=\"rounded-lg\">{initials(profile.name)}</AvatarFallback>\n                  </Avatar>\n                  <span className=\"grid flex-1 text-left text-sm leading-tight\">\n                    <span className=\"truncate font-medium\">{profile.name}</span>\n                    <span className=\"truncate text-xs text-muted-foreground\">{profile.email}</span>\n                  </span>\n                  <MoreVertical className=\"ml-auto size-4\" />\n                </SidebarMenuButton>\n              </DropdownMenuTrigger>\n              <DropdownMenuContent\n                className=\"w-(--radix-dropdown-menu-trigger-width) min-w-56 rounded-lg\"\n                side={isMobile ? 'bottom' : 'right'}\n                align=\"end\"\n                sideOffset={4}\n              >\n                <DropdownMenuLabel className=\"p-0 font-normal\">\n                  <div className=\"flex items-center gap-2 px-1 py-1.5 text-left text-sm\">\n                    <Avatar className=\"size-8 rounded-lg\">\n                      {profile.avatar ? <AvatarImage src={profile.avatar} alt=\"\" referrerPolicy=\"no-referrer\" /> : null}\n                      <AvatarFallback className=\"rounded-lg\">{initials(profile.name)}</AvatarFallback>\n                    </Avatar>\n                    <div className=\"grid flex-1 text-left text-sm leading-tight\">\n                      <span className=\"truncate font-medium\">{profile.name}</span>\n                      <span className=\"truncate text-xs text-muted-foreground\">{profile.email}</span>\n                    </div>\n                  </div>\n                </DropdownMenuLabel>\n                <DropdownMenuSeparator />\n                <DropdownMenuGroup>\n                  <DropdownMenuItem onSelect={() => select('settings')}>\n                    <UserCircle /> Account\n                  </DropdownMenuItem>\n                  <DropdownMenuItem onSelect={() => select('settings')}>\n                    <AlarmClock /> Notifications\n                  </DropdownMenuItem>\n                  <DropdownMenuItem onSelect={() => select('privacy')}>\n                    <BookOpen /> Data & privacy\n                  </DropdownMenuItem>\n                </DropdownMenuGroup>\n                <DropdownMenuSeparator />\n                <DropdownMenuItem disabled={!onSignOut} onSelect={() => onSignOut?.()}>\n                  <LogOut /> Log out\n                </DropdownMenuItem>\n              </DropdownMenuContent>\n            </DropdownMenu>\n          </SidebarMenuItem>\n        </SidebarMenu>\n      </SidebarFooter>\n    </Sidebar>\n  )\n}\n","userModified":false},"sourceToolAssistantUUID":"c52a5e7f-4ed4-4281-ab9b-983d6b70d5c4","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"28437234-f1be-440d-9452-c51de1bd38ab","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\jerem\\BioHacks-2026\\frontend","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","version":"2.1.319","gitBranch":"frontend/diagnosis"}
