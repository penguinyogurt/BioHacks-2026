 onDone: () => void) {\n  const events = script(patient, caseInput)\"\"\")\nopen(p,'w',encoding='utf8').write(s)\nEOF\necho ok","description":"Feed case PDF into scripted analysis stage"},"caller":{"type":"direct"}}]}}
