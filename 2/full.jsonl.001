{"type":"api-request-blob","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","hash":"75ab2c3502637d3385affa859774023a15afb077f6cc0412ac406bc6194f9a90","message":{"role":"assistant","content":[{"type":"text","text":"Rewriting the neuron viewer: upright, spinning about its long vertical axis, drag limited to that spin, no tilt, and a fade-in on load."},{"type":"tool_use","id":"toolu_01UPmwV38cYsy2acA6F8B2Ai","name":"Write","input":{"file_path":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\neuron-viewer.tsx","content":"import { Suspense, useEffect, useMemo, useState } from 'react'\nimport { Canvas, useFrame, useLoader, useThree } from '@react-three/fiber'\nimport * as THREE from 'three'\nimport { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js'\nimport { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js'\n\n/**\n * The neuron, standing upright and spinning about its long axis.\n * Model: \"Neuron Cell Low-poly Simple\" by vitalik.kucha, CC BY 4.0\n * (public/models/neuron.LICENSE.txt).\n */\n\nconst MODEL_URL = '/models/neuron.glb'\nconst MODEL_SIZE = 13 // long axis, world units\nconst COLOR = '#2f5f6b' // teal ink\nconst OPACITY = 0.55\nconst AUTO_ROTATE_SPEED = 2.2\n\nfunction Neuron({ onLoaded }: { onLoaded: () => void }) {\n  const gltf = useLoader(GLTFLoader, MODEL_URL)\n\n  const { model, center, scale } = useMemo(() => {\n    const model = gltf.scene.clone(true)\n    model.updateMatrixWorld(true)\n    const box = new THREE.Box3().setFromObject(model)\n    const size = box.getSize(new THREE.Vector3())\n    return { model, center: box.getCenter(new THREE.Vector3()), scale: MODEL_SIZE / (Math.max(size.x, size.y, size.z) || 1) }\n  }, [gltf])\n\n  useEffect(() => {\n    model.traverse((node) => {\n      const mesh = node as THREE.Mesh\n      if (!mesh.isMesh) return\n      mesh.frustumCulled = false\n      for (const m of Array.isArray(mesh.material) ? mesh.material : [mesh.material]) {\n        if ('color' in m && m.color instanceof THREE.Color) m.color.set(COLOR)\n        m.transparent = true\n        m.opacity = OPACITY\n        m.depthWrite = false\n      }\n    })\n    onLoaded()\n  }, [model, onLoaded])\n\n  // The model's long axis is x; turn it 90° so it stands vertically (dendrites up, axon down).\n  return (\n    <group scale={scale} rotation={[0, 0, Math.PI / 2]}>\n      <group position={[-center.x, -center.y, -center.z]}>\n        <primitive object={model} />\n      </group>\n    </group>\n  )\n}\n\n/** Spin about the vertical axis only: auto-rotate, and drag left/right to turn it. */\nfunction Controls({ autoRotate }: { autoRotate: boolean }) {\n  const { camera, gl } = useThree()\n  const controls = useMemo(() => new OrbitControls(camera, gl.domElement), [camera, gl])\n  useEffect(() => {\n    controls.autoRotate = autoRotate\n    controls.autoRotateSpeed = AUTO_ROTATE_SPEED\n    controls.enableZoom = false\n    controls.enablePan = false\n    controls.enableDamping = true\n    controls.minPolarAngle = Math.PI / 2\n    controls.maxPolarAngle = Math.PI / 2\n    return () => controls.dispose()\n  }, [controls, autoRotate])\n  useFrame(() => controls.update())\n  return null\n}\n\nexport default function NeuronViewer({ reducedMotion = false, className = '' }: { reducedMotion?: boolean; className?: string }) {\n  const [loaded, setLoaded] = useState(false)\n  const onLoaded = useMemo(() => () => setLoaded(true), [])\n  return (\n    <div\n      className={`transition-opacity duration-700 ease-out motion-reduce:transition-none ${loaded ? 'opacity-100' : 'opacity-0'} ${className}`}\n      style={{ cursor: 'grab' }}\n    >\n      <Canvas camera={{ position: [0, 0, 12], fov: 65 }} dpr={[1, 2]} gl={{ alpha: true, antialias: true }}>\n        <ambientLight intensity={2} />\n        <directionalLight position={[8, 8, 6]} intensity={3} />\n        <directionalLight position={[-8, 6, 4]} intensity={2} />\n        <directionalLight position={[0, -10, 2]} intensity={1.5} />\n        <pointLight position={[0, 0, 8]} intensity={2} />\n        <Controls autoRotate={!reducedMotion} />\n        <Suspense fallback={null}>\n          <Neuron onLoaded={onLoaded} />\n        </Suspense>\n      </Canvas>\n    </div>\n  )\n}\n"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01VAvuSuHAcDeavpMCLxDkNP","name":"Write","input":{"file_path":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\pages\\Landing.tsx","content":"import { useState } from 'react'\nimport { Navigate } from 'react-router-dom'\nimport Dither from '@/components/react-bits/Dither'\nimport NeuronViewer from '@/components/neuron-viewer'\nimport { AFTER_SIGN_IN, useAuth } from '@/lib/auth'\nimport { DITHER_INK, DITHER_PAPER } from '@/lib/theme'\n\nconst reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches\n\nfunction GoogleIcon() {\n  return (\n    <svg className=\"size-4 shrink-0\" viewBox=\"0 0 24 24\" aria-hidden>\n      <path fill=\"#4285F4\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" />\n      <path fill=\"#34A853\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" />\n      <path fill=\"#FBBC05\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\" />\n      <path fill=\"#EA4335\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\" />\n    </svg>\n  )\n}\n\nexport default function Landing() {\n  const { user, configured, signInWithGoogle } = useAuth()\n  const [busy, setBusy] = useState(false)\n  const [error, setError] = useState('')\n\n  if (user) return <Navigate to={AFTER_SIGN_IN} replace />\n\n  async function onSignIn() {\n    setBusy(true)\n    setError('')\n    const failed = await signInWithGoogle()\n    if (failed) {\n      setError(failed)\n      setBusy(false)\n    }\n  }\n\n  return (\n    <div className=\"relative h-dvh w-screen overflow-hidden bg-background text-foreground\">\n      <div className=\"absolute inset-0 z-0\">\n        <Dither\n          waveSpeed={0.02}\n          waveFrequency={3}\n          waveAmplitude={0.3}\n          backgroundColor={DITHER_PAPER}\n          waveColor={DITHER_INK}\n          colorNum={4}\n          pixelSize={2}\n          disableAnimation={reducedMotion}\n          enableMouseInteraction\n          mouseRadius={1.2}\n        />\n      </div>\n\n      {/* The neuron stands in the right half and spins about its own long axis. */}\n      <NeuronViewer reducedMotion={reducedMotion} className=\"absolute inset-y-0 right-0 z-0 w-full md:w-[62%]\" />\n\n      <main className=\"pointer-events-none absolute bottom-0 left-0 z-10 flex flex-col items-start pb-12 pl-10 md:pb-16 md:pl-16 lg:pb-20 lg:pl-20\">\n        <h1 className=\"font-brand text-6xl leading-none tracking-tight md:text-7xl lg:text-8xl\">motus</h1>\n        <p className=\"font-serif-display mt-1 text-2xl leading-tight text-foreground/75 italic md:text-3xl lg:text-[2.1rem]\">\n          early ALS detection, from how you move\n        </p>\n        <button\n          type=\"button\"\n          onClick={onSignIn}\n          disabled={!configured || busy}\n          aria-busy={busy}\n          className=\"pointer-events-auto mt-6 flex cursor-pointer items-center gap-2.5 rounded-full bg-foreground py-2.5 pr-5 pl-2.5 text-sm text-background shadow-[0_6px_20px_-8px_rgb(19_41_61/0.6)] transition-[transform,background-color] duration-200 ease-out hover:bg-foreground/90 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-60\"\n        >\n          <span className=\"grid size-7 place-items-center rounded-full bg-background\">\n            <GoogleIcon />\n          </span>\n          {busy ? 'Connecting…' : 'Sign in with Google'}\n        </button>\n        {error ? <p className=\"mt-3 text-xs text-foreground/70\" role=\"alert\">{error}</p> : null}\n        {!configured ? <p className=\"mt-3 text-xs text-foreground/60\">Add Supabase keys to .env to enable sign-in.</p> : null}\n      </main>\n\n      {/* CC BY 4.0 attribution for the neuron model (public/models/neuron.LICENSE.txt). */}\n      <p className=\"absolute right-5 bottom-4 z-10 text-[11px] text-foreground/45 [&_a]:underline [&_a]:decoration-foreground/25 [&_a]:underline-offset-2 [&_a:hover]:text-foreground/80\">\n        <a href=\"https://sketchfab.com/3d-models/neuron-cell-low-poly-simple-3a09438daf364c3bbd3cce76f1c7afaa\" target=\"_blank\" rel=\"noreferrer\">Neuron Cell Low-poly Simple</a>\n        {' by '}\n        <a href=\"https://sketchfab.com/vitalik.kucha\" target=\"_blank\" rel=\"noreferrer\">vitalik.kucha</a>\n        {' · '}\n        <a href=\"http://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noreferrer\">CC BY 4.0</a>\n      </p>\n    </div>\n  )\n}\n"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01JVBmTnJfgdxQNvJxG4ydtB","name":"Write","input":{"file_path":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\lib\\theme.ts","content":"/** Motus palette for the WebGL backgrounds (RGB 0–1). Matches --background / --foreground in index.css. */\nexport const DITHER_PAPER: [number, number, number] = [0.965, 0.953, 0.929] // #f6f3ed\nexport const DITHER_INK: [number, number, number] = [0.075, 0.161, 0.239] // #13293d\n"},"caller":{"type":"direct"}}]}}
