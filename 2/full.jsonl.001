_call', 'ncbi.gene_lookup', '{\\n  \"genes\": [\"SOD1\", \"C9orf72\", \"FUS\", \"TARDBP\"],\\n  \"organism\": \"Homo sapiens\"\\n}', 1100)\r","   step('analysis', 'tool_result', 'NCBI Gene — result', 'Retrieved gene records and ALS-associated variant summaries for 4 genes.', 1100)\r"]},{"oldStart":381,"oldLines":8,"newStart":393,"newLines":8,"lines":[" }\r"," \r"," /** Replays the scripted run. Returns `{ cancel, skip }`; `skip` flushes everything immediately. */\r","-export function runDemoPipeline(patient: Patient, emit: (e: PipelineEvent) => void, onDone: () => void) {\r","-  const events = script(patient)\r","+export function runDemoPipeline(patient: Patient, caseInput: CaseInput, emit: (e: PipelineEvent) => void, onDone: () => void) {\r","+  const events = script(patient, caseInput)\r","   let i = 0\r","   let timer: ReturnType<typeof setTimeout> | undefined\r","   const start = performance.now()"]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\lib\\pipeline.ts"]}},"serverClassifierContext":{"request":"fadc2d03-2166-41b3-b3db-2bf6ba89b07a","context":{"git_state":{"cwd":"/c/Users/jerem/BioHacks-2026/frontend","root":"/c/Users/jerem/BioHacks-2026","branch":"frontend/diagnosis","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"penguinyogurt/BioHacks-2026","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"penguinyogurt/BioHacks-2026","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"penguinyogurt/BioHacks-2026","visibility":"public"}]}},"live_cwd":"/c/Users/jerem/BioHacks-2026/frontend","platform":"windows"}},"sandboxed":false,"sourceToolAssistantUUID":"71e24f58-ebff-4947-a3f3-63f00efe2858","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"284372