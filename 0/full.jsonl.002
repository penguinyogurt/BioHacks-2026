sName=\"mt-1 text-xs text-muted-foreground\">{PATIENT.medication} · {PATIENT.genetics}</p>","       </div>","-      </div>"," ","-      <div className=\"grid grid-cols-12 gap-3\" aria-live=\"polite\">","+      <div className=\"grid grid-cols-12 gap-3\">","         <Metric","-          label=\"Motor function index\"","-          value={fmt(latest.mfi, 1)}","-          detail={`${signed(data.mfiChange)} this period · baseline 100`}","-          values={period.map((s) => s.mfi)}","-        />","-        <Metric","-          label=\"Estimated ALSFRS-R\"","-          value={fmt(latest.alsfrs, 1)}","+          label=\"ALSFRS-R\"","+          value={String(latest.score)}","           unit=\"/ 48\"","-          detail={`Last clinic score ${CLINIC_VISITS[CLINIC_VISITS.length - 1].score}`}","-          values={period.map((s) => s.alsfrs)}","+          detail={`${ALSFRS_SLOPE} pts/mo since onset`}","+          values={ALSFRS.map((p) => p.score)}","         />","         <Metric","-          label=\"Progression rate\"","-          value={signed(data.alsfrsSlope, 2)}","-          unit=\"pts / mo\"","-          detail=\"ΔALSFRS-R, last 60 days\"","-          values={period.map((s) => s.alsfrs)}","+          label=\"Vital capacity (sitting)\"","+          value={`${fvcNow.sitting}%`}","+          unit=\"predicted\"","+          detail={`${fvcNow.supine}% lying flat · ref > 80%`}","+          values={FVC.map((p) => p.sitting)}","         />","         <Metric","-          label=\"Adherence\"","-          value={`${Math.round(data.adherence * 100)}%`}","-          detail={`${period.length} of ${range} days`}","-          values={period.map((_, i) => i)}","+          label=\"Weight\"","+          value={String(weightNow.kg)}","+          unit=\"kg\"","+          detail={`${(weightNow.kg - WEIGHT[0].kg).toFixed(1)} kg since ${WEIGHT[0].label}`}","+          values={WEIGHT.map((p) => p.kg)}","         />","+        <Metric label=\"Neurofilament light\" value=\"88\" unit=\"pg/mL\" detai