-foreground\">typical {h.typical} {h.unit}</span></div>","+                  {([['R', h.right, 'bg-flag'], ['L', h.left, 'bg-chart-3']] as const).map(([side, v, tone]) => (","+                    <div key={side} className=\"grid grid-cols-[1rem_1fr_3.25rem] items-center gap-2\">","+                      <span className=\"text-xs text-muted-foreground\">{side}</span>","+                      <Meter value={pct(v)} max={100} tone={tone} />","+                      <span className=\"text-right text-xs\">{v} {h.unit}</span>","+                    </div>","+                  ))}","                 </div>","               )","             })}","-            <div className=\"mt-1 border-t pt-4\">","-              <p className=\"mb-2 text-xs text-muted-foreground\">Most-changed features</p>","-              {mostChanged.map((f, i) => (","-                <div key={f.key} className=\"flex items-center justify-between gap-2 py-1.5\">","-                  <span>","-                    <small className=\"mr-2.5 text-[0.625rem] text-muted-foreground\">{String(i + 1).padStart(2, '0')}</small>","-                    {f.label}","-                  </span>","-                  <span className={f.worse ? 'text-flag' : 'text-muted-foreground'}>{signed(f.change * 100, 0)}%</span>","-                </div>","-              ))}","-            </div>","           </CardContent>","-          <CardFooter className=\"border-t text-[0.6875rem] text-muted-foreground\">","-            7-session mean · watch ≤ −1σ · flag ≤ −2σ","-          </CardFooter>","+          <CardFooter className=\"border-t text-[0.6875rem] text-muted-foreground\">Bars show share of typical; right hand most affected, left starting.</CardFooter>","         </Card>"," ","-        <Card className=\"col-span-12 [--card-spacing:--spacing(5)] xl:col-span-8\">","+        <Card className=\"col-span-12 [--card-spacing:--spacing(5)] md:col-span-6 xl:col-span-4\">","           <CardHeader>","-            <CardTitle className=\"text-lg font-normal\">Change from baseline by domain</CardTitle>","-            <CardAction className=\"text-[0.625rem] text-muted-foreground\">z-score, 7-session mean</CardAction>","+            <CardTitle className=\"text-lg font-normal\">Weight</CardTitle>","+            <CardAction className=\"text-[0.625rem] text-muted-foreground\">kg</CardAction>","           </CardHeader>","           <CardContent>","-            <ChartContainer config={domainConfig} className=\"aspect-auto h-72 w-full\">","-              <LineChart data={trends} margin={{ left: 0, right: 8, top: 4, bottom: 0 }}>","+            <ChartContainer config={weightConfig} className=\"aspect-auto h-48 w-full\">","+              <LineChart data={WEIGHT} margin={{ left: 0, right: 12, top: 8, bottom: 0 }}>","                 <CartesianGrid vertical={false} strokeDasharray=\"3 6\" />","-                <XAxis dataKey=\"t\" type=\"number\" scale=\"time\" domain={['dataMin', 'dataMax']} tickFormatter={fmtDate} tickLine={false} axisLine={false} minTickGap={40} />","-                <YAxis domain={[-6, 2]} ticks={[-6, -4, -2, 0, 2]} tickLine={false} axisLine={false} width={28} />","-                <ReferenceLine y={-1} stroke=\"var(--status-watch)\" strokeDasharray=\"4 4\" strokeOpacity={0.6} />","-                <ReferenceLine y={-2} stroke=\"var(--status-flag)\" strokeDasharray=\"4 4\" strokeOpacity={0.6} />","-                <ChartTooltip content={<ChartTooltipContent labelFormatter={tooltipDate} />} />","-                {(['speech', 'typing', 'handwriting'] as const).map((k) => (","-                  <Line key={k} dataKey={k} stroke={`var(--color-${k})`} strokeWidth={2} dot={false} isAnimationActive={false} />","-                ))}","+                <XAxis dataKey=\"m\" type=\"number\" domain={[0, 27]} ticks={WEIGHT.map((w) => w.m)} tickFormatter={(m) => WEIGHT.find((w) => w.m === m)?.label ?? ''} tickLine={false} axisLine={false} />","+                <YAxis domain={[74, 88]} ticks={[76, 80, 84, 88]} tickLine={false} axisLine={false} width={28} />","+                <ChartTooltip content={<ChartTooltipContent labelFormatter={(_l, p) => p?.[0]?.payload?.label ?? ''} />} />","+                <Line dataKey=\"kg\" stroke=\"var(--color-kg)\" strokeWidth={2} dot={{ r: 3.5, fill: 'var(--color-kg)' }} isAnimationActive={false} />","               </LineChart>","             </ChartContainer>","           </CardContent>","-          <CardFooter className=\"flex-wrap gap-4 border-t text-[0.6875rem] text-muted-foreground\">","-            {modalities.map((m) => (","-              <span key={m.key} className=\"inline-flex items-center gap-1.5\">","-                <i className=\"size-1.5 rounded-full\" style={{ background: domainConfig[m.key].color }} /> {domainConfig[m.key].label}","-              </span>","-            ))}","-            <span className=\"ml-auto\">Dashed: watch −1σ / flag −2σ</span>","-          </CardFooter>","+          <CardFooter className=\"border-t text-[0.6875rem] text-muted-foreground\">Only measured points; meals now take 35–40 minutes.</CardFooter>","         </Card>"," ","         <Card className=\"col-span-12 [--card-spacing:--spacing(5)] md:col-span-6 xl:col-span-4\">","           <CardHeader>","-            <CardTitle className=\"text-lg font-normal\">Alerts</CardTitle>","-            <CardAction><Bell className=\"size-4 text-muted-foreground\" aria-hidden /></CardAction>","+            <CardTitle className=\"text-lg font-normal\">Flags from the file</CardTitle>","           </CardHeader>","-          <CardContent className=\"flex flex-1 flex-col gap-3\">","-            {alerts.length ? alerts.map((a) => (","-              <div key={a.title} className=\"flex flex-col gap-1 border-b pb-3 last:border-0 last:pb-0\">","+          <CardContent className=\"flex flex-col gap-3\">","+            {FLAGS.map((f) => (","+              <div key={f.title} className=\"flex flex-col gap-1 border-b pb-3 last:border-0 last:pb-0\">","                 <div className=\"flex items-start justify-between gap-2\">","-                  <span>{a.title}</span>","-                  <StatusBadge status={a.status} />","+                  <span>{f.title}</span>","+                  <Badge variant=\"outline\" className={cn('font-normal', LEVEL_CLASS[f.level])}>{LEVEL_LABEL[f.level]}</Badge>","                 </div>","-                <span className=\"text-xs text-muted-foreground\">{a.detail}</span>","+                <span className=\"text-xs text-muted-foreground\">{f.detail}</span>","               </div>","-            )) : <p className=\"text-muted-foreground\">No sustained changes from baseline.</p>}","+            ))}","           </CardContent>","-          <CardFooter className=\"flex-wrap gap-3 border-t\">","-            <span className=\"inline-flex items-center gap-1.5 text-[0.6875rem] text-muted-foreground\">","-              <CalendarClock className=\"size-3.5\" aria-hidden /> Next clinic visit {fmtDate(NEXT_VISIT)}","-            </span>","-            <Button size=\"sm\" variant=\"outline\" className=\"ml-auto\">","-              <Share2 aria-hidden /> Share with neurologist","-            </Button>","-          </CardFooter>","         </Card>"," ","-        {modalities.map((m) => {","-          const Icon = ICONS[m.key]","-          return (","-            <Card key={m.key} className=\"col-span-12 [--card-spacing:--spacing(5)] md:col-span-6 xl:col-span-4\">","-              <CardHeader>","-                <CardTitle className=\"inline-flex items-center gap-2 text-lg font-normal\">","-                  <Icon className=\"size-4 text-muted-foreground\" aria-hidden /> {m.label}","-                </CardTitle>","-                <CardAction><StatusBadge status={m.status} /></CardAction>","-              </CardHeader>","-              <CardContent>","-                <Spark values={period.map((s) => s.z[m.key])} className=\"mb-4 h-10 w-full\" />","-                <Table>","-                  <TableHeader>","-                    <TableRow>","-                      <TableHead className=\"h-8 px-0 text-[0.6875rem] font-normal text-muted-foreground\">Feature</TableHead>","-                      <TableHead className=\"h-8 text-right text-[0.6875rem] font-normal text-muted-foreground\">Baseline</TableHead>","-                      <TableHead className=\"h-8 text-right text-[0.6875rem] font-normal text-muted-foreground\">Now</TableHead>","-                      <TableHead className=\"h-8 px-0 text-right text-[0.6875rem] font-normal text-muted-foreground\">Δ</TableHead>","-                    </TableRow>","-                  </TableHeader>","-                  <TableBody>","-                    {m.features.map((f) => (","-                      <TableRow key={f.key}>","-                        <TableCell className=\"px-0 py-2 whitespace-normal\">","-                          {f.label}","-                          {f.unit ? <span className=\"ml-1 text-[0.6875rem] text-muted-foreground\">{f.unit}</span> : null}","-                        </TableCell>","-                        <TableCell className=\"py-2 text-right text-muted-foreground\">{fmt(f.baseline, f.decimals)}</TableCell>","-                        <TableCell className=\"py-2 text-right\">{fmt(f.current, f.decimals)}</TableCell>","-                        <TableCell className={cn('px-0 py-2 text-right', f.worse && Math.abs(f.change) >= 0.05 ? 'text-flag' : 'text-muted-foreground')}>","-                          {signed(f.change * 100, 0)}%","-                        </TableCell>","-                      </TableRow>","-                    ))}","-                  </TableBody>","-                </Table>","-              </CardContent>","-            </Card>","-          )","-        })}","+        <Card className=\"col-span-12 [--card-spacing:--spacing(5)] md:col-span-6 xl:col-span-4\">","+          <CardHeader>","+            <CardTitle className=\"text-lg font-normal\">Strength (MRC grade)</CardTitle>","+            <CardAction className=\"text-[0.625rem] text-muted-foreground\">out of 5</CardAction>","+          </CardHeader>","+          <CardContent>","+            <Table>","+              <TableBody>","+                {STRENGTH.map((s) => (","+                  <TableRow key={s.muscle}>","+                    <TableCell className=\"px-0 py-2 whitespace-normal\">{s.muscle}</TableCell>","+                    <TableCell className=\"py-2 text-right whitespace-normal\">","+                      {s.grades.map((g, i) => (","+                        <span key={g.label} title={g.label}>","+                          {i ? <span className=\"mx-1 text-muted-foreground\">→</span> : null}","+                          <span className={g.g <= 3 ? 'text-flag' : ''}>{g.g}</span>","+                        </span>","+                      ))}","+                    </TableCell>","+                    <TableCell className=\"px-0 py-2 text-right text-[0.6875rem] whitespace-normal text-muted-foreground\">{s.grades.map((g) => g.label).join(' → ')}</TableCell>","+                  </TableRow>","+                ))}","+              </TableBody>","+            </Table>","+          </CardContent>","+        </Card>","+","+        <Card className=\"col-span-12 [--card-spacing:--spacing(5)]\">","+          <CardHeader>","+            <CardTitle className=\"text-lg font-normal\">From first symptom to diagnosis</CardTitle>","+            <CardAction className=\"text-[0.625rem] text-muted-foreground\">25 months · four clinicians · one operation that didn’t help</CardAction>","+          </CardHeader>","+          <CardContent>","+            <ol className=\"grid grid-cols-2 gap-4 sm:grid-cols-4 xl:grid-cols-8\">","+              {TIMELINE.map((t, i) => (","+                <li key={t.label} className=\"flex flex-col gap-1 border-t-2 pt-2\" style={{ borderColor: i === 6 ? 'var(--status-flag)' : 'var(--border)' }}>","+                  <span className=\"text-xs text-muted-foreground\">{t.label} · m{t.m}</span>","+                  <span className=\"text-[0.8125rem] leading-snug\">{t.event}</span>","+                </li>","+              ))}","+            </ol>","+          </CardContent>","+        </Card>","       </div>"," ","       <Collapsible className=\"mt-4 text-xs text-muted-foreground\">","         <CollapsibleTrigger className=\"group inline-flex items-center gap-2 py-2\">","-          Session data <span className=\"opacity-70\">{period.length} rows</span>","+          Tests and reference ranges <span className=\"opacity-70\">{TESTS.length} results</span>","           <ChevronDown className=\"size-3.5 transition-transform group-data-[state=open]:rotate-180\" aria-hidden />","         </CollapsibleTrigger>","         <CollapsibleContent>"]},{"oldStart":371,"oldLines":23,"newStart":330,"newLines":18,"lines":["             <Table>","               <TableHeader>","                 <TableRow>","-                  {['Date', 'Speaking rate', 'DDK', 'Typing', 'Inter-key', 'Stroke vel.', 'Jerk', 'Index', 'Est. ALSFRS-R'].map((h) => (","-                    <TableHead key={h} className=\"text-right font-normal text-muted-foreground first:text-left\">{h}</TableHead>","+                  {['Test', 'Result', 'Reference', 'Source'].map((h) => (","+                    <TableHead key={h} className=\"font-normal text-muted-foreground\">{h}</TableHead>","                   ))}","                 </TableRow>","               </TableHeader>","               <TableBody>","-                {[...period].reverse().map((s) => (","-                  <TableRow key={s.t}>","-                    <TableCell>{fmtDate(s.t)}</TableCell>","-                    <TableCell className=\"text-right\">{fmt(s.values.rate, 2)}</TableCell>","-                    <TableCell className=\"text-right\">{fmt(s.values.ddk, 1)}</TableCell>","-                    <TableCell className=\"text-right\">{fmt(s.values.wpm, 0)}</TableCell>","-                    <TableCell className=\"text-right\">{fmt(s.values.flight, 0)} ms</TableCell>","-                    <TableCell className=\"text-right\">{fmt(s.values.velocity, 2)}</TableCell>","-                    <TableCell className=\"text-right\">{fmt(s.values.jerk, 2)}</TableCell>","-                    <TableCell className=\"text-right\">{fmt(s.mfi, 1)}</TableCell>","-                    <TableCell className=\"text-right\">{fmt(s.alsfrs, 1)}</TableCell>","+                {TESTS.map((t) => (","+                  <TableRow key={t.test}>","+                    <TableCell>{t.test}</TableCell>","+                    <TableCell className={t.abnormal ? 'text-flag' : ''}>{t.value}</TableCell>","+                    <TableCell className=\"text-muted-foreground\">{t.reference}</TableCell>","+                    <TableCell className=\"text-muted-foreground\">{t.source}</TableCell>","                   </TableRow>","                 ))}","               </TableBody>"]}],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"2da4680d-59ce-4f5b-91fe-47c2fc0b6432","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"28437234-f1be-440d-9452-c51de1bd38ab","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\jerem\\BioHacks-2026\\frontend","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","version":"2.1.319","gitBranch":"frontend/diagnosis"}
