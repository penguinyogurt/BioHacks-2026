ents/overview-dashboard.tsx(103,13): error TS7006: Parameter 'm' implicitly has an 'any' type.\r\nsrc/components/overview-dashboard.tsx(157,31): error TS7006: Parameter 's' implicitly has an 'any' type.\r\nsrc/components/overview-dashboard.tsx(164,31): error TS7006: Parameter 's' implicitly has an 'any' type.\r\nsrc/components/overview-dashboard.tsx(171,31): error TS7006: Parameter 's' implicitly has an 'any' type.\r\nsrc/components/overview-dashboard.tsx(177,31): error TS7006: Parameter '_' implicitly has an 'any' type.\r\nsrc/components/overview-dashboard.tsx(177,34): error TS7006: Parameter 'i' implicitly has an 'any' type.\r\nsrc/components/overview-dashboard.tsx(218,30): error TS7006: Parameter 'm' implicitly has an 'any' type.\r\nsrc/components/overview-dashboard.tsx(249,33): error TS7006: Parameter 'f' implicitly has an 'any' type.\r\nsrc/components/overview-dashboard.tsx(249,36): error TS7006: Parameter 'i' implicitly has an 'any' type.\r\nsrc/components/overview-dashboard.tsx(286,30): error TS7006: Parameter 'm' implicitly has an 'any' type.\r\nsrc/components/overview-dashboard.tsx(288,75): error TS7053: Element implicitly has an 'any' type because expression of type 'any' can't be used to index type '{ speech: { label: string; color: string; }; typing: { label: string; color: string; }; handwriting: { label: string; color: string; }; }'.\r\nsrc/components/overview-dashboard.tsx(288,108): error TS7053: Element implicitly has an 'any' type because expression of type 'any' can't be used to index type '{ speech: { label: string; color: string; }; typing: { label: string; color: string; }; handwriting: { label: string; color: string; }; }'.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\lib\\sample-data.ts","hunks":[{"oldStart":1,"oldLines":190,"newStart":0,"newLines":0,"lines":["-/**","- * SAMPLE DATA — deterministic, synthetic. Replace with Supabase queries once","- * capture is wired up. The dashboard shows a \"Sample data\" badge while this","- * module is the source.","- *","- * Shape of the story: 180 days of at-home sessions. Speech (bulbar) features","- * start drifting first, then typing, then handwriting — a bulbar-onset pattern.","- */","-","-export const IS_SAMPLE = true","-","-export type Modality = 'speech' | 'typing' | 'handwriting'","-","-export const MODALITIES: { key: Modality; label: string; domain: string }[] = [","-  { key: 'speech', label: 'Speech', domain: 'Bulbar' },","-  { key: 'typing', label: 'Typing', domain: 'Fine motor' },","-  { key: 'handwriting', label: 'Handwriting', domain: 'Fine motor' },","-]","-","-type FeatureDef = {","-  key: string","-  modality: Modality","-  label: string","-  unit: string","-  decimals: number","-  /** true when a larger value means better function */","-  higherIsBetter: boolean","-  start: number","-  end: number","-  sd: number","-  onset: number","-}","-","-export const FEATURES: FeatureDef[] = [","-  { key: 'rate', modality: 'speech', label: 'Speaking rate', unit: 'syll/s', decimals: 2, higherIsBetter: true, start: 4.6, end: 3.95, sd: 0.14, onset: 45 },","-  { key: 'ddk', modality: 'speech', label: 'DDK rate (pa-ta-ka)', unit: 'Hz', decimals: 1, higherIsBetter: true, start: 6.3, end: 5.45, sd: 0.18, onset: 50 },","-  { key: 'pause', modality: 'speech', label: 'Pause ratio', unit: '%', decimals: 0, higherIsBetter: false, start: 17, end: 24, sd: 1.4, onset: 55 },","-  { key: 'mpt', modality: 'speech', label: 'Max phonation time', unit: 's', decimals: 1, higherIsBetter: true, start: 17.2, end: 14.1, sd: 0.8, onset: 60 },","-  { key: 'hnr', modality: 'speech', label: 'Harmonics-to-noise', unit: 'dB', decimals: 1, higherIsBetter: true, start: 20.4, end: 18.6, sd: 0.6, onset: 70 },","-  { key: 'wpm', modality: 'typing', label: 'Typing speed', unit: 'wpm', decimals: 0, higherIsBetter: true, start: 52, end: 49.8, sd: 2.2, onset: 80 },","-  { key: 'flight', modality: 'typing', label: 'Inter-key interval', unit: 'ms', decimals: 0, higherIsBetter: false, start: 182, end: 193, sd: 7, onset: 80 },","-  { key: 'dwell', modality: 'typing', label: 'Key hold time', unit: 'ms', decimals: 0, higherIsBetter: false, start: 96, end: 99, sd: 4, onset: 100 },","-  { key: 'backspace', modality: 'typing', label: 'Correction rate', unit: '%', decimals: 1, higherIsBetter: false, start: 4.2, end: 4.75, sd: 0.45, onset: 90 },","-  { key: 'velocity', modality: 'handwriting', label: 'Stroke velocity', unit: 'cm/s', decimals: 2, higherIsBetter: true, start: 4.9, end: 4.84, sd: 0.15, onset: 120 },","-  { key: 'jerk', modality: 'handwriting', label: 'Normalised jerk', unit: '', decimals: 2, higherIsBetter: false, start: 1.0, end: 1.02, sd: 0.04, onset: 120 },","-  { key: 'pressure', modality: 'handwriting', label: 'Pressure variability', unit: 'CV', decimals: 3, higherIsBetter: false, start: 0.12, end: 0.123, sd: 0.008, onset: 130 },","-  { key: 'spiral', modality: 'handwriting', label: 'Spiral deviation', unit: 'mm', decimals: 2, higherIsBetter: false, start: 1.9, end: 1.96, sd: 0.12, onset: 130 },","-]","-","-const DAYS = 180","-const BASELINE_DAYS = 28","-const TODAY = Date.UTC(2026, 10, 7)","-const DAY_MS = 86_400_000","-","-/** Clinician-rated ALSFRS-R at clinic visits (0–48). */","-export const CLINIC_VISITS = [","-  { day: 8, score: 46 },","-  { day: 94, score: 45 },","-  { day: 168, score: 44 },","-]","-export const NEXT_VISIT = Date.UTC(2026, 11, 3)","-","-function mulberry32(seed: number) {","-  let a = seed >>> 0","-  return () => {","-    a = (a + 0x6d2b79f5) | 0","-    let t = Math.imul(a ^ (a >>> 15), 1 | a)","-    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t","-    return ((t ^ (t >>> 14)) >>> 0) / 4294967296","-  }","-}","-","-export type Session = {","-  t: number","-  day: number","-  values: Record<string, number>","-  /** 7-session rolling z vs baseline per modality; negative = worse than baseline */","-  z: Record<Modality, number>","-  /** Composite motor-function index, personal baseline = 100 */","-  mfi: number","-  /** Model-estimated ALSFRS-R */","-  alsfrs: number","-}","-","-function build(): Session[] {","-  const r = mulberry32(2026)","-  const gauss = () => Math.sqrt(-2 * Math.log(r() || 1e-9)) * Math.cos(2 * Math.PI * r())","-  const raw: { t: number; day: number; values: Record<string, number> }[] = []","-  for (let day = 0; day < DAYS; day++) {","-    if (r() > 0.86 && day < DAYS - 1) continue // missed days; always have today","-    const values: Record<string, number> = {}","-    for (const f of FEATURES) {","-      const p = Math.min(1, Math.max(0, (day - f.onset) / (DAYS - f.onset))) ** 1.3","-      values[f.key] = f.start + (f.end - f.start) * p + gauss() * f.sd","-    }","-    raw.push({ t: TODAY - (DAYS - 1 - day) * DAY_MS, day, values })","-  }","-","-  const base = raw.filter((s) => s.day < BASELINE_DAYS)","-  const stats = Object.fromEntries(","-    FEATURES.map((f) => {","-      const xs = base.map((s) => s.values[f.key])","-      const mean = xs.reduce((a, b) => a + b, 0) / xs.length","-      const sd = Math.sqrt(xs.reduce((a, b) => a + (b - mean) ** 2, 0) / (xs.length - 1))","-      return [f.key, { mean, sd }]","-    }),","-  )","-","-  const featureZ = (v: number, f: FeatureDef) => ((v - stats[f.key].mean) / stats[f.key].sd) * (f.higherIsBetter ? 1 : -1)","-","-  return raw.map((s, i) => {","-    const window = raw.slice(Math.max(0, i - 6), i + 1)","-    const z = {} as Record<Modality, number>","-    for (const m of MODALITIES) {","-      const fs = FEATURES.filter((f) => f.modality === m.key)","-      const per = fs.map((f) => window.reduce((a, w) => a + featureZ(w.values[f.key], f), 0) / window.length)","-      z[m.key] = per.reduce((a, b) => a + b, 0) / per.length","-    }","-    const avg = (z.speech + z.typing + z.handwriting) / 3","-    return { ...s, z, mfi: 100 + 3 * avg, alsfrs: Math.min(48, 46 + 0.55 * avg) }","-  })","-}","-","-export const SESSIONS = build()","-","-export const BASELINE = Object.fromEntries(","-  FEATURES.map((f) => {","-    const xs = SESSIONS.filter((s) => s.day < BASELINE_DAYS).map((s) => s.values[f.key])","-    return [f.key, xs.reduce((a, b) => a + b, 0) / xs.length]","-  }),","-) as Record<string, number>","-","-export type Status = 'flag' | 'watch' | 'stable'","-export const statusOf = (z: number): Status => (z <= -2 ? 'flag' : z <= -1 ? 'watch' : 'stable')","-export const STATUS_LABEL: Record<Status, string> = { flag: 'Flagged', watch: 'Watch', stable: 'Stable' }","-","-function slopePerMonth(points: { t: number; y: number }[]) {","-  const n = points.length","-  if (n < 2) return 0","-  const mx = points.reduce((a, p) => a + p.t, 0) / n","-  const my = points.reduce((a, p) => a + p.y, 0) / n","-  const num = points.reduce((a, p) => a + (p.t - mx) * (p.y - my), 0)","-  const den = points.reduce((a, p) => a + (p.t - mx) ** 2, 0)","-  return (num / den) * DAY_MS * 30.44","-}","-","-export function summarize(rangeDays: number) {","-  const period = SESSIONS.filter((s) => s.day >= DAYS - rangeDays)","-  const latest = SESSIONS[SESSIONS.length - 1]","-  const first = period[0]","-  const recent = SESSIONS.slice(-7)","-","-  const alsfrsSlope = slopePerMonth(SESSIONS.filter((s) => s.day >= DAYS - 60).map((s) => ({ t: s.t, y: s.alsfrs })))","-  const forecast = Array.from({ length: 7 }, (_, m) => {","-    const t = latest.t + m * 30.44 * DAY_MS","-    const y = latest.alsfrs + alsfrsSlope * m","-    const spread = m === 0 ? 0 : 0.6 + 0.35 * m","-    return { t, forecast: y, band: [y - spread, y + spread] as [number, number] }","-  })","-","-  const modalities = MODALITIES.map((m) => {","-    const z = latest.z[m.key]","-    const daysBelow = (() => {","-      let n = 0","-      for (let i = SESSIONS.length - 1; i >= 0 && SESSIONS[i].z[m.key] <= -1; i--) n++","-      return n","-    })()","-    const features = FEATURES.filter((f) => f.modality === m.key).map((f) => {","-      const current = recent.reduce((a, s) => a + s.values[f.key], 0) / recent.length","-      const change = (current - BASELINE[f.key]) / BASELINE[f.key]","-      const worse = f.higherIsBetter ? change < 0 : change > 0","-      return { ...f, baseline: BASELINE[f.key], current, change, worse }","-    })","-    return { ...m, z, status: statusOf(z), daysBelow, features }","-  })","-","-  return {","-    period,","-    first,","-    latest,","-    adherence: period.length / rangeDays,","-    mfiChange: latest.mfi - first.mfi,","-    alsfrsSlope,","-    forecast,","-    modalities,","-  }","-}","-","-export const fmtDate = (t: number) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }).format(t)","-export const DAY = DAY_MS"]}],"deleted":true}],"moreFiles":0,"changedFiles":["C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\lib\\sample-data.ts"]}},"serverClassifierContext":{"request":"6a5fa150-fc0c-479b-86f6-b8a7b095c331","context":{"git_state":{"cwd":"/c/Users/jerem/BioHacks-2026/frontend","root":"/c/Users/jerem/BioHacks-2026","branch":"frontend/diagnosis","default_branch":null,"status":{"clean":false,"counts":{"staged":1,"modified":11,"untracked":null,"untracked_normal":4},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"penguinyogurt/BioHacks-2026","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"penguinyogurt/BioHacks-2026","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"penguinyogurt/BioHacks-2026","visibility":"public"}]}},"live_cwd":"/c/Users/jerem/BioHacks-2026/frontend","platform":"windows"}},"sandboxed":false,"sourceToolAssistantUUID":"3b5fad05-f435-4ff7-b9b8-1443a4113c91","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"28437234-f1be-440d-9452-c51de1bd38ab","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\jerem\\BioHacks-2026\\frontend","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","version":"2.1.319","gitBranch":"frontend/diagnosis"}
{"type":"api-request-blob","sessionId":"28437234-f1be-440d-9452-c51de1bd38ab","hash":"859200112b63fef733d68e45767f522089574b5c21ec266503a3bf0777e8b165","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"Now the dashboard itself, rebuilt on Alex's record:"},{"type":"tool_use","id":"toolu_01DvLx6aPTfqaUxWusrcRhiH","name":"Write","input":{"file_path":"C:\\Users\\jerem\\BioHacks-2026\\frontend\\src\\components\\overview-dashboard.tsx","content":"import { Bar, BarChart, CartesianGrid, ComposedChart, Line, LineChart, ReferenceLine, XAxis, YAxis } from 'recharts'\nimport { ChevronDown } from 'lucide-react'\nimport { Badge } from '@/components/ui/badge'\nimport { Card, CardAction, CardContent, CardFooter, CardHeader, CardTitle } from '@/components/ui/card'\nimport { ChartContainer, ChartTooltip, ChartTooltipContent, type ChartConfig } from '@/components/ui/chart'\nimport { Collapsible, CollapsibleContent, CollapsibleTrigger } from '@/components/ui/collapsible'\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table'\nimport { cn } from '@/lib/utils'\nimport {\n  ALSFRS, ALSFRS_DOMAINS, ALSFRS_SLOPE, FLAGS, FVC, HAND, PATIENT, SPEECH, STRENGTH, TESTS, TIMELINE, WEIGHT, type Level,\n} from '@/lib/alex-case'\n\n/**\n * Patient monitoring for Alex Chen, from the BioHacks 2026 case file.\n * Every number on this page is stated in the file (see lib/alex-case.ts).\n */\n\nconst LEVEL_CLASS: Record<Level, string> = {\n  flag: 'border-flag/40 bg-flag/10 text-flag',\n  watch: 'border-watch/40 bg-watch/10 text-watch',\n}\nconst LEVEL_LABEL: Record<Level, string> = { flag: 'Flag', watch: 'Watch' }\n\nconst month = (m: number) => `Month ${m}`\n\n/** Hairline sparkline, no axes. */\nfunction Spark({ values, className }: { values: number[]; className?: string }) {\n  const min = Math.min(...values)\n  const max = Math.max(...values)\n  const pts = values.map((v, i) => `${(i / Math.max(1, values.length - 1)) * 120},${28 - ((v - min) / (max - min || 1)) * 24}`).join(' ')\n  return (\n    <svg viewBox=\"0 0 120 30\" preserveAspectRatio=\"none\" className={cn('h-7 w-[35%] shrink-0 text-chart-3', className)} aria-hidden>\n      <polyline points={pts} fill=\"none\" stroke=\"currentColor\" strokeWidth={1.75} vectorEffect=\"non-scaling-stroke\" strokeLinejoin=\"round\" strokeLinecap=\"round\" />\n    </svg>\n  )\n}\n\nfunction Metric({ label, value, unit, detail, values }: { label: string; value: string; unit?: string; detail: string; values?: number[] }) {\n  return (\n    <Card className=\"col-span-12 gap-3 [--card-spacing:--spacing(5)] sm:col-span-6 xl:col-span-3\">\n      <CardContent className=\"flex flex-col gap-3\">\n        <h3 className=\"text-[0.9375rem] font-normal text-muted-foreground\">{label}</h3>\n        <p className=\"font-heading text-[clamp(1.875rem,2.6vw,2.6rem)] leading-tight font-normal tracking-tight tabular-nums\">\n          {value}\n          {unit ? <span className=\"ml-1.5 text-sm text-muted-foreground\">{unit}</span> : null}\n        </p>\n        <div className=\"flex items-end justify-between gap-2\">\n          <span className=\"text-xs text-muted-foreground\">{detail}</span>\n          {values ? <Spark values={values} /> : null}\n        </div>\n      </CardContent>\n    </Card>\n  )\n}\n\n/** A horizontal meter with an optional reference tick. */\nfunction Meter({ value, max, tick, tone = 'bg-chart-3' }: { value: number; max: number; tick?: number; tone?: string }) {\n  return (\n    <div className=\"relative h-1.5 rounded-full bg-muted\">\n      <span className={cn('absolute inset-y-0 left-0 rounded-full', tone)} style={{ width: `${Math.min(100, (value / max) * 100)}%` }} />\n      {tick !== undefined ? <span className=\"absolute -inset-y-1 w-px bg-foreground/50\" style={{ left: `${(tick / max) * 100}%` }} /> : null}\n    </div>\n  )\n}\n\nconst trajectoryConfig = {\n  score: { label: 'ALSFRS-R', color: 'var(--chart-3)' },\n  projection: { label: 'Linear at −0.6/mo', color: 'var(--chart-3)' },\n} satisfies ChartConfig\nconst fvcConfig = {\n  sitting: { label: 'Sitting', color: 'var(--chart-3)' },\n  supine: { label: 'Lying flat', color: 'var(--chart-1)' },\n} satisfies ChartConfig\nconst weightConfig = { kg: { label: 'Weight (kg)', color: 'var(--chart-4)' } } satisfies ChartConfig\n\nexport default function OverviewDashboard(_: { title?: string }) {\n  const latest = ALSFRS[ALSFRS.length - 1]\n  const horizon = 12 // months of linear extrapolation shown\n  const trajectory: { m: number; score?: number; projection?: number }[] = [\n    ...ALSFRS.map((p) => ({ m: p.m, score: p.score })),\n    { m: latest.m, projection: latest.score },\n    { m: latest.m + horizon, projection: latest.score + ALSFRS_SLOPE * horizon },\n  ]\n  const fvcNow = FVC[FVC.length - 1]\n  const weightNow = WEIGHT[WEIGHT.length - 1]\n  const rateDrop = Math.round((1 - SPEECH.rate.pm / SPEECH.rate.am) * 100)\n\n  return (\n    <div className=\"mx-auto max-w-[1440px] text-sm tabular-nums\">\n      <div className=\"mb-3 rounded-xl bg-card px-5 pt-5 pb-4 ring-1 ring-border backdrop-blur-md\">\n        <p className=\"eyebrow\">Patient / Motor-function monitoring</p>\n        <h2 className=\"font-brand mt-3 text-[clamp(2.5rem,4vw,3.75rem)] leading-none\">{PATIENT.name}</h2>\n        <p className=\"mt-3 text-muted-foreground\">\n          {PATIENT.age} · {PATIENT.summary} · {PATIENT.monthsFromOnset} months from first symptom · diagnosed {PATIENT.diagnosed}\n        </p>\n        <p className=\"mt-1 text-xs text-muted-foreground\">{PATIENT.medication} · {PATIENT.genetics}</p>\n      </div>\n\n      <div className=\"grid grid-cols-12 gap-3\">\n        <Metric\n          label=\"ALSFRS-R\"\n          value={String(latest.score)}\n          unit=\"/ 48\"\n          detail={`${ALSFRS_SLOPE} pts/mo since onset`}\n          values={ALSFRS.map((p) => p.score)}\n        />\n        <Metric\n          label=\"Vital capacity (sitting)\"\n          value={`${fvcNow.sitting}%`}\n          unit=\"predicted\"\n          detail={`${fvcNow.supine}% lying flat · ref > 80%`}\n          values={FVC.map((p) => p.sitting)}\n        />\n        <Metric\n          label=\"Weight\"\n          value={String(weightNow.kg)}\n          unit=\"kg\"\n          detail={`${(weightNow.kg - WEIGHT[0].kg).toFixed(1)} kg since ${WEIGHT[0].label}`}\n          values={WEIGHT.map((p) => p.kg)}\n        />\n        <Metric label=\"Neurofilament light\" value=\"88\" unit=\"pg/mL\" detail=\"Reference below 15 at age 47\" />\n\n        <Card className=\"col-span-12 [--card-spacing:--spacing(5)] xl:col-span-8\">\n          <CardHeader>\n            <CardTitle className=\"text-lg font-normal\">ALSFRS-R since first symptom</CardTitle>\n            <CardAction className=\"text-[0.625rem] text-muted-foreground\">months from June 2024</CardAction>\n          </CardHeader>\n          <CardContent>\n            <ChartContainer config={trajectoryConfig} className=\"aspect-auto h-[17.5rem] w-full\">\n              <ComposedChart data={trajectory} margin={{ left: 0, right: 12, top: 18, bottom: 0 }}>\n                <CartesianGrid vertical={false} strokeDasharray=\"3 6\" />\n                <XAxis dataKey=\"m\" type=\"number\" domain={[0, latest.m + horizon]} ticks={[0, 6, 12, 18, 24, 30, 36]} tickFormatter={(m) => `${m}`} tickLine={false} axisLine={false} />\n                <YAxis domain={[20, 48]} ticks={[24, 32, 40, 48]} tickLine={false} axisLine={false} width={28} />\n                <ChartTooltip content={<ChartTooltipContent labelFormatter={(_, p) => month(p?.[0]?.payload?.m ?? 0)} />} />\n                <ReferenceLine x={7} stroke=\"var(--muted-foreground)\" strokeDasharray=\"2 4\" label={{ value: 'Carpal tunnel release', position: 'insideTopLeft', fontSize: 10, fill: 'var(--muted-foreground)' }} />\n                <ReferenceLine x={25} stroke=\"var(--status-flag)\" strokeDasharray=\"2 4\" label={{ value: 'Diagnosis', position: 'insideTopRight', fontSize: 10, fill: 'var(--status-flag)' }} />\n                <Line dataKey=\"score\" stroke=\"var(--color-score)\" strokeWidth={2} dot={{ r: 3.5, fill: 'var(--color-score)' }} connectNulls isAnimationActive={false} />\n                <Line dataKey=\"projection\" stroke=\"var(--color-projection)\" strokeWidth={2} strokeDasharray=\"5 5\" dot={false} connectNulls isAnimationActive={false} />\n              </ComposedChart>\n            </ChartContainer>\n          </CardContent>\n          <CardFooter className=\"flex-wrap gap-4 border-t text-[0.6875rem] text-muted-foreground\">\n            <span className=\"inline-flex items-center gap-1.5\"><i className=\"size-1.5 rounded-full bg-chart-3\" /> Clinic ALSFRS-R</span>\n            <span>Dashed: straight-line extrapolation at the clinic’s −0.6/month, not a forecast</span>\n          </CardFooter>\n        </Card>\n\n        <Card className=\"col-span-12 [--card-spacing:--spacing(5)] md:col-span-6 xl:col-span-4\">\n          <CardHeader>\n            <CardTitle className=\"text-lg font-normal\">ALSFRS-R by domain</CardTitle>\n            <CardAction className=\"text-[0.625rem] text-muted-foreground\">Sep 2026 · each of 12</CardAction>\n          </CardHeader>\n          <CardContent className=\"flex flex-col gap-4\">\n            {ALSFRS_DOMAINS.map((d) => (\n              <div key={d.domain} className=\"flex flex-col gap-1.5\">\n                <div className=\"flex justify-between\"><span>{d.domain}</span><span>{d.score} / 12</span></div>\n                <Meter value={d.score} max={12} tone={d.score <= 7 ? 'bg-flag' : 'bg-chart-3'} />\n              </div>\n            ))}\n          </CardContent>\n          <CardFooter className=\"border-t text-[0.6875rem] text-muted-foreground\">Fine and gross motor are most affected; breathing best preserved.</CardFooter>\n        </Card>\n\n        <Card className=\"col-span-12 [--card-spacing:--spacing(5)] md:col-span-6 xl:col-span-4\">\n          <CardHeader>\n            <CardTitle className=\"text-lg font-normal\">Strong in the morning</CardTitle>\n            <CardAction className=\"text-[0.625rem] text-muted-foreground\">same passage, 9 am vs 4 pm</CardAction>\n          </CardHeader>\n          <CardContent className=\"flex flex-col gap-5\">\n            {([\n              ['Speaking rate', SPEECH.rate.am, SPEECH.rate.pm, 200, SPEECH.rate.typical[0], 'words/min'],\n              ['Intelligibility', SPEECH.intelligibility.am, SPEECH.intelligibility.pm, 100, SPEECH.intelligibility.typical, '%'],\n            ] as const).map(([label, am, pm, max, ref, unit]) => (\n              <div key={label} className=\"flex flex-col gap-2\">\n                <p className=\"text-muted-foreground\">{label} <span className=\"text-xs\">({unit})</span></p>\n                {([['9 am', am, 'bg-chart-3'], ['4 pm', pm, 'bg-watch']] as const).map(([t, v, tone]) => (\n                  <div key={t} className=\"grid grid-cols-[2.5rem_1fr_2.5rem] items-center gap-2\">\n                    <span className=\"text-xs text-muted-foreground\">{t}</span>\n                    <Meter value={v} max={max} tick={ref} tone={tone} />\n                    <span className=\"text-right\">{v}</span>\n                  </div>\n                ))}\n              </div>\n            ))}\n          </CardContent>\n          <CardFooter className=\"border-t text-[0.6875rem] text-muted-foreground\">\n            {rateDrop}% slower by 4 pm · tick marks the low end of typical\n          </CardFooter>\n        </Card>\n\n        <Card className=\"col-span-12 [--card-spacing:--spacing(5)] md:col-span-6 xl:col-span-4\">\n          <CardHeader>\n            <CardTitle className=\"text-lg font-normal\">Breathing</CardTitle>\n            <CardAction className=\"text-[0.625rem] text-muted-foreground\">FVC, % predicted</CardAction>\n          </CardHeader>\n          <CardContent>\n            <ChartContainer config={fvcConfig} className=\"aspect-auto h-48 w-full\">\n              <BarChart data={FVC} margin={{ left: 0, right: 8, top: 8, bottom: 0 }}>\n                <CartesianGrid vertical={false} strokeDasharray=\"3 6\" />\n                <XAxis dataKey=\"label\" tickLine={false} axisLine={false} />\n                <YAxis domain={[40, 100]} ticks={[40, 60, 80, 100]} tickLine={false} axisLine={false} width={28} />\n                <ChartTooltip content={<ChartTooltipContent />} />\n                <ReferenceLine y={80} stroke=\"var(--status-flag)\" strokeDasharray=\"4 4\" strokeOpacity={0.7} />\n                <Bar dataKey=\"sitting\" fill=\"var(--color-sitting)\" radius={[3, 3, 0, 0]} isAnimationActive={false} />\n                <Bar dataKey=\"supine\" fill=\"var(--color-supine)\" radius={[3, 3, 0, 0]} isAnimationActive={false} />\n              </BarChart>\n            </ChartContainer>\n          </CardContent>\n          <CardFooter className=\"flex-wrap gap-3 border-t text-[0.6875rem] text-muted-foreground\">\n            <span className=\"inline-flex items-center gap-1.5\"><i className=\"size-1.5 rounded-full bg-chart-3\" /> Sitting</span>\n            <span className=\"inline-flex items-center gap-1.5\"><i className=\"size-1.5 rounded-full bg-chart-1\" /> Lying flat</span>\n            <span className=\"ml-auto\">Dashed: 80% · SNIP 52 cm H₂O (ref &gt; 70)</span>\n          </CardFooter>\n        </Card>\n\n        <Card className=\"col-span-12 [--card-spacing:--spacing(5)] md:col-span-6 xl:col-span-4\">\n          <CardHeader>\n            <CardTitle className=\"text-lg font-normal\">Hand function</CardTitle>\n            <CardAction className=\"text-[0.625rem] text-muted-foreground\">right / left vs typical</CardAction>\n          </CardHeader>\n          <CardContent className=\"flex flex-col gap-4\">\n            {HAND.map((h) => {\n              // Express each side as a share of typical, so slower peg times read as shorter bars too.\n              const pct = (v: number) => (h.higherIsBetter ? v / h.typical : h.typical / v) * 100\n              return (\n                <div key={h.measure} className=\"flex flex-col gap-1.5\">\n                  <div className=\"flex justify-between\"><span>{h.measure}</span><span className=\"text-xs text-muted-foreground\">typical {h.typical} {h.unit}</span></div>\n                  {([['R', h.right, 'bg-flag'], ['L', h.left, 'bg-chart-3']] as const).map(([side, v, tone]) => (\n                    <div key={side} className=\"grid grid-cols-[1rem_1fr_3.25rem] items-center gap-2\">\n                      <span className=\"text-xs text-muted-foreground\">{side}</span>\n                      <Meter value={pct(v)} max={100} tone={tone} />\n                      <span className=\"text-right text-xs\">{v} {h.unit}</span>\n                    </div>\n                  ))}\n                </div>\n              )\n            })}\n          </CardContent>\n          <CardFooter className=\"border-t text-[0.6875rem] text-muted-foreground\">Bars show share of typical; right hand most affected, left starting.</CardFooter>\n        </Card>\n\n        <Card className=\"col-span-12 [--card-spacing:--spacing(5)] md:col-span-6 xl:col-span-4\">\n          <CardHeader>\n            <CardTitle className=\"text-lg font-normal\">Weight</CardTitle>\n            <CardAction className=\"text-[0.625rem] text-muted-foreground\">kg</CardAction>\n          </CardHeader>\n          <CardContent>\n            <ChartContainer config={weightConfig} className=\"aspect-auto h-48 w-full\">\n              <LineChart data={WEIGHT} margin={{ left: 0, right: 12, top: 8, bottom: 0 }}>\n                <CartesianGrid vertical={false} strokeDasharray=\"3 6\" />\n                <XAxis dataKey=\"m\" type=\"number\" domain={[0, 27]} ticks={WEIGHT.map((w) => w.m)} tickFormatter={(m) => WEIGHT.find((w) => w.m === m)?.label ?? ''} tickLine={false} axisLine={false} />\n                <YAxis domain={[74, 88]} ticks={[76, 80, 84, 88]} tickLine={false} axisLine={false} width={28} />\n                <ChartTooltip content={<ChartTooltipContent labelFormatter={(_, p) => p?.[0]?.payload?.label ?? ''} />} />\n                <Line dataKey=\"kg\" stroke=\"var(--color-kg)\" strokeWidth={2} dot={{ r: 3.5, fill: 'var(--color-kg)' }} isAnimationActive={false} />\n              </LineChart>\n            </ChartContainer>\n          </CardContent>\n          <CardFooter className=\"border-t text-[0.6875rem] text-muted-foreground\">Only measured points; meals now take 35–40 minutes.</CardFooter>\n        </Card>\n\n        <Card className=\"col-span-12 [--card-spacing:--spacing(5)] md:col-span-6 xl:col-span-4\">\n          <CardHeader>\n            <CardTitle className=\"text-lg font-normal\">Flags from the file</CardTitle>\n          </CardHeader>\n          <CardContent className=\"flex flex-col gap-3\">\n            {FLAGS.map((f) => (\n              <div key={f.title} className=\"flex flex-col gap-1 border-b pb-3 last:border-0 last:pb-0\">\n                <div className=\"flex items-start justify-between gap-2\">\n                  <span>{f.title}</span>\n                  <Badge variant=\"outline\" className={cn('font-normal', LEVEL_CLASS[f.level])}>{LEVEL_LABEL[f.level]}</Badge>\n                </div>\n                <span className=\"text-xs text-muted-foreground\">{f.detail}</span>\n              </div>\n            ))}\n          </CardContent>\n        </Card>\n\n        <Card className=\"col-span-12 [--card-spacing:--spacing(5)] md:col-span-6 xl:col-span-4\">\n          <CardHeader>\n            <CardTitle className=\"text-lg font-normal\">Strength (MRC grade)</CardTitle>\n            <CardAction className=\"text-[0.625rem] text-muted-foreground\">out of 5</CardAction>\n          </CardHeader>\n          <CardContent>\n            <Table>\n              <TableBody>\n                {STRENGTH.map((s) => (\n                  <TableRow key={s.muscle}>\n                    <TableCell className=\"px-0 py-2 whitespace-normal\">{s.muscle}</TableCell>\n                    <TableCell className=\"py-2 text-right whitespace-normal\">\n                      {s.grades.map((g, i) => (\n                        <span key={g.label} title={g.label}>\n                          {i ? <span className=\"mx-1 text-muted-foreground\">→</span> : null}\n                          <span className={g.g <= 3 ? 'text-flag' : ''}>{g.g}</span>\n                        </span>\n                      ))}\n                    </TableCell>\n                    <TableCell className=\"px-0 py-2 text-right text-[0.6875rem] text-muted-foreground\">{s.grades.map((g) => g.label).join(' → ')}</TableCell>\n                  </TableRow>\n                ))}\n              </TableBody>\n            </Table>\n          </CardContent>\n        </Card>\n\n        <Card className=\"col-span-12 [--card-spacing:--spacing(5)]\">\n          <CardHeader>\n            <CardTitle className=\"text-lg font-normal\">From first symptom to diagnosis</CardTitle>\n            <CardAction className=\"text-[0.625rem] text-muted-foreground\">25 months · four clinicians · one operation that didn’t help</CardAction>\n          </CardHeader>\n          <CardContent>\n            <ol className=\"relative grid grid-cols-2 gap-4 sm:grid-cols-4 xl:grid-cols-8\">\n              {TIMELINE.map((t, i) => (\n                <li key={t.label} className=\"flex flex-col gap-1 border-t-2 pt-2\" style={{ borderColor: i === 6 ? 'var(--status-flag)' : 'var(--border)' }}>\n                  <span className=\"text-xs text-muted-foreground\">{t.label} · m{t.m}</span>\n                  <span className=\"text-[0.8125rem] leading-snug\">{t.event}</span>\n                </li>\n              ))}\n            </ol>\n          </CardContent>\n        </Card>\n      </div>\n\n      <Collapsible className=\"mt-4 text-xs text-muted-foreground\">\n        <CollapsibleTrigger className=\"group inline-flex items-center gap-2 py-2\">\n          Tests and reference ranges <span className=\"opacity-70\">{TESTS.length} results</span>\n          <ChevronDown className=\"size-3.5 transition-transform group-data-[state=open]:rotate-180\" aria-hidden />\n        </CollapsibleTrigger>\n        <CollapsibleContent>\n          <Card className=\"mt-2 py-0\">\n            <Table>\n              <TableHeader>\n                <TableRow>\n                  {['Test', 'Result', 'Reference', 'Source'].map((h) => (\n                    <TableHead key={h} className=\"font-normal text-muted-foreground\">{h}</TableHead>\n                  ))}\n                </TableRow>\n              </TableHeader>\n              <TableBody>\n                {TESTS.map((t) => (\n                  <TableRow key={t.test}>\n                    <TableCell>{t.test}</TableCell>\n                    <TableCell className={t.abnormal ? 'text-flag' : ''}>{t.value}</TableCell>\n                    <TableCell className=\"text-muted-foreground\">{t.reference}</TableCell>\n                    <TableCell className=\"text-muted-foreground\">{t.source}</TableCell>\n                  </TableRow>\n                ))}\n              </TableBody>\n            </Table>\n          </Card>\n        </CollapsibleContent>\n      </Collapsible>\n    </div>\n  )\n}\n"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01QNqbmPJhC7we4CC42yfgFM","name":"Bash","input":{"command":"cd /c/Users/jerem/BioHacks-2026/frontend && git rm -q --cached src/lib/sample-data.ts 2>/dev/null; rm -f src/lib/sample-data.ts; grep -rn \"sample-data\" src; npx tsc -b 2>&1 | head -20","description":"Remove sample data module and typecheck","timeout":120000},"caller":{"type":"direct"}}]}}
