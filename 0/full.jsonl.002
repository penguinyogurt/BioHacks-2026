{"parentUuid":"820ed216-bee2-4787-a466-b67b82fd549e","isSidechain":false,"promptId":"c854dd98-f5e6-42de-938b-24c7a3a59776","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JdPjLxAvoYUENnoSW6h5DP","type":"tool_result","content":"106:        step=\"00 · Patient profile\"\n107:        title=\"Upload the patient profile.\"\n108:        description=\"Add the patient’s case file as a PDF. It’s read in your browser and parsed into the profile every agent works from.\"\n150:        step=\"01 · Patient analysis\"\n151:        title=\"Understand the case.\"\n152:        description=\"The analysis agent reads the case file, checks genetics against NCBI and ClinVar, and writes the patient summary every other agent works from.\"\n171:            <Trace stage=\"analysis\" title=\"Analysis agent\" />\n195:        step=\"02 · Profile agents\"\n196:        title=\"Five takes on the ideal drug.\"\n197:        description=\"Five agents run in parallel. Each frames a different therapeutic hypothesis for this patient and writes the profile of the drug that would test it.\"\n211:                <Trace stage=\"profiles\" lane={p.lane} title=\"Trace\" maxH=\"max-h-48\" />\n244:        step=\"03 · DRKG embedding\"\n245:        title=\"From profile to real compounds.\"\n246:        description=\"Each profile becomes a vector in the DRKG knowledge-graph embedding space; the nearest drug entities by cosine similarity become candidates.\"\n285:            <Trace stage=\"embedding\" title=\"Embedding job\" maxH=\"max-h-56\" />\n332:        step=\"04 · Research report\"\n333:        title=\"The case for each candidate.\"\n334:        description=\"A research agent with open search checks evidence, interactions with current medication, cost, availability in Canada and patient burden, then writes a cited report for this patient.\"\n341:            <Trace stage=\"research\" title=\"Research agent\" maxH=\"max-h-[34rem]\" />\n21:  { value: 'case', label: 'Patient case', n: '0