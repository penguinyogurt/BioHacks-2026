# Python pipeline (repo root: bbb/, src/, server/). Both are optional and have
# defaults. Nothing loads a .env automatically: export them in your shell.
# frontend/ and agent/ have their own .env.example.

# How many random seeds bbb/train.py averages over. Lower it for a fast smoke
# run. Default: 5.
BBB_SEEDS=

# Which pipeline JSON server/main.py serves. Default: data/pipeline.json.
PIPELINE_PATH=
