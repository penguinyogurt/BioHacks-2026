# ─── Secrets ──────────────────────────────────────────────────────────────
# frontend/ reads Supabase keys from .env. Never commit one; .env.example is
# the committed template.
.env
.env.*
!.env.example
*.local

# ─── Dependencies and build output ────────────────────────────────────────
node_modules/
dist/
.vite/
*.tsbuildinfo

# ─── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ─── Big source data — download it, don't commit it ───────────────────────
data/raw/
*.tsv
*.tsv.gz
*.sql
*.dump
*.pkl
*.npy
# data/pipeline.json is committed on purpose: it is the contract plus a
# hand-written sample, and the frontend renders it with no Python at all.
!data/pipeline.json

# ─── Per-person AI config ─────────────────────────────────────────────────
# Each harness writes its own machine-local hooks and state. None of it is
# shared, and committing it starts merge fights nobody wants mid-hackathon.
# Anything personal you want to keep goes in .workspace/ — see its README.
.agents/
.codex/
.cursor/
.entire/
.claude/settings.json
.claude/settings.local.json

# Your own scratch space: notes, personal CLAUDE.md, scratch scripts, dumps.
# Tracked exception: the README that explains what belongs here.
# (.workspace/* not .workspace/ — git won't descend into an excluded
# directory, so the negation below would never be reached.)
.workspace/*
!.workspace/README.md

# ─── OS noise ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
