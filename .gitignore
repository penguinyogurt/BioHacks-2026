# Mirror the skills CLI writes for other agent harnesses; .claude/skills is the source of truth
.agents/

node_modules/
dist/
.vite/
*.local
.DS_Store
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Big source data — download it, don't commit it
data/raw/
*.tsv
*.tsv.gz
*.sql
*.dump

# Large derived artifacts. Small cached crosswalks, metrics, and the joblib are committed on purpose.
artifacts/*.npy
artifacts/*.pkl
artifacts/*.tar.gz

# Keep the contract and generated outputs small and committed:
# data/pipeline.json is committed on purpose.
!data/pipeline.json
